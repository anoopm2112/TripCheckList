0939\u0948\u0902 \u0914\u0930 \u0938\u093e\u0925 \u0939\u0940 \u0939\u093e\u0925\u0940 \u0930\u093e\u0907\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",note_ML:"\u0d06\u0d28\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d36\u0d3f\u0d15\u0d4d\u0d37\u0d23\u0d35\u0d41\u0d02 \u0d2e\u0d3e\u0d28\u0d38\u0d3f\u0d15 \u0d2a\u0d4d\u0d30\u0d2c\u0d28\u0d4d\u0d27\u0d35\u0d41\u0d02 \u0d15\u0d41\u0d31\u0d35\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f\u0d38\u0d4d\u0d25\u0d32\u0d02 \u0d12\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d15\u0d4b\u0d28\u0d4d\u0d28\u0d3f \u0d06\u0d28 \u0d2a\u0d4d\u0d30\u0d36\u0d3f\u0d15\u0d4d\u0d37\u0d23 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02, \u0d05\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d06\u0d28\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d4a\u0d24\u0d41\u0d35\u0d3e\u0d2f \u0d2a\u0d4a\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d33\u0d47\u0d2f\u0d41\u0d02 \u0d2a\u0d20\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0baf\u0bbe\u0ba9\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0bbf\u0bb1\u0bcd\u0b9a\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95\u0bae\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b85\u0bb1\u0bbf\u0baf\u0bb2\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0ba3 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baf\u0bbe\u0ba9\u0bc8 \u0b93\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bc1\u0baa\u0bb5\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bb5\u0b9a\u0ba4\u0bbf \u0b87\u0ba4\u0bc1."},{location:{long:"77.238018",lat:"9.432833"},name:"Gavi",name_HI:"\u0917\u0935\u093f",name_ML:"\u0d17\u0d35\u0d3f",name_TA:"\u0b95\u0bb5\u0bbf",note:"A picturesque eco-tourism destination nestled amidst dense forests, known for its wildlife, trekking trails, and boating.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u0902\u0917\u094d\u0930\u093e\u092e\u0940 \u092a\u0930\u094d\u092f\u091f\u0928 \u0938\u094d\u0925\u0932 \u091c\u094b \u0918\u0928\u0947 \u091c\u0902\u0917\u0932\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0925\u093f\u0924 \u0939\u0948, \u091c\u093e\u0928\u0935\u0930\u094b\u0902, \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u092e\u093e\u0930\u094d\u0917\u094b\u0902 \u0914\u0930 \u092c\u094b\u091f\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d1f\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d28\u0d3f\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d18\u0d28\u0d1c\u0d28\u0d4d\u0d24\u0d41\u0d38\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d02 \u0d17\u0d35\u0d3f, \u0d05\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f\u0d15\u0d33\u0d41\u0d02 \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d19\u0d4d\u0d19\u0d4d \u0d1f\u0d4d\u0d30\u0d46\u0d2f\u0d3f\u0d32\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d02\u0d17\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0baa\u0bc1\u0b95\u0bb4\u0bbe\u0baf\u0bcd \u0bae\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b9a\u0bc1\u0bae\u0bc8 \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe\u0bb5\u0bbe\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bae\u0bb2\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe \u0b87\u0b9f\u0bae\u0bcd, \u0b85\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0ba9\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bbe\u0ba3\u0bbf\u0b95\u0bb3\u0bcd, \u0b9f\u0bbf\u0bb0\u0bc6\u0b95\u0bcd\u0b95\u0bbf\u0b99\u0bcd \u0baa\u0bbe\u0ba4\u0bc8\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc2\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bcd\u0bb1\u0bb5\u0bc8."},{location:{long:"76.704030",lat:"9.306122"},name:"Aranmula Parthasarathy Temple",name_HI:"\u0905\u0930\u0928\u094d\u092e\u0941\u0932\u093e \u092a\u093e\u0930\u094d\u0925\u0938\u093e\u0930\u0925\u0940 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d05\u0d30\u0d28\u0d4d\u0d2e\u0d41\u0d33 \u0d2a\u0d3e\u0d7c\u0d24\u0d4d\u0d24\u0d38\u0d3e\u0d30\u0d25\u0d3f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0bc1\u0bb3 \u0baa\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0b9a\u0bbe\u0bb0\u0ba4\u0bbf \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"A famous temple dedicated to Lord Krishna, known for its Aranmula Vallamkali (boat race) and traditional metal mirror making.",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0915\u0943\u0937\u094d\u0923 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u092e\u0902\u0926\u093f\u0930, \u091c\u094b \u0905\u0930\u0928\u094d\u092e\u0941\u0932\u093e \u0935\u0932\u094d\u0932\u0902\u0915\u093e\u0932\u0940 (\u0928\u094c\u0915\u093e \u0926\u094c\u0921\u093c) \u0914\u0930 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0927\u093e\u0924\u0941 \u0915\u093e\u0902\u091a \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d2d\u0d17\u0d35\u0d3e\u0d7b \u0d15\u0d43\u0d37\u0d4d\u0d23\u0d28\u0d46 \u0d06\u0d30\u0d3e\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d05\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d30\u0d28\u0d4d\u0d2e\u0d41\u0d33 \u0d35\u0d33\u0d4d\u0d33\u0d02\u0d15\u0d33\u0d3f (\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d31\u0d47\u0d38\u0d4d) \u0d2e\u0d31\u0d4d\u0d31\u0d41\u0d02 \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3f\u0d15 \u0d2e\u0d46\u0d1f\u0d4d\u0d1f\u0d32\u0d4d\u200d \u0d15\u0d23\u0d4d\u0d23\u0d3e\u0d2e\u0d3e\u0d24\u0d41\u0d15\u0d7e \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bb0\u0bc8\u0baa\u0bcd \u0baa\u0bb0\u0bae\u0bbe\u0ba4\u0bcd\u0bae\u0bbe \u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd, \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0bc1\u0bb3 \u0bb5\u0bb3\u0bcd\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd (\u0baa\u0b9f\u0b95\u0bc1 \u0baa\u0bcb\u0b9f\u0bcd\u0b9f\u0bbf) \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0b89\u0bb2\u0b95\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0ba3\u0bbe\u0bae\u0bc8\u0b95\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"76.703112",lat:"9.417507"},name:"Maramon Convention",name_HI:"\u092e\u0930\u093e\u092e\u094b\u0928 \u0938\u0902\u0927\u093f",name_ML:"\u0d2e\u0d3e\u0d30\u0d2e\u0d4b\u0d7a \u0d38\u0d28\u0d4d\u0d27\u0d3f",name_TA:"\u0bae\u0bbe\u0bb0\u0bae\u0bcb\u0ba9\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1",note:"The largest Christian convention in Asia, held annually near the Pampa River, attracting thousands of believers.",note_HI:"\u090f\u0936\u093f\u092f\u093e \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0908\u0938\u093e\u0908 \u0938\u092e\u094d\u092e\u0947\u0932\u0928, \u092a\u093e\u092e\u094d\u092a\u093e \u0928\u0926\u0940 \u0915\u0947 \u0915\u0930\u0940\u092c \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948, \u0939\u091c\u093e\u0930\u094b\u0902 \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0940\u092f\u094b\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d0f\u0d37\u0d4d\u0d2f\u0d2f\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16\u0d2e\u0d3e\u0d2f \u0d15\u0d4d\u0d30\u0d3f\u0d38\u0d4d\u0d24\u0d4d\u0d2f\u0d3e\u0d28\u0d3f \u0d38\u0d28\u0d4d\u0d28\u0d3f\u0d27\u0d3f, \u0d2a\u0d2e\u0d4d\u0d2a \u0d28\u0d26\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d15\u0d41\u0d24\u0d3f\u0d2f\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d4d \u0d35\u0d3e\u0d7c\u0d37\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d06\u0d2f\u0d4b\u0d1c\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d06\u0d23\u0d4d\u0d1f\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d4d\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d33\u0d47\u0d2f\u0d41\u0d02 \u0d06\u0d15\u0d30\u0d4d\u200d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b86\u0b9a\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0bae\u0bbf\u0b95\u0baa\u0bcd\u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0b95\u0bbf\u0bb1\u0bbf\u0bb8\u0bcd\u0ba4\u0bb5 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1, \u0baa\u0bae\u0bcd\u0baa\u0bbe \u0b86\u0bb1\u0bc1\u0baa\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0b86\u0baf\u0bcb\u0b9c\u0bbf\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1, \u0b86\u0baf\u0bbf\u0bb0\u0b95\u0bcd\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc8 \u0b86\u0b95\u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd."},{location:{long:"76.785305",lat:"9.275225"},name:"Pandalam Palace",name_HI:"\u092a\u093e\u0923\u094d\u0921\u093e\u0932\u092e \u092e\u0939\u0932",name_ML:"\u0d2a\u0d3e\u0d23\u0d4d\u0d1f\u0d32\u0d02 \u0d2a\u0d3e\u0d33\u0d3f\u0d15\u0d7e",name_TA:"\u0baa\u0bbe\u0ba3\u0bcd\u0b9f\u0bbe\u0bb2\u0bae\u0bcd \u0baa\u0bc7\u0bb2\u0bb8\u0bcd",note:"A historical palace associated with the royal family of Pandalam, revered as the birthplace of Lord Ayyappa.",note_HI:"\u092a\u093e\u0923\u094d\u0921\u093e\u0932\u092e \u0915\u0947 \u0930\u093e\u091c\u0935\u0902\u0936 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092e\u0939\u0932, \u091c\u094b \u092d\u0917\u0935\u093e\u0928 \u0905\u092f\u094d\u092f\u092a\u094d\u092a\u093e \u0915\u093e \u091c\u0928\u094d\u092e\u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0942\u091c\u094d\u092f \u0939\u0948\u0964",note_ML:"\u0d2a\u0d3e\u0d23\u0d4d\u0d1f\u0d32\u0d02 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27 \u0d2a\u0d3e\u0d33\u0d3f\u0d2f\u0d3e\u0d23\u0d4d, \u0d2d\u0d17\u0d35\u0d3e\u0d7b \u0d05\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d28\u0d4d\u0d31\u0d46 \u0d1c\u0d28\u0d4d\u0d2e\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d42\u0d1c\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0bbe\u0ba3\u0bcd\u0b9f\u0bbe\u0bb2\u0bae\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bb0\u0bbf\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bae\u0bb9\u0bb2\u0bcd, \u0b86\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0ba9\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 \u0b87\u0b9f\u0bc8\u0baf\u0bc7 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"77.211275",lat:"9.319342"},name:"Adavi Eco-Tourism",name_HI:"\u0906\u0926\u0935\u093f \u0907\u0915\u094b-\u092a\u0930\u094d\u092f\u091f\u0928",name_ML:"\u0d06\u0d1f\u0d35\u0d3f \u0d07\u0d15\u0d4d\u0d15\u0d4b-\u0d1f\u0d42\u0d31\u0d3f\u0d38\u0d02",name_TA:"\u0b85\u0b9f\u0bb5\u0bbf \u0bae\u0bb4\u0bc8-\u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0baf\u0ba3\u0bae\u0bcd",note:"An eco-tourism spot offering boat rides, nature walks, and treehouse accommodations amidst the enchanting Konni forest.",note_HI:"\u090f\u0915 \u0907\u0915\u094b-\u092a\u0930\u094d\u092f\u091f\u0928 \u0938\u094d\u0925\u093e\u0928 \u091c\u0939\u093e\u0902 \u0928\u094c\u0915\u093e \u0938\u0935\u093e\u0930\u0940, \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0938\u0948\u0930 \u0914\u0930 \u090f\u0902\u091f\u094d\u0930\u0947\u0902\u091a\u093f\u0902\u0917 \u0915\u094b\u0928\u094d\u0928\u0940 \u0935\u0928 \u092e\u0947\u0902 \u092a\u0947\u0921\u093c\u0939\u093e\u0909\u0938 \u0906\u0935\u093e\u0938 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d05\u0d1f\u0d35\u0d3f \u0d07\u0d15\u0d4d\u0d15\u0d4b-\u0d1f\u0d42\u0d31\u0d3f\u0d38\u0d02 \u0d12\u0d30\u0d41 \u0d2a\u0d30\u0d4d\u0d2f\u0d1f\u0d28 \u0d38\u0d4d\u0d25\u0d32\u0d2e\u0d3e\u0d23\u0d4d, \u0d28\u0d3e\u0d35\u0d3f\u0d15\u0d2f\u0d3e\u0d24\u0d4d\u0d30, \u0d38\u0d4d\u0d35\u0d2d\u0d3e\u0d35 \u0d28\u0d1f\u0d2a\u0d4d\u0d2a\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d7d\u0d15\u0d7e, \u0d05\u0d24\u0d3f\u0d30\u0d3e\u0d35\u0d3f\u0d32\u0d46 \u0d15\u0d4a\u0d28\u0d4d\u0d28\u0d3f \u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d2a\u0d42\u0d28\u0d4d\u0d24\u0d41\u0d2a\u0d47\u0d1f\u0d3f\u0d15\u0d7e \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0bae\u0bb4\u0bc8-\u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0baf\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0b9f\u0b95\u0bc1 \u0baa\u0baf\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0ba8\u0b9f\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b86\u0bb0\u0bcd\u0ba8\