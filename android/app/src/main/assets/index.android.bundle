\u0d4d\u0d1a\u0d41\u0d35\u0d34\u0d3f\u0d2f\u0d41\u0d02 \u0d15\u0d23\u0d4d\u0d23\u0d42\u0d30\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15 \u0d05\u0d24\u0d40\u0d24\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d12\u0d34\u0d3f\u0d35\u0d41 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0bcb\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0bb8\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba3\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8, \u0b85\u0bb0\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bb2\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0ba3\u0bcd\u0ba3\u0bc2\u0bb0\u0bbf\u0ba9\u0bcd \u0b86\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bb1\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1 \u0bae\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"75.364593",lat:"11.730632"},name:"Muzhappilangad Beach",name_HI:"\u092e\u0941\u091d\u092a\u094d\u092a\u093f\u0932\u0902\u0917\u093e\u0921 \u092c\u0940\u091a",name_ML:"\u0d2e\u0d41\u0d34\u0d2a\u0d4d\u0d2a\u0d3f\u0d32\u0d19\u0d4d\u0d19\u0d3e\u0d1f\u0d4d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0bae\u0bc1\u0bb4\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"One of Asia's longest drive-in beaches, famous for its golden sands, shallow waters, and thrilling beach driving experience.",note_HI:"\u090f\u0936\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u0932\u0902\u092c\u0947 \u0921\u094d\u0930\u093e\u0907\u0935-\u0907\u0928 \u092c\u0940\u091a\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915, \u091c\u093f\u0938\u0947 \u0938\u094d\u0935\u0930\u094d\u0923\u093f\u092e \u0930\u0947\u0924, \u0915\u092e \u0917\u0939\u0930\u0947 \u092a\u093e\u0928\u0940 \u0914\u0930 \u0930\u094b\u092e\u093e\u0902\u091a\u0915 \u092c\u0940\u091a \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0905\u0928\u0941\u092d\u0935 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d0f\u0d37\u0d4d\u0d2f\u0d3e\u0d2f\u0d3f\u0d32\u0d46 \u0d28\u0d40\u0d23\u0d4d\u0d1f drive-in \u0d15\u0d1f\u0d7d\u0d24\u0d4d\u0d24\u0d40\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d12\u0d28\u0d4d\u0d28\u0d4d, \u0d38\u0d4d\u0d35\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d23\u0d4d\u0d23\u0d3f\u0d32\u0d41\u0d02, \u0d05\u0d15\u0d32\u0d46 \u0d1c\u0d32\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d41\u0d02, \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d2d\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d15\u0d1f\u0d7d \u0d21\u0d4d\u0d30\u0d48\u0d35\u0d3f\u0d02\u0d17\u0d4d \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b86\u0b9a\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0bae\u0bbf\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0ba3\u0bcd\u0b9f \u0b87\u0baf\u0b95\u0bcd\u0b95\u0bc1\u0ba8\u0bb0\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc1, \u0baa\u0bca\u0ba9\u0bcd\u0bae\u0ba3\u0bcd\u0ba3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b86\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bae\u0bbe\u0ba9 \u0b95\u0b9f\u0bb1\u0bcd\u0baa\u0baf\u0ba3\u0bae\u0bcd \u0b85\u0ba9\u0bc1\u0baa\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9\u0ba4\u0bc1."},{location:{long:"75.376342",lat:"11.874244"},name:"Payyambalam Beach",name_HI:"\u092a\u092f\u094d\u092f\u092e\u094d\u092c\u0932\u092e \u092c\u0940\u091a",name_ML:"\u0d2a\u0d2f\u0d4d\u0d2f\u0d02\u0d2c\u0d32\u0d02 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0baa\u0baf\u0bcd\u0baf\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A scenic beach known for its golden sand, calm waters, and a well-maintained park, providing a relaxing environment for visitors.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094c\u092d\u093e\u0917\u094d\u092f\u092a\u0942\u0930\u094d\u0923 \u092c\u0940\u091a \u091c\u093f\u0938\u0947 \u0938\u094d\u0935\u0930\u094d\u0923\u093f\u092e \u0930\u0947\u0924, \u0936\u093e\u0902\u0924 \u091c\u0932 \u0914\u0930 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u092a\u093e\u0930\u094d\u0915 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0906\u0917\u0902\u0924\u0941\u0915\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d38\u0d4d\u0d35\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d23\u0d4d\u0d23\u0d3f\u0d32\u0d41\u0d02, \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d1c\u0d32\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d02, \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\u0d2f \u0d15\u0d1f\u0d7d \u0d24\u0d40\u0d30\u0d02.",note_TA:"\u0baa\u0bca\u0ba9\u0bcd\u0bae\u0ba3\u0bcd, \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0ba8\u0bc0\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bb2\u0bae\u0bbe\u0b95 \u0baa\u0bb0\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe \u0b85\u0bb0\u0bc1\u0bb5\u0bbf, \u0b86\u0bb1\u0bbe\u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc8\u0baf \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8."},{location:{long:"75.363633",lat:"11.864205"},name:"Arakkal Museum",name_HI:"\u0905\u0930\u0915\u094d\u0915\u0932 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f",name_ML:"\u0d05\u0d30\u0d15\u0d4d\u0d15\u0d7d \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02",name_TA:"\u0b85\u0bb0\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0ba8\u0bc2\u0bb2\u0b95\u0bae\u0bcd",note:"A museum showcasing the history and heritage of the Arakkal family, the only Muslim royal family in Kerala.",note_HI:"\u090f\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u091c\u094b \u0905\u0930\u0915\u094d\u0915\u0932 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0927\u0930\u094b\u0939\u0930 \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0915\u0947\u0930\u0932 \u092e\u0947\u0902 \u090f\u0915\u092e\u093e\u0924\u094d\u0930 \u092e\u0941\u0938\u094d\u0932\u093f\u092e \u0930\u0949\u092f\u0932 \u092a\u0930\u093f\u0935\u093e\u0930\u0964",note_ML:"\u0d05\u0d30\u0d15\u0d4d\u0d15\u0d7d \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d15\u0d3e\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d3e\u0d32\u0d2f\u0d02, \u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d0f\u0d15\u0d2e\u0d3e\u0d24\u0d4d\u0d30 \u0d2e\u0d41\u0d38\u0d4d\u0d32\u0d3f\u0d02 \u0d31\u0d4b\u0d2f\u0d32\u0d4d\u200d \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b85\u0bb0\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0ba8\u0bc2\u0bb2\u0b95\u0bae\u0bcd, \u0b95\u0bc7\u0bb0\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1\u0bae\u0bc1\u0bb1\u0bc8 \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0bb0\u0bbe\u0b9c\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa\u0bae\u0bcd."},{location:{long:"75.380117",lat:"11.868849"},name:"Kannur Beach",name_HI:"\u0915\u0928\u094d\u0928\u0942\u0930 \u092c\u0940\u091a",name_ML:"\u0d15\u0d23\u0d4d\u0d23\u0d42\u0d7c \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b95\u0ba3\u0bcd\u0ba3\u0bc2\u0bb0\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A popular beach with a vibrant atmosphere, offering scenic views, water sports activities, and a lively fish market.",note_HI:"\u090f\u0915 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f \u091c\u094b \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923, \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932\u0940\u092f \u0926\u0943\u0936\u094d\u092f\u094b\u0902, \u091c\u0932\u0915\u094d\u0930\u0940\u0921\u093c\u093e \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0914\u0930 \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u092e\u091b\u0932\u0940 \u092c\u093e\u091c\u093e\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d3f\u0d24 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d \u0d12\u0d30\u0d41 \u0d1c\u0d40\u0d35\u0d28\u0d4d\u0d24 \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d4b\u0d1f\u0d41\u0d15\u0d42\u0d1f\u0d3f \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d2f\u0d3e\u0d2f \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d1c\u0d32\u0d15\u0d4d\u0d30\u0d40\u0d21\u0d3e \u0d2a\u0d4d\u0d30\u0d35\u0d43\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d1c\u0d40\u0d35\u0d28\u0d4d\u0d24 \u0d2e\u0d40\u0d7b \u0d2e\u0d3e\u0d30\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d41\u0d02 \u0d28\u0d32\u0d4d\u200d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bb5\u0bbe\u0ba9\u0bb5\u0bbf\u0bb2\u0bcd \u0bae\u0ba3\u0bae\u0bbe\u0ba9 \u0b95\u0bbe\u0bb1\u0bcd\u0bb1\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd, \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bbf\u0bb3\u0bc8\u0bb5\u0bc1 \u0bb5\u0bbf\u0bb3\u0bc8\u0baf\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b92\u0bb0\u0bc1 \u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0ba9 \u0bae\u0bc0\u0ba9\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"75.359774",lat:"11.915733"},name:"Parassinikadavu Snake Park",name_HI:"\u092a\u093e\u0930\u093e\u0938\u093f\u0928\u093f\u0915\u093e\u0921\u0935\u0942 \u0938\u093e\u0902\u092a \u092a\u093e\u0930\u094d\u0915",name_ML:"\u0d2a\u0d30\u0d38\u0d4d\u0d38\u0d3f\u0d28\u0d3f\u0d15\u0d1f\u0d35\u0d4d \u0d2a\u0d3e\u0d2e\u0d4d\u0d2a\u0d4d \u0d2a\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d",name_TA:"\u0baa\u0bb0\u0b9a\u0bbf\u0ba9\u0bbf\u0b95\u0b9f\u0bb5\u0bc1 \u0baa\u0bbe\u0bae\u0bcd\u0baa\u0bc1 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe",note:"A unique park known for its collection of snakes and other reptiles, providing educational insights into these fascinating creatures.",note_HI:"\u090f\u0915 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u092a\u093e\u0930\u094d\u0915 \u091c\u094b \u0938\u093e\u0902\u092a\u094b\u0902 \u0914\u0930 \u0905\u0928\u094d\u092f \u0938\u0930\u0940\u0938\u0943\u092a\u094b\u0902 \u0915\u0947 \u0938\u0902\u0917\u094d\u0930\u0939 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948, \u091c\u094b \u0907\u0928 \u0906\u0915\u0930\u094d\u0937\u0915 \u092a\u094d\u0930\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d3e\u0d2e\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d30\u0d3e\u0d38\u0d1a\u0d4d\u0d1a\u0d3f\u0d35\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d36\u0d47\u0d16\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d \u0d05\u0d31\u0d3f\u0d35\u0d41\u0d15\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d2a\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d23\u0d4d \u0d2a\u0d30\u0d38\u0d4d\u0d38\u0d3f\u0d28\u0d3f\u0d15\u0d1f\u0d35\u0d4d \u0d2a\u0d3e\u0d2e\u0d4d\u0d2a\u0d4d \u0d2a\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d, \u0d08 \u0d06\u0d15\u0d30\u0d4d\u0d37\u0d15\u0d2e\u0d3e\u0d2f \u0d1c\u0d40\u0d35\u0d3f\u0d15\u0d33\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d20\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0bb0\u0b9a\u0bbf\u0ba9\u0bbf\u0b95\u0b9f\u0bb5\u0bc1 \u0baa\u0bbe\u0bae\u0bcd\u0baa\u0bc1 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe, \u0baa\u0bbe\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb1 \u0b87\u0bb0\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b9a\u0bc7\u0b95\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd\u0baa\u0b9f\u0bbf \u0b86\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0ba4\u0bc8\u0baf\u0bbe\u0ba9 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd, \u0b87\u0bb5\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f \u0b86\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"75.353294",lat:"11.819493"},name:"Dharmadam Island",name_HI:"\u0927\u0930\u094d\u092e\u0926\u092e \u0926\u094d\u0935\u0940\u092a",name_ML:"\u0d27\u0d30\u0d4d\u200d\u0d2e\u0d26\u0d02 \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d4d",name_TA:"\u0ba4\u0bb0\u0bcd\u0bae\u0ba4\u0bae\u0bcd \u0ba4\u0bc0\u0bb5\u0bc1",note:"A small private island known for its secluded beach, coconut groves, and a serene environment, accessible during low tide.",note_HI:"\u090f\u0915 \u091b\u094b\u091f\u093e \u0928\u093f\u091c\u0940 \u0926\u094d\u0935\u0940\u092a \u091c\u094b \u0905\u092a\u0928\u0940 \u0905\u0932\u0917\u093e\u0935\u0935\u093e\u0926\u0940 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f, \u0928\u093e\u0930\u093f\u092f\u0932 \u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0914\u0930 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948, \u091c\u094b \u0915\u092e \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0938\u092e\u092f \u092e\u0947\u0902 \u092a\u0939\u0941\u0902\u091a\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964",note_ML:"\u0d24\u0d3e\u0d34\u0d4d\u0d28\u0d4d\u0d28 \u0d15\u0d3e\u0d32\u0d24\u0d4d\u0d24\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d47\u0d36\u0d28\u0d02 \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d15\u0d41\u0d31\u0d3f\u0d2f \u0d2a\u0d4d\u0d30\u0d15\u0d1f\u0d2e\u0d3e\u0d2f \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d4d, \u0d05\u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d37\u0d4d\u0d20\u0d3f\u0d24 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d, \u0d28\u0d3e\u0d33\u0d3f\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3e\u0d30\u0d3f\u0d2f\u0d7d \u0d2e\u0d30\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b95\u0bc1\u0bb1\u0bc1\u0ba8\u0bcd\u0ba4\u0bc0\u0bb5\u0bc1 \u0ba8\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0ba3\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0baa\u0bcb\u0ba4\u0bc1 \u0baa\u0bca\u0ba4\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b9a\u0bbf\u0bb1\u0bbf\u0baf \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u0bb0\u0bcd \u0ba4\u0bc0\u0bb5\u0bc1, \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8, \u0ba4\u0bc6\u0b99\u0bcd\u0b95\u0bb2\u0bcd \u0b95\u0bbf\u0bb0\u0bcb\u0bb5\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"75.363266",lat:"11.855649"},name:"Kannur Lighthouse",name_HI:"\u0915\u0928\u094d\u0928\u0942\u0930 \u0932\u093e\u0907\u091f\u0939\u093e\u0909\u0938",name_ML:"\u0d15\u0d23\u0d4d\u0d23\u0d42\u0d7c \u0d24\u0d42\u0d35\u0d32\u0d15\u0d4d\u0d15\u0d1f\u0d32\u0d4d",name_TA:"\u0b95\u0ba3\u0bcd\u0ba3\u0bc2\u0bb0\u0bcd \u0b92\u0bb3\u0bbf\u0baf\u0bb3\u0bb5\u0bc1",note:"An iconic lighthouse located at the cliff of Payyambalam Beach, offering panoramic views of the coastline and the Arabian Sea.",note_HI:"\u092a\u092f\u094d\u092f\u0902\u092c\u0932\u092e \u092c\u0940\u091a \u0915\u0947 \u0909\u091a\u094d\u091a\u093e\u0917\u094d\u0930 \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u0924\u0940\u0915\u093e\u0924\u094d\u092e\u0915 \u0932\u093e\u0907\u091f\u0939\u093e\u0909\u0938, \u0924\u091f\u0930\u0947\u0916\u093e \u0914\u0930 \u0905\u0930\u092c \u0938\u093e\u0917\u0930 \u0915\u0947 \u092a\u094d\u0930\u0936\u093e\u0902\u0924 \u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d2f\u0d4d\u0d2f\u0d2e\u0d4d\u0d2a\u0d32\u0d02 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d40\u0d34\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d3e\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d46 \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46\u0d24\u0d4d\u0d24\u0d3f\u0d2f \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d40\u0d15\u0d3e\u0d24\u0d4d\u0d2e\u0d15 \u0d24\u0d42\u0d35\u0d32\u0d15\u0d4d\u0d15\u0d1f\u0d32\u0d4d, \u0d24\u0d40\u0d30\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d02 \u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d05\u0d30\u0d2c\u0d3f\u0d15\u0d4d \u0d15\u0d1f\u0d32\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d3e\u0d1f\u0d41\u0d15\u0d7e \u0d15\u0d3e\u0d23\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d4a\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0baf\u0bcd\u0baf\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0b9f\u0bae\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b92\u0bb0\u0bc1 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bb2\u0bae\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b95\u0b9f\u0bb1\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0baa\u0bbf\u0b95\u0bcd \u0b95\u0b9f\u0bb2\u0bbf\u0ba9\u0bcd \u0baa\u0ba9\u0bc8\u0bae\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"75.371392",lat:"11.860773"},name:"Mappila Bay",name_HI:"\u092e\u092a\u094d\u092a\u093f\u0932\u093e \u092c\u0947",name_ML:"\u0d2e\u0d3e\u0d2a\u0d4d\u0d2a\u0d3f\u0d33 \u0d24\u0d40\u0d30\u0d02",name_TA:"\u0bae\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0bb3\u0bbe \u0ba4\u0bc0\u0bb0\u0bae\u0bcd",note:"A natural harbor with a tranquil beach, known for its historical significance and as a popular spot for evening walks.",note_HI:"\u090f\u0915 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u092c\u0902\u0926\u0930\u0917\u093e\u0939 \u091c\u093f\u0938\u092e\u0947\u0902 \u090f\u0915 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u092c\u0940\u091a \u0939\u0948, \u091c\u094b \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0914\u0930 \u0936\u093e\u092e \u0915\u0940 \u0938\u0948\u0930 \u0915\u0947 \