\u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d2e, \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d17\u0d40\u0d24 \u0d2b\u0d57\u0d23\u0d4d\u0d1f\u0d7b, \u0d2e\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d1f\u0d3e\u0d30\u0d02 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24 \u0d2a\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d, \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d38\u0d28\u0d4d\u0d28\u0d26\u0d4d\u0d27\u0d30\u0d41\u0d02\u0d15\u0d42\u0d1f\u0d46 \u0d06\u0d28\u0d28\u0d4d\u0d26\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d06\u0d30\u0d3e\u0d2e\u0d15\u0d3e\u0d32 \u0d38\u0d4d\u0d25\u0d32\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"75.779900",lat:"11.255998"},name:"Mishkal Mosque",name_HI:"\u092e\u093f\u0936\u094d\u0915\u0932 \u092e\u0938\u094d\u091c\u093f\u0926",name_ML:"\u0d2e\u0d3f\u0d36\u0d4d\u0d15\u0d32\u0d4d\u200d \u0d2e\u0d38\u0d4d\u0d1c\u0d3f\u0d26\u0d4d",name_TA:"\u0bae\u0bbf\u0bb7\u0bcd\u0b95\u0bb2\u0bcd \u0bae\u0bb8\u0bcd\u0b9c\u0bbf\u0ba4\u0bcd",note:"An ancient mosque built in the traditional Kerala architectural style, known for its intricate woodwork, beautiful carvings, and religious significance.",note_HI:"\u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0915\u0947\u0930\u0932 \u0935\u093e\u0938\u094d\u0924\u0941\u0936\u093f\u0932\u094d\u092a \u0936\u0948\u0932\u0940 \u092e\u0947\u0902 \u092c\u0928\u0940 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092e\u0938\u094d\u091c\u093f\u0926, \u091c\u093f\u0938\u0947 \u091c\u091f\u093f\u0932 \u0932\u0915\u0921\u093c\u0940 \u0915\u0940 \u0915\u093e\u0930\u094d\u092f\u0936\u093f\u0932\u094d\u092a, \u0938\u0941\u0902\u0926\u0930 \u0928\u0915\u094d\u0915\u093e\u0936\u0940 \u0914\u0930 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \