f\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf\u0baf\u0bb2\u0bcd, \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0baa\u0bc1\u0b95\u0bb4\u0bcd, \u0bae\u0ba3\u0bcd \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9f\u0bbf\u0bb0\u0bc6\u0b95\u0bcd\u0b95\u0bbf\u0b99\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0b95\u0bcd\u0ba9\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b87\u0b9f\u0bae\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"75.917858",lat:"10.917710"},name:"Tirur",name_HI:"\u0924\u093f\u0930\u0942\u0930",name_ML:"\u0d24\u0d3f\u0d30\u0d42\u0d7c",name_TA:"\u0ba4\u0bbf\u0bb0\u0bc2\u0bb0\u0bcd",note:"A coastal town known for its cultural heritage, literature, and historical significance as the birthplace of Thunchaththu Ramanujan Ezhuthachan, the father of Malayalam language.",note_HI:"\u090f\u0915 \u0924\u091f\u0940\u092f \u0928\u0917\u0930 \u091c\u093f\u0938\u0947 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0935\u093f\u0930\u093e\u0938\u0924, \u0938\u093e\u0939\u093f\u0924\u094d\u092f\u093f\u0915\u0924\u093e \u0914\u0930 \u0907\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u092e\u0932\u092f\u093e\u0932\u092e \u092d\u093e\u0937\u093e \u0915\u0947 \u092a\u093f\u0924\u093e \u0925\u0902\u091a\u0925\u094d\u0925\u0941 \u0930\u092e\u093e\u0928\u0941\u091c\u0928 \u090f\u091c\u0941\u0925\u093e\u091a\u0928 \u0915\u093e \u091c\u0928\u094d\u092e\u0938\u094d\u0925\u093e\u0928 \u0939\u0948\u0964",note_ML:"\u0d2e\u0d32\u0d2f\u0d3e\u0d33 \u0d2d\u0d3e\u0d37\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d3f\u0d24\u0d3e\u0d35\u0d3e\u0d2f \u0d24\u0d41\u0d1e\u0d4d\u0d1a\u0d24\u0d4d\u0d24\u0d41 \u0d30\u0d2e\u0d3e\u0d28\u0d41\u0d1c\u0d28\u0d4d\u200d \u0d0e\u0d34\u0d41\u0d24\u0d4d\u0d24\u0d1a\u0d4d\u0d1b\u0d28\u0d4d\u0d31\u0d46 \u0d1c\u0d28\u0d4d\u0d2e\u0d2d\u0d42\u0d2e\u0d3f\u0d2f\u0d3e\u0d2f\u0d3e\u0d23\u0d4d \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d, \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30, \u0d38\u0d3e\u0d39\u0d3f\u0d24\u0d4d\u0d2f \u0d2e\u0d24\u0d4d\u0d38\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d24\u0d1f\u0d35\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d24\u0d40\u0d30\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d2e\u0d3e\u0d23\u0d4d \u0d24\u0d3f\u0d30\u0d42\u0d7c.",note_TA:"\u0ba4\u0bbf\u0bb0\u0bc2\u0bb0\u0bcd, \u0ba4\u0bc1\u0b9e\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bc1 \u0b87\u0bb0\u0bbe\u0bae\u0bbe\u0ba9\u0bc1\u0b9c\u0ba9\u0bcd \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bbe\u0b9a\u0bcd\u0b9a\u0ba9\u0bcd, \u0bae\u0bb2\u0bc8\u0baf\u0bbe\u0bb3 \u0bae\u0bca\u0bb4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0ba8\u0bcd\u0ba4\u0bc8 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bc8, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0b89\u0b9f\u0bc8\u0baf \u0b92\u0bb0\u0bc1 \u0b95\u0b9f\u0bb2\u0bb5\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0ba8\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8a\u0bb0\u0bcd \u0b86\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.189536",lat:"11.238596"},name:"Thirumandhamkunnu Temple",name_HI:"\u0924\u093f\u0930\u0941\u092e\u0902\u0926\u092e\u0915\u0941\u0928\u094d\u0928\u0942 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d24\u0d3f\u0d30\u0d41\u0d2e\u0d23\u0d4d\u0d1f\u0d2e\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba8\u0bcd\u0ba4\u0bae\u0bcd\u0b95\u0bc1\u0ba9\u0bcd\u0ba9\u0bc1 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"A renowned Hindu temple dedicated to Goddess Durga, featuring stunning architecture, intricate carvings, and an annual festival called Thirumandhamkunnu Pooram.",note_HI:"\u0926\u0947\u0935\u0940 \u0926\u0941\u0930\u094d\u0917\u093e \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u093f\u0902\u0926\u0942 \u092e\u0902\u0926\u093f\u0930 \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0936\u093e\u0928\u0926\u093e\u0930 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u091c\u091f\u093f\u0932 \u0915\u093e\u0930\u094d\u0935\u093f\u0902\u0917 \u0914\u0930 \u090f\u0915 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0909\u0924\u094d\u0938\u0935 \u0925\u093f\u0930\u0941\u092e\u0902\u0926\u092e\u094d\u0915\u0941\u0928\u094d\u0928\u0942 \u092a\u0942\u0930\u092e \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964",note_ML:"\u0d05\u0d2e\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d4a\u0d28\u0d4d\u0d28\u0d4d \u0d2a\u0d42\u0d1c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d2d\u0d17\u0d35\u0d24\u0d3f \u0d26\u0d41\u0d7c\u0d17\u0d4d\u0d17\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d37\u0d4d\u0d20\u0d3f\u0d24 \u0d2e\u0d28\u0d4d\u0d26\u0d3f\u0d30\u0d2e\u0d3e\u0d23\u0d4d \u0d24\u0d3f\u0d30\u0d41\u0d2e\u0d23\u0d4d\u0d1f\u0d02\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d2e\u0d28\u0d4b\u0d39\u0d30 \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d32, \u0d2a\u0d1f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3f\u0d34\u0d32\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d41\u0d2e\u0d23\u0d4d\u0d1f\u0d02\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d2a\u0d42\u0d30\u0d02 \u0d0e\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d35\u0d3e\u0d30\u0d4d\u0d37\u0d3f\u0d15\u0d4b\u0d24\u0d4d\u0d38\u0d35\u0d35\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d.",note_TA:"\u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba3\u0bcd\u0b9f\u0bae\u0bcd\u0b95\u0bc1\u0ba9\u0bcd\u0ba9\u0bc1 \u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bcd \u0baa\u0bc2\u0b9c\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0b95\u0bbf\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bbe\u0bb2\u0b9f\u0bcd\u0b9a\u0bc1\u0bae\u0bbf \u0b85\u0bae\u0bcd\u0bae\u0ba9\u0bc1\u0b95\u0bcd\u0b95 dedic\u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0b87\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd, \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0baf\u0bae\u0bcd, \u0bae\u0bc2\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0b92\u0bb0\u0bc1 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"75.735803",lat:"11.340598"},name:"Kadalundi",name_HI:"\u0915\u0921\u0932\u0941\u0902\u0926\u0940",name_ML:"\u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f",name_TA:"\u0b95\u0b9f\u0bb2\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf",note:"A serene village located at the confluence of the Kadalundi River and the Arabian Sea, known for its birdwatching, fishing, and a beautiful estuary.",note_HI:"\u0915\u0921\u0932\u0941\u0902\u0926\u0940 \u090f\u0915 \u0936\u093e\u0902\u0924 \u0917\u093e\u0902\u0935 \u0939\u0948 \u091c\u094b \u0915\u0921\u0932\u0941\u0902\u0926\u0940 \u0928\u0926\u0940 \u0914\u0930 \u0905\u0930\u092c \u0938\u093e\u0917\u0930 \u0915\u0947 \u0938\u0902\u0917\u092e \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u0939\u0948, \u092f\u0939 \u092a\u0915\u094d\u0937\u0940 \u0926\u0947\u0916\u0928\u0947, \u092e\u091b\u0932\u0940 \u092a\u0915\u0921\u093c\u0928\u0947 \u0914\u0930 \u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u090f\u0938\u094d\u0924\u0941\u0935\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f \u0d15\u0d1f\u0d32\u0d41\u0d2e\u0d23\u0d4d\u0d23\u0d3f\u0d28\u0d41\u0d02 \u0d05\u0d31\u0d2c\u0d3f\u0d15\u0d4d\u0d15\u0d1f\u0d32\u0d3f\u0d28\u0d41\u0d02 \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d47\u0d16\u0d32\u0d2f\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d2e\u0d3e\u0d27\u0d3e\u0d28\u0d2a\u0d42\u0d7c\u0d35\u0d4d\u0d35\u0d2e\u0d3e\u0d2f \u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d2e\u0d3e\u0d23\u0d4d \u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f, \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02, \u0d2e\u0d40\u0d28\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02, \u0d12\u0d30\u0d41 \u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d2e\u0d41\u0d1f\u0d4d\u0d1f\u0d2a\u0d4d\u0d2a\u0d3e\u0d31\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b95\u0b9f\u0bb2\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf, \u0b95\u0b9f\u0bb2\u0bc1\u0bae\u0ba3\u0bcd\u0ba3\u0bbf\u0ba9\u0bcd \u0bae\u0ba3\u0bcd\u0ba3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bb2\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0ba9 \u0b8a\u0bb0\u0bcd, \u0baa\u0bb1\u0bb5\u0bc8\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0bae\u0bc0\u0ba9\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bc1\u0bae\u0bcd, \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b8f\u0bb0\u0bbf\u0b9a\u0bcd\u0b9a\u0bc1\u0bb5\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."}],Kozhikode:[{location:{long:"75.710059",lat:"11.253396"},name:"Kozhikode Beach",name_HI:"\u0915\u094b\u091d\u093f\u0915\u094b\u0921 \u092c\u0940\u091a",name_ML:"\u0d15\u0d4b\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d4b\u0d1f\u0d4d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b95\u0bcb\u0bb4\u0bbf\u0b95\u0bcd\u0b95\u0bcb\u0b9f\u0bc1 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A scenic beach known for its picturesque sunset views, historic pier, and the iconic lighthouse, offering a refreshing escape by the Arabian Sea.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0935\u093e\u0926\u0941 \u092c\u0940\u091a \u091c\u093f\u0938\u0947 \u0909\u0938\u0915\u0940 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0935\u093e\u0926\u093f\u0937\u094d\u0920 \u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u0926\u0943\u0936\u094d\u092f\u094b\u0902, \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092a\u093f\u092f\u0930, \u0914\u0930 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0932\u093e\u0907\u091f\u0939\u093e\u0909\u0938 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0905\u0930\u092c \u0938\u093e\u0917\u0930 \u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u090f\u0915 \u0924\u093e\u091c\u0917\u0940 \u092d\u093e\u0917\u0940\u0926\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d12\u0d30\u0d41 \u0d1a\u0d3f\u0d24\u0d32\u0d3e\u0d2d \u0d15\u0d1f\u0d32\u0d4d\u200d\u0d2a\u0d4d\u0d2a\u0d3e\u0d1f\u0d4d, \u0d1a\u0d3f\u0d24\u0d32\u0d3e\u0d2d\u0d2e\u0d3e\u0d2f \u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d3e\u0d38\u0d4d\u0d24 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d3e\u0d35\u0d36\u0d47\u0d37\u0d23\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d2a\u0d3f\u0d2f\u0d30\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d32\u0d48\u0d31\u0d4d\u0d31\u0d4d\u0d39\u0d57\u0d38\u0d41\u0d02 \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d1e\u0d4d\u0d1e \u0d05\u0d30\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d46 \u0d12\u0d30\u0d41 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d2d\u0d02 \u0d06\u0d23\u0d4d.",note_TA:"\u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bb4\u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8, \u0bb5\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u0ba4\u0bae\u0bbe\u0ba9 \u0b85\u0bb8\u0bcd\u0ba4\u0bae\u0ba9 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0bb5\u0bbf\u0bae\u0bbe\u0ba9\u0bae\u0bc1\u0bae\u0bcd, \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8 \u0baa\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba4\u0bbe\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"75.738951",lat:"11.358677"},name:"Kappad Beach",name_HI:"\u0915\u092a\u094d\u092a\u093e\u0921 \u092c\u0940\u091a",name_ML:"\u0d15\u0d3e\u0d2a\u0d4d\u0d2a\u0d3e\u0d1f\u0d4d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b95\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A historic beach where Vasco da Gama landed in 1498, marking the beginning of European colonization in India, and featuring a stone monument.",note_HI:"1498 \u092e\u0947\u0902 \u0935\u093e\u0938\u094d\u0915\u094b \u0926 \u0917\u093e\u092e\u093e \u0928\u0947 \u091c\u0939\u093e\u091c\u093c \u091a\u0922\u093c\u093e\u092f\u093e \u0925\u093e, \u091c\u094b \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u092f\u0942\u0930\u094b\u092a\u0940\u092f \u0914\u092a\u0928\u093f\u0935\u0947\u0936\u093f\u0915\u0930\u0923 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u094b \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0914\u0930 \u090f\u0915 \u092a\u0924\u094d\u0925\u0930 \u0938\u094d\u092e\u093e\u0930\u0915 \u0939\u0948\u0964",note_ML:"1498 \u0d32\u0d4d\u200d \u0d35\u0d3e\u0d38\u0d4d\u0d15\u0d4b \u0d21\u0d3f \u0d17\u0d3e\u0d2e \u0d09\u0d33\u0d4d\u0d33\u0d3f\u0d32\u0d4d\u200d\u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d28\u0d4d\u0d28 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d3e\u0d35\u0d36\u0d47\u0d37\u0d23\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d3e\u0d23\u0d4d, \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d3f\u0d32\u0d46 \u0d2f\u0d42\u0d31\u0d4b\u0d2a\u0d4d\u0d2f\u0d28\u0d4d\u200d \u0d06\u0d36\u0d2f\u0d47\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d26\u0d3f\u0d2e\u0d2a\u0d1f\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d12\u0d30\u0d41 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4b\u0d23\u0d4d\u200d \u0d38\u0d4d\u0d2e\u0d3e\u0d30\u0d15\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"1498 \u0b87\u0bb2\u0bcd \u0bb5\u0bbe\u0bb8\u0bcd\u0b95\u0bcb \u0b9f\u0bbe \u0b95\u0bbe\u0bae\u0bbe \u0b85\u0ba3\u0bc1\u0b95\u0bbf\u0baf \u0b92\u0bb0\u0bc1 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8, \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0b90\u0bb0\u0bcb\u0baa\u0bcd\u0baa\u0bbf\u0baf \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bb2\u0bbf\u0ba9\u0bcd \u0ba4\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bc8 \u0b95\u0bc1\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1, \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b95\u0bb2\u0bcd \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"75.804510",lat:"11.169737"},name:"Beypore Beach",name_HI:"\u092c\u0947\u092a\u094b\u0930 \u092c\u0940\u091a",name_ML:"\u0d2c\u0d48\u0d2a\u0d4d\u0d2a\u0d42\u0d30\u0d4d\u200d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0baa\u0bc6\u0baf\u0bcd\u0baa\u0bc2\u0bb0\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A quaint beach town famous for its ancient shipbuilding industry, traditional wooden dhows, and a relaxing beach with fishing activities.",note_HI:"\u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0947 \u091c\u0939\u093e\u091c \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0909\u0926\u094d\u092f\u094b\u0917, \u092a\u093e\u0930\u0902\u092a\u093e\u0930\u093f\u0915 \u0932\u0915\u0921\u093c\u0940 \u0915\u0947 \u0927\u093e\u0909\u0913\u0902 \u0914\u0930 \u092e\u091b\u0932\u0940 \u092a\u0915\u0921\u093c\u0928\u0947 \u0915\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0936\u093e\u0902\u0924 \u092c\u0940\u091a \u0936\u0939\u0930 \u091c\u094b \u092b\u0947\u092e\u0938 \u0939\u0948\u0964",note_ML:"\u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28 \u0d2a\u0d1f\u0d3f\u0d35\u0d47\u0d32\u0d15\u0d4d\u0d15\u0d30\u0d02, \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d15\u0d24\u0d4d\u0d24\u0d47\u0d32\u0d41\u0d15\u0d7e, \u0d2b\u0d3f\u0d37\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d2e\u0d41\u0d26\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d2a\u0d1f\u0d3f\u0d2f\u0d4a\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d1f\u0d4d\u0d1f\u0d23\u0d02.",note_TA:"\u0baa\u0bb4\u0bc8\u0baf \u0b95\u0baa\u0bcd\u0baa\u0bb2\u0bcd \u0b89\u0bb4\u0bb5\u0bc1 \u0ba4\u0bca\u0bb4\u0bbf\u0bb2\u0bbe\u0bb3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd, \u0baa\u0bbe\u0bb0\u0bbe\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0bae\u0bb0 \u0bb5\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0bcb\u0b9f\u0bcd\u0b9f\u0bae\u0bc1\u0bae\u0bcd, \u0bae\u0bc0\u0ba9\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b9a\u0bc6\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0ba4\u0bbf\u0baf \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8 \u0ba8\u0b95\u0bb0\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0bbe\u0baf\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bbe\u0ba9 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8 \u0ba8\u0b95\u0bb0\u0bae\u0bcd."},{location:{long:"75.832705",lat:"11.207898"},name:"Kadalundi Bird Sanctuary",name_HI:"\u0915\u093e\u0926\u0932\u0941\u0902\u0921\u093f \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d23\u0d02",name_TA:"\u0b95\u0b9f\u0bb2\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf \u0baa\u0bb1\u0bb5\u0bc8 \u0baa\u0bb3\u0bcd\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bae\u0bcd",note:"A haven for birdwatchers, with a diverse range of avian species and a scenic location along the Kadalundi River, surrounded by mangrove forests.",note_HI:"\u092c\u0930\u094d\u0921\u0935\u0949\u091a\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u094d\u0935\u0930\u094d\u0917, \u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u093f\u0935\u093f\u0927 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u090f\u0915 \u0935\u093f\u0935\u093f\u0927\u0924\u092e \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e \u0914\u0930 \u0915\u093e\u0921\u0932\u0941\u0902\u0921\u0940 \u0928\u0926\u0940 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0935\u093e\u0926\u0941 \u0938\u094d\u0925\u093e\u0928, \u092e\u0948\u0902\u0917\u094d\u0930\u094b\u0935 \u0935\u0928\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0918\u093f\u0930\u0940 \u0939\u0941\u0908\u0964",note_ML:"\u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d23\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d4d\u0d35\u0d30\u0d4d\u200d\u0d17\u0d02, \u0d35\u0d3f\u0d35\u0d3f\u0d27\u0d24\u0d30\u0d02 \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d35\u0d3f\u0d35\u0d3f\u0d27\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d36\u0d4d\u0d30\u0d47\u0d23\u0d3f\u0d2f\u0d41\u0d02 \u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f \u0d28\u0d26\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d38\u0d4d\u0d35\u0d3e\u0d26\u0d41\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d25\u0d32\u0d02, \u0d15\u0d34\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d46 \u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d05\u0d1f\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d.",note_TA:"\u0baa\u0bb1\u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8, \u0bb5\u0bc7\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1 \u0bae\u0bbe\u0b99\u0bcd\u0b95\u0bbe\u0baf\u0bcd \u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbf\u0baf, \u0bb5\u0bb2\u0b99\u0bcd\u0b95\u0bc8 \u0bb5\u0b95\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bc7\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd, \u0b95\u0b9f\u0bb2\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf \u0b86\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0b9a\u0bc2\u0bb0\u0bbf\u0baf\u0b95\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0bb2\u0bb5\u0bc1 \u0b86\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.103082",lat:"11.507309"},name:"Thusharagiri Waterfalls",name_HI:"\u0925\u0942\u0936\u0930\u0917\u093f\u0930\u093f \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d24\u0d41\u0d37\u0d3e\u0d30\u0d17\u0d3f\u0d30\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0ba4\u0bc1\u0bb7\u0bbe\u0bb0\u0b95\u0bbf\u0bb0\u0bbf \u0bb5\u0bc6\u0bb3\u0bcd\u0bb3\u0bae\u0bcd",note:"A picturesque waterfall with lush green surroundings, ideal for trekking and nature walks, offering a refreshing experience in the lap of nature.",note_HI:"\u0939\u0930\u0947 \u092d\u0930\u0947 \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0938\u0941\u0902\u0926\u0930 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924, \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0914\u0930 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0938\u0948\u0930 \u0915\u0947 \u0932\u093f\u090f \u0906\u0926\u0930\u094d\u0936, \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0915\u0947 \u0906\u0901\u091a\u0932 \u092e\u0947\u0902 \u090f\u0915 \u0924\u093e\u091c\u0917\u0940 \u092d\u0930\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u093e \u0911\u092b\u093c\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d24\u0d41\u0d37\u0d3e\u0d30\u0d17\u0d3f\u0d30\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02, \u0d24\u0d34\u0d41\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d1f\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d06\u0d26\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d46 \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d39\u0d30\u0d3f\u0d24 \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d05\u0d1f\u0d3f\u0d2a\u0d4a\u0d33\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0baa\u0ba9\u0bcd\u0ba9\u0bbf\u0bb0\u0bc1 \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf, \u0bae\u0bb2\u0bc8\u0baf\u0bc7\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0ba8\u0b9f\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b86\u0baa\u0bb0\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0bae\u0bc2\u0b9f\u0bbe\u0ba9 \u0bb5\u0bb3\u0bc8\u0bb5\u0bc1\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0ba4\u0bc1."},{location:{long:"75.777326",lat:"11.254583"},name:"Mananchira Square",name_HI:"\u092e\u093e\u0928\u093e\u0902\u091a\u093f\u0930\u093e \u091a\u094c\u0915",name_ML:"\u0d2e\u0d3e\u0d28\u0d3e\u0d1e\u0d4d\u0d1a\u0d3f\u0d31 \u0d38\u0d4d\u0d15\u0d4d\u0d35\u0d2f\u0d30\u0d4d\u200d",name_TA:"\u0bae\u0bbe\u0ba9\u0b9e\u0bcd\u0b9a\u0bbf\u0bb0\u0bbe \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1",note:"A historic square with a serene park, surrounded by colonial buildings, a musical fountain, and an open-air theater, serving as a cultural hub of the city.",note_HI:"\u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u091a\u094c\u0915 \u091c\u093f\u0938\u092e\u0947\u0902 \u090f\u0915 \u0936\u093e\u0902\u0924 \u092a\u093e\u0930\u094d\u0915, \u0915\u094b\u0932\u094b\u0928\u093f\u092f\u0932 \u0907\u092e\u093e\u0930\u0924\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0918\u093f\u0930\u093e \u0939\u0941\u0906, \u090f\u0915 \u0938\u0902\u0917\u0940\u0924\u092e\u092f \u092b\u0935\u094d\u0935\u093e\u0930\u093e \u0914\u0930 \u090f\u0915 \u0916\u0941\u0932\u0947 \u0906\u0915\u093e\u0936 \u0915\u0947 \u0925\u093f\u092f\u0947\u091f\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0936\u0939\u0930 \u0915\u0947 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0947\u0935\u093e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d4a\u0d33\u0d4b\u0d23\u0d3f\u0d2f\u0d32\u0d4d\u200d \u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d3f\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d3e\u0d2f\u0d3f \u0d15\u0d42\u0d1f\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f \u0d38\u0d30\u0d28\u0d3e\u0d2f \u0d2a\u0d3e\u0d30\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d38\u0d4d\u0d15\u0d4d\u0d35\u0d2f\u0d30\u0d4d\u200d, \u0d38\u0d02\u0d17\u0d40\u0d24\u0d02 \u0d28\u0d40\u0d1f\u0d4d\u0d1f\u0d3f\u0d2a\u0d4d\u0d2a\u0d47\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d24\u0d41\u0d02 \u0d24\u0d46\u0d31\u0d4d\u0d31\u0d3e\u0d2f \u0d28\u0d1f\u0d40\u0d1f\u0d3e\u0d24\u0d4d\u0d30\u0d2f\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d35\u0d40\u0d1f\u0d4d\u0d1f\u0d28\u0d4d\u0d24\u0d3f\u0d30\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d12\u0d30\u0d41 \u0d28\u0d17\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d3e\u0d02\u0d38\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d43\u0d24\u0d3f\u0d15 \u0d39\u0d2c\u0d4d\u0d2c\u0d3e\u0d2f\u0d3f \u0d2a\u0d24\u0d3f\u0d2f\u0d46\u0d3e\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b92\u0bb0\u0bc1 \u0ba4\u0bae\u0bbf\u0bb4\u0bb0\u0bcd \u0bae\u0bc8\u0ba4\u0bbe\u0ba9\u0bae\u0bbe\u0ba9 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1, \u0baa\u0bb4\u0bc8\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b9a\u0bc0\u0bb0\u0bcd\u0b95\u0bc7\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bbe\u0ba9 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe, \u0b87\u0b9a\u0bc8\u0baf\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0ba8\u0bbf\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0bc7\u0bb2\u0bbe\u0bb3\u0bb0\u0bbe\u0bb2\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0bae\u0bc8\u0ba4\u0bbe\u0ba9\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"75.917019",lat:"11.460217"},name:"Kozhippara Falls",name_HI:"\u0915\u094b\u091d\u0940\u092a\u093e\u0930\u093e \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d15\u0d4a\u0d34\u0d3f\u0d2a\u0d4d\u0d2a\u0d3e\u0d31 \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0b95\u0bca\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bb1\u0bc8 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf",note:"A beautiful waterfall cascading through rocky terrain, surrounded by dense forests, and offering an opportunity for adventure activities like rock climbing and trekking.",note_HI:"\u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924 \u091c\u094b \u091a\u091f\u094d\u091f\u093e\u0928\u0940 \u092d\u0942\u092e\u093f \u0938\u0947 \u092c\u0939\u0924\u093e \u0939\u0948, \u0918\u0928\u0947 \u091c\u0902\u0917\u0932\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0918\u093f\u0930\u093e \u0939\u0941\u0906 \u0939\u0948, \u0914\u0930 \u092a\u0924\u094d\u0925\u0930\u094b\u0902 \u092a\u0930 \u091a\u0922\u093c\u093e\u0908 \u0914\u0930 \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u091c\u0948\u0938\u0940 \u0938\u093e\u0939\u0938\u093f\u0915 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d36\u0d3f\u0d32\u0d3e\u0d28\u0d3f\u0d30\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d35\u0d33\u0d30\u0d46 \u0d28\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d47\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d2e\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02, \u0d15\u0d1f\u0d32\u0d4d\u200d\u0d2a\u0d4d\u0d2a\u0d1f\u0d15\u0d4d\u0d15\u0d02 \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d39\u0d30\u0d3f\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d32\u0d41\u0d15\u0d33\u0d3e\u0d2f\u0d3f \u0d06\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d2a\u0d3e\u0d31\u0d15\u0d7e \u0d2e\u0d31\u0d4d\u0d31\u0d41\u0d02 \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d3e\u0d39\u0d38\u0d3f\u0d15 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d05\u0d35\u0d38\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b95\u0ba9\u0bbf\u0bae\u0bae\u0bbe\u0ba9 \u0baa\u0bc1\u0ba9\u0bcd\u0b95\u0bc8, \u0bae\u0bb2\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb2\u0bc8\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0bb4\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1, \u0bb0\u0bca\u0b95\u0bcd\u0b95\u0bbf \u0b86\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bbe\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0b9a\u0bbe\u0bb9\u0b9a\u0bbf\u0b95\u0bae\u0bbe\u0ba9 \u0b9a\u0bc6\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b85\u0bb5\u0b9a\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"75.851635",lat:"11.408578"},name:"Sargaalaya Kerala Arts and Crafts Village",name_HI:"\u0938\u0930\u0917\u093e\u0932\u092f \u0915\u0947\u0930\u0932 \u0915\u0932\u093e \u0914\u0930 \u0915\u094d\u0930\u093e\u092b\u094d\u091f\u094d\u0938 \u0917\u093e\u0902\u0935",name_ML:"\u0d38\u0d30\u0d4d\u200d\u0d17\u0d3e\u0d32\u0d2f \u0d15\u0d47\u0d30\u0d33 \u0d15\u0d32\u0d3e\u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d02",name_TA:"\u0b9a\u0bbe\u0bb0\u0bcd\u0b95\u0bbe\u0bb2\u0bc8\u0baf \u0b95\u0bc7\u0bb0\u0bb3\u0bbe \u0b95\u0bb2\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0baa\u0bcd\u0b9f\u0bcd\u0bb8\u0bcd \u0b8a\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bae\u0bcd",note:"A unique crafts village showcasing traditional art and handicrafts of Kerala, where visitors can witness artisans at work and purchase authentic products.",note_HI:"\u090f\u0915 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0915\u0932\u093e \u0914\u0930 \u0915\u094d\u0930\u093e\u092b\u094d\u091f\u094d\u0938 \u0917\u093e\u0902\u0935 \u091c\u094b \u0915\u0947\u0930\u0932 \u0915\u0940 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0915\u0932\u093e \u0914\u0930 \u0939\u0938\u094d\u0924\u0936\u093f\u0932\u094d\u092a\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u0906\u0917\u0902\u0924\u0941\u0915 \u0936\u093f\u0932\u094d\u092a\u0915\u093e\u0930\u094b\u0902 \u0915\u094b \u0915\u093e\u092e \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u09