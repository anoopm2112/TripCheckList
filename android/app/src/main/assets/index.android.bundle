 want to erase all data related to the app?",share:"Share",rateus:"Rate Us",appVersion:"App Version",privacyPolicy:"Privacy Policy",double_tab_info:"Double tab to view app features",local_data_sync:"DATA SYNCING",nothing_to_sync:"Nothing to sync",items_to_sync:"Items need to sync",waiting_to_sync:"Waiting to Sync...",sync_processing:"Sync is processing...",no_data_local_database:"No Data in local Database",sync_to_server:"Sync to server"},Languages:{Tamil:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd",Malayalam:"\u0d2e\u0d32\u0d2f\u0d3e\u0d33\u0d02",Hindi:"\u0939\u093f\u0902\u0926\u0940"},Common:{delete:"Delete",submit:"Submit",cancel:"Cancel",deleteItem:"Are you sure you want to remove this item?",deleteAllItem:"Do you want to delete all item?",please_confirm:"Please Confirm",yes:"Yes",no:"No",other_item:"Other Item",add_checklist:"Add Checklist",history:"History",close:"Close",reset:"Reset",remove_all_data:"REMOVE ALL",items:"ITEMS",done:"DONE",play_video:"PLAY VIDEO",logoutApp:"Do you want to logout?",network_error:"Please click here to reload",no_internet:"No internet connection"},checklist:{info:"Gather all necessary materials and supplies. Review and revise the checklist as needed to ensure accuracy and efficiency. Enjoy your journey!!!",pack_your_bag:"Hello There, Pack your bag !!!",input_val:"Please enter something about your trip.",return_val:"Please set reminder for your return.",input_placeholder:"Write something about your trip...",item_missing:"Item Missing, To continue with missing item, Please click on check box",take_picture:"Take Item Picture",add_item_to_list:"Add item to list",header:{Add_Checklist:"ADD CHECKLIST",Add_Checklist_Items:"ADD CHECKLIST ITEMS"},checklist_reminder:"SET TIME FOR RETURN",checklist_help_info:"Create and maintain personalized lists, ensuring they remember all necessary items during their journeys."},Touristplace:{district:"DISTRICT",state:"STATE",district_info:"To view information on any district, please click on it.",kerala:"KERALA",map:"MAP",settingsPermissionGrant:"Grant Permission from Settings",settingsPermissionGrantMsg:"You have denied location morethan 2 times, You need to grand permission from mobile settings",location_alert:"Please wait, we are accessing your current location...",location_denied:"You have denied access to location.",location_request_again:"Click here to request location again.",get_location:"Get Location",open_settings:"Open Settings",deny_permissions:"Deny permissions",grant_permissions:"Grant permissions",must_grant_or_exit:"You must grant all permissions to continue using this app",allow_blocked_permissions:"Some permissions where denied more than once, please enable them from settings",youAreOffline:"You are currently offline",viewgmaploc:"To view the driving route on Google Map, tap on Card View.",recieveLocation:"Click on get location and recieve your needed location and click done to exit google map view",recieve_location:"LOCATION RECIEVED",view_location:"View Location",km:"km",min:"min",tourist_help_info:"Efficient expense tracking and splitting among friends or travelers.",location:"Place Location",place_google_location:"Place Google Location",place_name:"Place Name",place_note:"Place Note",add_new_place:"NEW PLACE",add_place:"ADD PLACE",update_place:"UPDATE PLACE",list_all_place:"LIST ALL PLACES",enter_place_name:"Please Enter Place Name",enter_place_note:"Please Enter Place Note",enter_your_place_name:"Enter Your Place Name",enter_your_place_note:"Enter Your Place Note",edit:"EDIT",created_By:"Created By"},Districts:{Kasaragod:"Kasaragod",Kannur:"Kannur",Kozhikode:"Kozhikode",Wayanad:"Wayanad",Malappuram:"Malappuram",Palakkad:"Palakkad",Thrissur:"Thrissur",Ernakulam:"Ernakulam",Idukki:"Idukki",Kottayam:"Kottayam",Alappuzha:"Alappuzha",Pathanamthitta:"Pathanamthitta",Kollam:"Kollam",Thiruvananthapuram:"Thiruvananthapuram"},PaidBy:{payer:"Choose the payer...",paidBy:"Paid By!"},CostPlanner:{costPlanner:"Cost Planner",total_travel_cost:"Total Travel Cost",check_cost:"Check Cost",fuel_price:"Fuel Price",enter_fuel_price:"Enter Fuel Price",enter_mileage:"Enter Mileage",enter_distance:"Enter Distance",enter_cost:"Enter Cost",enter_fuel_liters:"Enter Fuel In Liters",total_mileage:"Total Mileage",check_mileage:"Check Mileage",L:"L",fuel_liters:"Fuel (In Liters)",Total_travel_distance:"Total Travel Distance",check_distance:"Check Distance",km:"KM",cost:"Cost",mileage:"Mileage",distance:"Distance",how_to_save_fuel:"HOW TO SAVE FUEL",info_1:"15% savings are added by turning off the air conditioner",info_2:"20% savings are added by a non-aggressive driving style with smooth acceleration / braking, at 2000-2500 RPM",info_3:"Low-quality gasoline adds 10% savings",info_4:"5% savings add off low beam/high beam",info_5:"Do not forget to periodically check the technical condition of the car, because some kind of malfunction, for example, a clogged fuel filter or low tire pressure can increase fuel consumption at times!",fuel_price_val:"Please enter fuel price",mileage_val:"Please enter Mileage",distance_val:"Please enter Distance",cost_val:"Please enter Cost",cost_help_inof:"Users can calculate distance, mileage, and cost by inputting fuel price, mileage, and distance."},AboutUs:{AboutUs:"ABOUT US"},ContactUs:{contactUs:"CONTACT US",subject:"Subject",enter_subject:"Please Enter Subject",enter_message:"Please Enter Message",enter_your_subject:"Enter Your Subject",enter_your_message:"Enter Your Message",message:"Message",send:"Send"},Help:{help:"HELP",takeTour:"TAKE A TOUR"},Logout:{logout:"LOGOUT AND EXIT"},Quotes:{quote_1:"A well-prepared traveler is a confident adventurer. A checklist ensures you never leave behind the essentials, turning your trip into a worry-free experience.",quote_2:"Checklists are the backbone of a successful journey. They help us remember the small things that make a big difference and ensure our trips are filled with joy, not regret.",quote_3:"Splitwise takes the hassle out of money matters, bringing harmony to group expenses and keeping friendships intact.",quote_4:"It's not how much money you make, but how much money you keep, how hard it works for you, and how many generations you keep it for.",quote_5:"The world is a book, and those who do not travel read only one page.",quote_6:"Travel is fatal to prejudice, bigotry, and narrow-mindedness.",quote_7:"A budget is telling your money where to go instead of wondering where it went.",quote_8:"Travel doesn't have to break the bank. With careful planning and budgeting, you can create incredible adventures within your means.",dave_ramsey:"Dave Ramsey",robert_kiyosaki:"Robert Kiyosaki",saint_augustine:"Saint Augustine",mark_twain:"Mark Twain"}}},678,[]);
