\u0915\u093e \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u0928\u093e\u0964"},checklist_img:'https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8Y2hlY2tsaXN0fGVufDB8fDB8fHww&w=1000&q=80',splitwise_Sub_heading_1:{en:"Manage expenses with friends.",ml:"\u0d38\u0d41\u0d39\u0d43\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d1a\u0d46\u0d32\u0d35\u0d41\u0d15\u0d7e \u0d15\u0d48\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",ta:"\u0ba8\u0ba3\u0bcd\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0b95\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd.",hi:"\u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0930\u094d\u091a\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0930\u0947\u0902\u0964"},splitwise_1:{en:"Add friends, track shared expenses, Add notes, and generate detailed invoices.",ml:"\u0d38\u0d41\u0d39\u0d43\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f \u0d1a\u0d46\u0d32\u0d35\u0d41\u0d15\u0d7e \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f \u0d07\u0d7b\u0d35\u0d4b\u0d2f\u0d4d\u200c\u0d38\u0d41\u0d15\u0d7e \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",ta:"\u0ba8\u0ba3\u0bcd\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd, \u0baa\u0b95\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd, \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb0\u0bbf\u0bb5\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd.",hi:"\u092e\u093f\u0924\u094d\u0930\u094b\u0902 \u0915\u094b \u091c\u094b\u0921\u093c\u0947\u0902, \u0938\u093e\u091d\u093e \u0916\u0930\u094d\u091a\u094b\u0902 \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902, \u0928\u094b\u091f\u094d\u0938 \u091c\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u091a\u093e\u0932\u093e\u0928 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902\u0964"},splitwise_Sub_heading_2:{en:"Split amount calculates",ml:"\u0d35\u0d3f\u0d2d\u0d1c\u0d28 \u0d24\u0d41\u0d15 \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",ta:"\u0baa\u0bbf\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0bca\u0b95\u0bc8 \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1",hi:"\u0935\u093f\u092d\u093e\u091c\u093f\u0924 \u0930\u093e\u0936\u093f \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948"},splitwise_2:{en:"Calculates the split amount for each participant based on the predefined split method.",ml:"\u0d2e\u0d41\u0d7b\u0d15\u0d42\u0d1f\u0d4d\u0d1f\u0d3f \u0d28\u0d3f\u0d36\u0d4d\u0d1a\u0d2f\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d3f\u0d2d\u0d1c\u0d28 \u0d30\u0d40\u0d24\u0d3f\u0d2f\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f \u0d13\u0d30\u0d4b \u0d2a\u0d19\u0d4d\u0d15\u0d3e\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d2d\u0d1c\u0d28 \u0d24\u0d41\u0d15 \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ta:"\u0bae\u0bc1\u0ba9\u0bcd \u0bb5\u0bb0\u0bc8\u0baf\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0bb3\u0bb5\u0bc1 \u0bae\u0bc1\u0bb1\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b92\u0bb5\u0bcd\u0bb5\u0bca\u0bb0\u0bc1 \u0baa\u0b99\u0bcd\u0b95\u0bc7\u0bb1\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\u0bca\u0b95\u0bc8\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",hi:"\u092a\u0942\u0930\u094d\u0935\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0935\u093f\u092d\u093e\u091c\u0928 \u092a\u0926\u094d\u0927\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u092d\u093e\u091c\u0928 \u0930\u093e\u0936\u093f \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},splitwise_Sub_heading_3:{en:"Generates an invoice of the shared expenses.",ml:"\u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f \u0d1a\u0d46\u0d32\u0d35\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d07\u0d7b\u0d35\u0d4b\u0d2f\u0d4d\u0d38\u0d4d \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ta:"\u0baa\u0b95\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",hi:"\u0938\u093e\u091d\u093e \u0916\u0930\u094d\u091a\u094b\u0902 \u0915\u093e \u091a\u093e\u0932\u093e\u0928 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},splitwise_3:{en:'The invoice displays the total amount spent, the individual amounts owed or to be reimbursed by each participant.',ml:"\u0d07\u0d7b\u0d35\u0d4b\u0d2f\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d32\u0d35\u0d34\u0d3f\u0d1a\u0d4d\u0d1a \u0d2e\u0d4a\u0d24\u0d4d\u0d24\u0d02 \u0d24\u0d41\u0d15, \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24 \u0d24\u0d41\u0d15\u0d15\u0d7e \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d13\u0d30\u0d4b \u0d2a\u0d19\u0d4d\u0d15\u0d3e\u0d33\u0d3f\u0d2f\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f \u0d24\u0d41\u0d15 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ta:"\u0b92\u0bb5\u0bcd\u0bb5\u0bca\u0bb0\u0bc1 \u0baa\u0b99\u0bcd\u0b95\u0bc7\u0bb1\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bc1\u0bae\u0bcd \u0b9a\u0bc6\u0bb2\u0bb5\u0bb4\u0bbf\u0ba4\u0bcd\u0ba4 \u0bae\u0bca\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0bca\u0b95\u0bc8, \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bca\u0b95\u0bc8\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b9a\u0bcd \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0ba4\u0bca\u0b95\u0bc8 \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8 \u0bb5\u0bbf\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",hi:"\u091a\u093e\u0932\u093e\u0928 \u0916\u0930\u094d\u091a \u0915\u0940 \u0917\u0908 \u0915\u0941\u0932 \u0930\u093e\u0936\u093f, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u0915\u093e\u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u093e\u0936\u093f \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0930\u093e\u0936\u093f \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},splitwise_img:'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQVqetD4CWj1xijLRMa-BL-H4ygT16jw1sJZQ&usqp=CAU',touristSpot_Sub_heading_1:{en:"View state and District",ml:"\u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d35\u0d41\u0d02 \u0d1c\u0d3f\u0d32\u0d4d\u0d32\u0d2f\u0d41\u0d02 \u0d15\u0d3e\u0d23\u0d41\u0d15",ta:"\u0bae\u0bbe\u0ba8\u0bbf\u0bb2\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",hi:"\u0930\u093e\u091c\u094d\u092f \u0914\u0930 \u091c\u093f\u0932\u093e \u0926\u0947\u0916\u0947\u0902"},touristSpot_1:{en:'Explore all the states and detailed information about districts within each state.',ml:"\u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d13\u0d30\u0d4b \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d32\u0d46 \u0d1c\u0d3f\u0d32\u0d4d\u0d32\u0d15\u0d33\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d30\u0d4d\u0d2f\u0d35\u0d47\u0d15\u0d4d\u0d37\u0d23\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",ta:"\u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1 \u0bae\u0bbe\u0ba8\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0bb5\u0bcd\u0bb5\u0bca\u0bb0\u0bc1 \u0bae\u0bbe\u0ba8\u0bbf\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0bb5\u0bbf\u0bb0\u0bbf\u0bb5\u0bbe\u0ba9 \u0ba4\u0b95\u0bb5\u0bb2\u0bc8 \u0b86\u0bb0\u0bbe\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.",hi:"\u0938\u092d\u0940 \u0930\u093e\u091c\u094d\u092f\u094b\u0902 \u0915\u093e \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u091c\u093f\u0932\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964"},touristSpot_Sub_heading_2:{en:"Top 10 tourist spots in each district",ml:"\u0d13\u0d30\u0d4b \u0d1c\u0d3f\u0d32\u0d4d\u0d32\u0d2f\u0d3f\u0d32\u0d46\u0d2f\u0d41\u0d02 \u0d2e\u0d3f\u0d15\u0d1a\u0d4d\u0d1a 10 \u0d35\u0d3f\u0d28\u0d4b\u0d26\u0d38\u0d1e\u0d4d\u0d1a\u0d3e\u0d30 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e",ta:"\u0b92\u0bb5\u0bcd\u0bb5\u0bca\u0bb0\u0bc1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 10 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe\u0ba4\u0bcd \u0ba4\u0bb2\u0b99\u0bcd\u0b95\u0bb3\u0bcd",hi:"\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u091c\u093f\u0932\u0947 \u092e\u0947\u0902 \u0936\u0940\u0930\u094d\u0937 10 \u092a\u0930\u094d\u092f\u091f\u0928 \u0938\u094d\u0925\u0932"},touristSpot_2:{en:'Allowing users to discover popular attractions and plan their itineraries',ml:"\u0d1c\u0d28\u0d2a\u0d4d\u0d30\u0d3f\u0d2f \u0d06\u0d15\u0d7c\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d3e\u0d2a\u0d30\u0d3f\u0d2a\u0d3e\u0d1f\u0d3f\u0d15\u0d7e \u0d06\u0d38\u0d42\u0d24\u0d4d\u0d30\u0d23\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",ta:"\u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf\u0bb5\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0ba3\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd \u0baa\u0baf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bc8 \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1",hi:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0906\u0915\u0930\u094d\u0937\u0923\u094b\u0902 \u0915\u0940 \u0916\u094b\u091c \u0915\u0930\u0928\u0947 \u0914\u0930 \u0909\u0928\u0915\u0947 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0928\u093e"},touristSpot_Sub_heading_3:{en:"View the location of each tourist spot",ml:"\u0d13\u0d30\u0d4b \u0d1f\u0d42\u0d31\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d25\u0d32\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d02 \u0d15\u0d3e\u0d23\u0d41\u0d15",ta:"\u0b92\u0bb5\u0bcd\u0bb5\u0bca\u0bb0\u0bc1 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe \u0ba4\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",hi:"\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u0930\u094d\u092f\u091f\u0915 \u0938\u094d\u0925\u0932 \u0915\u093e \u0938\u094d\u0925\u093e\u0928 \u0926\u0947\u0916\u0947\u0902"},touristSpot_3:{en:'Location permission is granted, seamlessly navigate to the external "Google Maps" app for turn-by-turn driving directions.',ml:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d05\u0d28\u0d41\u0d2e\u0d24\u0d3f \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d1f\u0d47\u0d7a-\u0d2c\u0d48-\u0d1f\u0d47\u0d7a \u0d21\u0d4d\u0d30\u0d48\u0d35\u0d3f\u0d02\u0d17\u0d4d \u0d26\u0d3f\u0d36\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2c\u0d3e\u0d39\u0d4d\u0d2f 'Google \u0d2e\u0d3e\u0d2a\u0d4d\u200c\u0d38\u0d4d' \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d1f\u0d38\u0d4d\u0d38\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d46 \u0d28\u0d3e\u0d35\u0d3f\u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",ta:"\u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b9f \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1, \u0b9f\u0bb0\u0bcd\u0ba9\u0bcd-\u0baa\u0bc8-\u0b9f\u0bb0\u0bcd\u0ba9\u0bcd \u0b9f\u0bbf\u0bb0\u0bc8\u0bb5\u0bbf\u0b99\u0bcd \u0ba4\u0bbf\u0b9a\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc6\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0bb1 '\u0b95\u0bc2\u0b95\u0bc1\u0bb3\u0bcd \u0bae\u0bc7\u0baa\u0bcd\u0bb8\u0bcd' \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0b9f\u0bc8\u0baf\u0bbf\u0ba9\u0bcd\u0bb1\u0bbf \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2\u0bb5\u0bc1\u0bae\u0bcd.",hi:"\u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0940 \u0917\u0908 \u0939\u0948, \u092c\u093e\u0930\u0940-\u092c\u093e\u0930\u0940 \u0938\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0926\u093f\u0936\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0939\u0930\u0940 '\u0917\u0942\u0917\u0932 \u092e\u0948\u092a\u094d\u0938' \u0910\u092a \u092a\u0930 \u0938\u0939\u091c\u0924\u093e \u0938\u0947 \u0928\u0947\u0935\u093f\u0917\u0947\u091f \u0915\u0930\u0947\u0902\u0964"},touristSpot_img:'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTewvAh7-J0jqLWIXKZqnGQNQ2sfIo0CdbCg&usqp=CAU',costPlanner_Sub_heading_1:{en:"Calculate various cost-related aspects",ml:"\u0d1a\u0d46\u0d32\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d35\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15",ta:"\u0baa\u0bb2\u0bcd\u0bb5\u0bc7\u0bb1\u0bc1 \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1 \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b85\u0bae\u0bcd\u0b9a\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd",hi:"\u0932\u093e\u0917\u0924-\u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u0939\u0932\u0941\u0913\u0902 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0947\u0902"},costPlanner_1:{en:"They can determine the distance of the journey by inputting the fuel price, mileage, and overall cost.",ml:"\u0d07\u0d28\u0d4d\u0d27\u0d28\u0d35\u0d3f\u0d32, \u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d4d, \u0d2e\u0d4a\u0d24\u0d4d\u0d24\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d1a\u0d46\u0d32\u0d35\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d7d\u0d15\u0d3f \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d2f\u0d41\u0d1f\u0d46 \u0d26\u0d42\u0d30\u0d02 \u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d7c\u0d23\u0d4d\u0d23\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02.",ta:"\u0b8e\u0bb0\u0bbf\u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0bb5\u0bbf\u0bb2\u0bc8, \u0bae\u0bc8\u0bb2\u0bc7\u0b9c\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b92\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bca\u0ba4\u0bcd\u0ba4 \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1 \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8 \u0b89\u0bb3\u0bcd\u0bb3\u0bc0\u0b9f\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0ba4\u0bc2\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd.",hi:"\u0935\u0947 \u0908\u0902\u0927\u0928 \u0915\u0940 \u0915\u0940\u092e\u0924, \u092e\u093e\u0907\u0932\u0947\u091c \u0914\u0930 \u0915\u0941\u0932 \u0932\u093e\u0917\u0924 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0940 \u0926\u0942\u0930\u0940 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},costPlanner_Sub_heading_2:{en:"Calculate the mileage & cost of trip",ml:"\u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d2f\u0d41\u0d1f\u0d46 \u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d41\u0d02 \u0d1a\u0d46\u0d32\u0d35\u0d41\u0d02 \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15",ta:"\u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc8\u0bb2\u0bc7\u0b9c\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc6\u0bb2\u0bb5\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd",hi:"\u0909\u0928\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u092e\u093e\u0907\u0932\u0947\u091c \u0914\u0930 \u0932\u093e\u0917\u0924 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0947\u0902"},costPlanner_2:{en:'Estimate by providing the fuel price, mileage, and distance',ml:"\u0d07\u0d28\u0d4d\u0d27\u0d28\u0d35\u0d3f\u0d32, \u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d4d, \u0d26\u0d42\u0d30\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d7d\u0d15\u0d3f \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15",ta:"\u0b8e\u0bb0\u0bbf\u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0bb5\u0bbf\u0bb2\u0bc8, \u0bae\u0bc8\u0bb2\u0bc7\u0b9c\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc2\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd",hi:"\u0908\u0902\u0927\u0928 \u0915\u0940 \u0915\u0940\u092e\u0924, \u092e\u093e\u0907\u0932\u0947\u091c \u0914\u0930 \u0926\u0942\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0915\u0947 \u0905\u0928\u0941\u092e\u093e\u0928 \u0932\u0917\u093e\u090f\u0902"},costPlanner_Sub_heading_3:{en:"Cost planning tool",ml:"\u0d1a\u0d46\u0d32\u0d35\u0d4d \u0d06\u0d38\u0d42\u0d24\u0d4d\u0d30\u0d23 \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d02",ta:"\u0b9a\u0bc6\u0bb2\u0bb5\u0bc1 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0b9f\u0bb2\u0bcd \u0b95\u0bb0\u0bc1\u0bb5\u0bbf",hi:"\u0932\u093e\u0917\u0924 \u0928\u093f\u092f\u094b\u091c\u0928 \u0909\u092a\u0915\u0930\u0923"},costPlanner_3:{en:'Make informed decisions and effectively budget their travel expenses.',ml:"\u0d05\u0d31\u0d3f\u0d35\u0d4b\u0d1f\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d24\u0d40\u0d30\u0d41\u0d2e\u0d3e\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d3e \u0d1a\u0d46\u0d32\u0d35\u0d41\u0d15\u0d7e \u0d2b\u0d32\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d1c\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",ta:"\u0ba4\u0b95\u0bb5\u0bb2\u0bb1\u0bbf\u0ba8\u0bcd\u0ba4 \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0ba3\u0b9a\u0bcd \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0ba4\u0bbf\u0bb1\u0bae\u0bcd\u0baa\u0b9f \u0baa\u0b9f\u0bcd\u0b9c\u0bc6\u0b9f\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd.",hi:"\u0938\u094b\u091a-\u0938\u092e\u091d\u0915\u0930 \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0902 \u0914\u0930 \u0909\u0928\u0915\u0947 \u092f\u093e\u0924\u094d\u0930\u093e \u0916\u0930\u094d\u091a\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0922\u0902\u0917 \u0938\u0947 \u092c\u091c\u091f \u092c\u0928\u093e\u090f\u0902\u0964"},costPlanner_img:'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQFvPiEupTFCRW9xBkvFbHrPqDZv8ZdR0nWcw&usqp=CAU',additionalInfo_Sub_heading_1:{en:'We understand the importance of customization',ml:"\u0d07\u0d37\u0d4d\u200c\u0d1f\u0d3e\u0d28\u0d41\u0d38\u0d43\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d32\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d02 \u0d1e\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",ta:"\u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0baf\u0ba9\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc1\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bca\u0bb3\u0bcd\u0b95\u0bbf\u0bb1\u0bcb\u0bae\u0bcd",hi:"\u0939\u092e \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0915\u0947 \u092e\u0939\u0924\u094d\u0935 \u0915\u094b \u0938\u092e\u091d\u0924\u0947 \u0939\u0948\u0902"},additionalInfo:{en:'Our app offers additional features like language selection and a dark mode option. Users can personalize their app experience according to their preferences.',ml:"\u0d2d\u0d3e\u0d37\u0d3e \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d2a\u0d4d\u0d2a\u0d41\u0d02 \u0d21\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d4b\u0d21\u0d4d \u0d13\u0d2a\u0d4d\u0d37\u0d28\u0d41\u0d02 \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d27\u0d3f\u0d15 \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d7e \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2e\u0d41\u0d7b\u0d17\u0d23\u0d28\u0d15\u0d7e \u0d05\u0d28\u0d41\u0d38\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d02 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.",ta:"\u0bae\u0bca\u0bb4\u0bbf \u0ba4\u0bc7\u0bb0\u0bcd\u0bb5\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0ba3\u0bcd\u0b9f \u0baa\u0baf\u0ba9\u0bcd\u0bae\u0bc1\u0bb1\u0bc8 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bae\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0b95\u0bc2\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0b85\u0bae\u0bcd\u0b9a\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0baa\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1. \u0baa\u0baf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bc7\u0bb0\u0bcd\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0baf\u0ba9\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd.",hi:"\u0939\u092e\u093e\u0930\u093e \u0910\u092a \u092d\u093e\u0937\u093e \u091a\u092f\u0928 \u0914\u0930 \u0921\u093e\u0930\u094d\u0915 \u092e\u094b\u0921 \u0935\u093f\u0915\u0932\u094d\u092a \u091c\u0948\u0938\u0940 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0905\u092a\u0928\u0947 \u0910\u092a \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u0928\u093f\u091c\u0940\u0915\u0943\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},additionalInfo_Sub_heading_2:{en:'Important Note',ml:"\u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d",ta:"\u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc1",hi:"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0932\u0947\u0916"},notes:{en:'All images and animations used in the app are sourced from Google, and we emphasize that our app is solely intended for educational purposes. There is no real money involved in the app, ensuring a safe and informative experience for users.',ml:"\u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d06\u0d28\u0d3f\u0d2e\u0d47\u0d37\u0d28\u0d41\u0d15\u0d33\u0d41\u0d02 Google-\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d09\u0d31\u0d35\u0d3f\u0d1f\u0d2e\u0d3e\u0d23\u0d4d, \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d2d\u0d4d\u0d2f\u0d3e\u0d38 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d19\u0d4d\u0d19\u0d7e \u0d0a\u0d28\u0d4d\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2a\u0d23\u0d2e\u0d4a\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3f\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d4d\u0d32, \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d35\u0d41\u0d02 \u0d35\u0d3f\u0d1c\u0d4d\u0d1e\u0d3e\u0d28\u0d2a\u0d4d\u0d30\u0d26\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d02 \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ta:"\u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1 \u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bbf\u0bae\u0bc7\u0bb7\u0ba9\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd Google \u0b87\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0bc6\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8, \u0bae\u0bc7\u0bb2\u0bc1\u0bae\u0bcd \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bc1 \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0ba8\u0bcb\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bc7 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb2\u0bbf\u0baf\u0bc1\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0bcb\u0bae\u0bcd. \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b89\u0ba3\u0bcd\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0baa\u0ba3\u0bae\u0bcd \u0b8e\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bc8, \u0b87\u0ba4\u0bc1 \u0baa\u0baf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0ba4\u0bb0\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bc1\u0baa\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf \u0b9a\u0bc6\u0baf\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",hi:"\u0910\u092a \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0917\u0908 \u0938\u092d\u0940 \u091b\u0935\u093f\u092f\u093e\u0902 \u0914\u0930 \u090f\u0928\u093f\u092e\u0947\u0936\u0928 Google \u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u090f \u0917\u090f \u0939\u0948\u0902, \u0914\u0930 \u0939\u092e \u0907\u0938 \u092c\u093e\u0924 \u092a\u0930 \u091c\u094b\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u093e \u0910\u092a \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0936\u0948\u0915\u094d\u0937\u093f\u0915 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u0910\u092a \u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092a\u0948\u0938\u093e \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u091c\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u092a\u0942\u0930\u094d\u0923 \u0905\u0928\u0941\u092d\u0935 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"}}}]},1838,[]);
