d15\u0d4d\u0d15\u0d41\u0d15",km:"\u0d15\u0d3f.\u0d2e\u0d40",cost:"\u0d1a\u0d46\u0d32\u0d35\u0d4d",mileage:"\u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d4d",distance:"\u0d26\u0d42\u0d30\u0d02",how_to_save_fuel:"\u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d07\u0d28\u0d4d\u0d27\u0d28\u0d02 \u0d32\u0d3e\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02",info_1:"\u0d0e\u0d2f\u0d7c\u0d15\u0d23\u0d4d\u0d1f\u0d40\u0d37\u0d23\u0d7c \u0d13\u0d2b\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 15% \u0d32\u0d3e\u0d2d\u0d02 \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",info_2:"2000-2500 RPM-\u0d7d, \u0d38\u0d41\u0d17\u0d2e\u0d2e\u0d3e\u0d2f \u0d06\u0d15\u0d4d\u0d38\u0d3f\u0d32\u0d31\u0d47\u0d37\u0d7b / \u0d2c\u0d4d\u0d30\u0d47\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d38\u0d39\u0d3f\u0d24\u0d02 \u0d06\u0d15\u0d4d\u0d30\u0d2e\u0d23\u0d3e\u0d24\u0d4d\u0d2e\u0d15\u0d2e\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24 \u0d21\u0d4d\u0d30\u0d48\u0d35\u0d3f\u0d02\u0d17\u0d4d \u0d36\u0d48\u0d32\u0d3f\u0d2f\u0d3f\u0d7d 20% \u0d38\u0d47\u0d35\u0d3f\u0d02\u0d17\u0d4d\u0d38\u0d4d \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",info_3:"\u0d17\u0d41\u0d23\u0d28\u0d3f\u0d32\u0d35\u0d3e\u0d30\u0d02 \u0d15\u0d41\u0d31\u0d1e\u0d4d\u0d1e \u0d17\u0d4d\u0d2f\u0d3e\u0d38\u0d4b\u0d32\u0d3f\u0d7b 10% \u0d32\u0d3e\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",info_4:"5% \u0d38\u0d47\u0d35\u0d3f\u0d02\u0d17\u0d4d\u0d38\u0d4d \u0d32\u0d4b \u0d2c\u0d40\u0d02/\u0d39\u0d48 \u0d2c\u0d40\u0d02 \u0d15\u0d42\u0d1f\u0d4d\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",info_5:"\u0d15\u0d3e\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d3e\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d3f\u0d15 \u0d05\u0d35\u0d38\u0d4d\u0d25 \u0d07\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3f\u0d1f\u0d46 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d2e\u0d31\u0d15\u0d4d\u0d15\u0d30\u0d41\u0d24\u0d4d, \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d1a\u0d3f\u0d32 \u0d24\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d24\u0d15\u0d30\u0d3e\u0d31\u0d41\u0d15\u0d7e, \u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d, \u0d05\u0d1f\u0d1e\u0d4d\u0d1e\u0d41\u0d2a\u0d4b\u0d2f \u0d07\u0d28\u0d4d\u0d27\u0d28 \u0d2b\u0d3f\u0d7d\u0d1f\u0d4d\u0d1f\u0d31\u0d4b \u0d15\u0d41\u0d31\u0d1e\u0d4d\u0d1e \u0d1f\u0d2f\u0d7c \u0d2e\u0d7c\u0d26\u0d4d\u0d26\u0d2e\u0d4b \u0d1a\u0d3f\u0d32 \u0d38\u0d2e\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d07\u0d28\u0d4d\u0d27\u0d28 \u0d09\u0d2a\u0d2d\u0d4b\u0d17\u0d02 \u0d35\u0d7c\u0d26\u0d4d\u0d27\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02!",fuel_price_val:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d07\u0d28\u0d4d\u0d27\u0d28\u0d35\u0d3f\u0d32 \u0d28\u0d7d\u0d15\u0d41\u0d15",mileage_val:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15",distance_val:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d26\u0d42\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",cost_val:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d1a\u0d46\u0d32\u0d35\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15",cost_help_inof:"\u0d07\u0d28\u0d4d\u0d27\u0d28\u0d35\u0d3f\u0d32, \u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d4d, \u0d26\u0d42\u0d30\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d7d\u0d15\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d26\u0d42\u0d30\u0d02, \u0d2e\u0d48\u0d32\u0d47\u0d1c\u0d4d, \u0d1a\u0d46\u0d32\u0d35\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d02."},AboutUs:{AboutUs:"\u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d47\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d"},ContactUs:{contactUs:"\u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d38\u0d2e\u0d40\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",subject:"\u0d35\u0d3f\u0d37\u0d2f\u0d02",enter_subject:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d35\u0d3f\u0d37\u0d2f\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",enter_message:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",enter_your_subject:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d37\u0d2f\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",enter_your_message:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",message:"\u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d02",send:"\u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15"},Help:{help:"\u0d38\u0d39\u0d3e\u0d2f\u0d02",takeTour:"\u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d1f\u0d42\u0d7c \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d15"},Logout:{logout:"\u0d2a\u0d41\u0d31\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d1f\u0d15\u0d4d\u0d15\u0d41\u0d15"},Quotes:{quote_1:"\u0d28\u0d28\u0d4d\u0d28\u0d3e\u0d2f\u0d3f \u0d24\u0d2f\u0d4d\u0d2f\u0d3e\u0d31\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d7b \u0d06\u0d24\u0d4d\u0d2e\u0d35\u0d3f\u0d36\u0d4d\u0d35\u0d3e\u0d38\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d3e\u0d39\u0d38\u0d3f\u0d15\u0d28\u0d3e\u0d23\u0d4d. \u0d12\u0d30\u0d41 \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d\u200c\u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d35\u0d36\u0d4d\u0d2f\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d12\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d32\u0d41\u0d02 \u0d09\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d2f\u0d46 \u0d06\u0d36\u0d19\u0d4d\u0d15\u0d15\u0d33\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24 \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d28\u0d4d\u0d28\u0d41.",quote_2:"\u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d2f\u0d41\u0d1f\u0d46 \u0d28\u0d1f\u0d4d\u0d1f\u0d46\u0d32\u0d4d\u0d32\u0d3e\u0d23\u0d4d \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d\u200c\u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e. \u0d35\u0d32\u0d3f\u0d2f \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d1a\u0d46\u0d31\u0d3f\u0d2f \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d13\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d15\u0d7e \u0d38\u0d28\u0d4d\u0d24\u0d4b\u0d37\u0d24\u0d4d\u0d24\u0d3e\u0d7d \u0d28\u0d3f\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d35 \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d16\u0d47\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32.",quote_3:"\u0d35\u0d3f\u0d2d\u0d1c\u0d28\u0d02 \u0d35\u0d34\u0d3f \u0d2a\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d2c\u0d41\u0d26\u0d4d\u0d27\u0d3f\u0d2e\u0d41\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e \u0d12\u0d34\u0d3f\u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d17\u0d4d\u0d30\u0d42\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d32\u0d35\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d4b\u0d1c\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d23\u0d4d\u0d1f\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d38\u0d57\u0d39\u0d43\u0d26\u0d02 \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d41.",quote_4:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d24\u0d4d\u0d30 \u0d2a\u0d23\u0d02 \u0d38\u0d2e\u0d4d\u0d2a\u0d3e\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41 \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d32\u0d4d\u0d32, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d24\u0d4d\u0d30 \u0d2a\u0d23\u0d02 \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d05\u0d24\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d0e\u0d24\u0d4d\u0d30 \u0d15\u0d20\u0d3f\u0d28\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d0e\u0d24\u0d4d\u0d30 \u0d24\u0d32\u0d2e\u0d41\u0d31\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d24\u0d4d \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",quote_5:"\u0d32\u0d4b\u0d15\u0d02 \u0d12\u0d30\u0d41 \u0d2a\u0d41\u0d38\u0d4d\u0d24\u0d15\u0d2e\u0d3e\u0d23\u0d4d, \u0d2f\u0d3e\u0d24\u0d4d\u0d30 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d24\u0d4d\u0d24\u0d35\u0d7c \u0d12\u0d30\u0d41 \u0d2a\u0d47\u0d1c\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",quote_6:"\u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d15\u0d7e \u0d2e\u0d41\u0d7b\u0d35\u0d3f\u0d27\u0d3f, \u0d2e\u0d24\u0d2d\u0d4d\u0d30\u0d3e\u0d28\u0d4d\u0d24\u0d4d, \u0d07\u0d1f\u0d41\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d1a\u0d3f\u0d28\u0d4d\u0d24\u0d3e\u0d17\u0d24\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d30\u0d15\u0d2e\u0d3e\u0d23\u0d4d.",quote_7:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d23\u0d02 \u0d0e\u0d35\u0d3f\u0d1f\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d23\u0d4d \u0d2a\u0d4b\u0d2f\u0d24\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d06\u0d36\u0d4d\u0d1a\u0d30\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d2a\u0d15\u0d30\u0d02 \u0d0e\u0d35\u0d3f\u0d1f\u0d46 \u0d2a\u0d4b\u0d15\u0d23\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d2a\