d36\u0d24\u0d4d\u0d24\u0d46\u0d2f\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u0d30\u0d24\u0d40\u0d15\u0d4d\u0d37\u0d3f\u0d24 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d46\u0d2f\u0d41\u0d02 \u0d28\u0d32\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbf \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4 \u0b92\u0bb0\u0bc1 \u0bae\u0bb0\u0bbf\u0b9a\u0bcd\u0b9a\u0bc1\u0bb5\u0bb0\u0bae\u0bcd, \u0baa\u0b9f\u0b95\u0bc1 \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0ba9 \u0ba8\u0bcb\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"76.576478",lat:"9.303033"},name:"Niranam Church",name_HI:"\u0928\u093f\u0930\u093e\u0928\u092e \u091a\u0930\u094d\u091a",name_ML:"\u0d28\u0d3f\u0d30\u0d3e\u0d23\u0d02 \u0d2a\u0d33\u0d4d\u0d33\u0d3f",name_TA:"\u0ba8\u0bbf\u0bb0\u0bbe\u0ba9\u0bae\u0bcd \u0b9a\u0bb0\u0bcd\u0b9a\u0bcd",note:"One of the oldest Christian churches in Kerala, with historical and religious significance, known for its ancient architecture.",note_HI:"\u0915\u0947\u0930\u0932 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0908\u0938\u093e\u0908 \u091a\u0930\u094d\u091a\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915, \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0914\u0930 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0939\u094b\u0924\u093e \u0939\u0948, \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0935\u093e\u0938\u094d\u0924\u0d41\u0d35\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_ML:"\u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28\u0d2e\u0d3e\u0d2f \u0d15\u0d4d\u0d30\u0d3f\u0d38\u0d4d\u0d24\u0d4d\u0d2f\u0d3e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d33\u0d4d\u0d33\u0d3f\u0d15\u0d33\u0d3f\u0d32\u0d4a\u0d28\u0d4d\u0d28\u0d4d, \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d2a\u0d30\u0d2e\u0d3e\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d2e\u0d24\u0d2a\u0d30\u0d35\u0d41\u0d02 \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d35\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b95\u0bc7\u0bb0\u0bb3\u0bbe\u0bb5\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bb4\u0bc8\u0baf \u0b95\u0bbf\u0bb1\u0bbf\u0bb8\u0bcd\u0ba4\u0bb5 \u0ba4\u0bbf\u0bb0\u0bc1\u0b9a\u0bcd\u0b9a\u0baa\u0bc8\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc1, \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0ba4 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bb4\u0b95\u0bc1\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1, \u0baa\u0bb4\u0bc8\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bb5\u0ba9\u0bcd."}],Alappuzha:[{location:{long:"76.340192",lat:"9.498067"},name:"Alappuzha Backwaters",name_HI:"\u0905\u0932\u092a\u094d\u092a\u0941\u091d\u093e \u092c\u0948\u0915\u0935\u0949\u091f\u0930\u094d\u0938",name_ML:"\u0d06\u0d32\u0d2a\u0d4d\u0d2a\u0d41\u0d34 \u0d35\u0d40\u0d34\u0d41\u0d15\u0d7e",name_TA:"\u0b86\u0bb2\u0baa\u0bcd\u0baa\u0bc1\u0bb4\u0bbe \u0ba4\u0bbf\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd",note:"Famous for its intricate network of canals, backwater cruises, and houseboat stays, offering a unique glimpse into Kerala's tranquil waterways.",note_HI:"\u0928\u093e\u0932\u0947, \u0935\u0948\u0915\u0935\u0949\u091f\u0930\u094d\u0938 \u0915\u0947 \u091c\u091f\u093f\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915, \u092c\u0948\u0915\u0935\u0949\u091f\u0930 \u0915\u094d\u0930\u0942\u091c\u093c \u0914\u0930 \u0939\u093e\u0909\u0938\u092c\u094b\u091f \u0930\u0939\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948, \u091c\u094b \u0915\u0947\u0930\u0932 \u0915\u0940 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u091c\u0932\u092e\u093e\u0930\u094d\u0917\u094b\u0902 \u0915\u0940 \u090f\u0915 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u091d\u0932\u0915 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d35\u0d40\u0d34\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d1c\u0d1f\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46, \u0d35\u0d40\u0d34\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d39\u0d4c\u0d38\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d06\u0d34\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d1f\u0d2e\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d1c\u0d32\u0d2e\u0d3e\u0d30\u0d4d\u0d17\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d26\u0d4d\u0d35\u0d3f\u0d24\u0d40\u0d2f \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b85\u0bb2\u0baa\u0bcd\u0baa\u0bc1\u0bb4\u0bbe \u0ba4\u0bbf\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bc7, \u0bb5\u0bc6\u0bb3\u0bcd\u0bb3\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0bb5\u0bb4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bb2\u0bc8\u0bae\u0bc8\u0baf\u0bbe\u0ba9\u0bb5\u0bc8\u0baf\u0bbe\u0b95 \u0b89\u0bb3\u0bcd\u0bb3\u0ba9, \u0baa\u0bc7\u0b95\u0bcd\u0bb5\u0bbe\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd \u0b95\u0bbf\u0bb0\u0bc2\u0bb8\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb9\u0bb5\u0bc1\u0bb8\u0bcd\u0baa\u0bcb\u0b9f\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b95\u0bc7\u0bb0\u0bb3\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bb4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0b9a\u0bc8\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"76.337399",lat:"9.491461"},name:"Alappuzha Beach",name_HI:"\u0905\u0932\u092a\u094d\u092a\u0941\u091d\u093e \u092c\u0940\u091a",name_ML:"\u0d06\u0d32\u0d2a\u0d4d\u0d2a\u0d41\u0d34 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b86\u0bb2\u0baa\u0bcd\u0baa\u0bc1\u0bb4\u0bbe \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A beautiful beach with golden sands, palm trees, and a historic pier, ideal for leisurely walks and enjoying picturesque sunsets.",note_HI:"\u0938\u0941\u0902\u0926\u0930 \u0938\u092e\u0941\u0926\u094d\u0930\u0924\u091f \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u094b\u0928\u0947 \u0915\u0940 \u0930\u0947\u0924, \u0924\u093e\u0921\u093c \u0915\u0947 \u092a\u0947\u0921\u093c \u0914\u0930 \u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092c\u0902\u0926\u0930\u0917\u093e\u0939 \u0939\u094b\u0924\u0940 \u0939\u0948, \u091c\u094b \u0906\u0930\u093e\u092e\u092a\u0942\u0930\u094d\u0923 \u0938\u0948\u0930 \u0938\u094d\u0925\u0932 \u0914\u0930 \u091a\u093f\u0924\u094d\u0930\u0938\u0942\u0924\u094d\u0930\u0940 \u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0926\u0930\u094d\u0936 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d38\u0d4a\u0d28\u0d4d\u0d28\u0d3e\u0d2e\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d46 \u0d2e\u0d23\u0d4d\u0d23\u0d4d, \u0d2a\u0d28\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d15\u0d7e, \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d24\u0d40\u0d30\u0d2a\u0d4d\u0d2a\u0d1f \u0d05\u0d24\u0d3f\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d1f\u0d32\u0d4d\u200d\u0d24\u0d4d\u0d24\u0d40\u0d30\u0d02, \u0d06\u0d34\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d28\u0d28\u0d4d\u0d26\u0d3f\u0d2a\u0d3e\u0d32\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d3e\u0d38\u0d4d\u0d24\u0d2e\u0d2f\u0d02 \u0d06\u0d38\u0d4d\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d05\u0d28\u0d41\u0d2f\u0d4b\u0d1c\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0bae\u0b9e\u0bcd\u0b9a\u0bb3\u0bcd \u0bae\u0ba3\u0bcd\u0ba3\u0bc1\u0bae\u0bcd, \u0baa\u0ba9\u0bc8\u0bae\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0b92\u0bb0\u0bc1 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd \u0baa\u0b9f\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8, \u0b86\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9 \u0ba8\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bbe\u0ba4 \u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0bae\u0bc7\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0bbf\u0baf\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.436230",lat:"9.424695"},name:"Kuttanad",name_HI:"\u0915\u0941\u091f\u094d\u091f\u0928\u093e\u0921",name_ML:"\u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d28\u0d3e\u0d1f\u0d4d",name_TA:"\u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0bbe\u0ba8\u0bbe\u0b9f\u0bc1",note:"Known as the 'Rice Bowl of Kerala,' Kuttanad is a scenic region of backwaters and paddy fields, offering serene boat rides and rural experiences.",note_HI:"\u0915\u0947\u0930\u0932 \u0915\u0947 '\u091a\u093e\u0935\u0932 \u0915\u0940 \u0915\u091f\u094b\u0930\u0940' \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927, \u0915\u0941\u091f\u094d\u091f\u0928\u093e\u0921 \u090f\u0915 \u0930\u094b\u092e\u093e\u0902\u091a\u0915 \u0907\u0932\u093e\u0915\u093e \u0939\u0948 \u091c\u0939\u093e\u0902 \u0928\u0940\u0930\u0938 \u0928\u093e\u0935 \u092f\u093e\u0924\u094d\u0930\u093e \u0914\u0930 \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0927\u093e\u0928 \u0916\u0947\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0930\u092a\u0942\u0930 \u0935\u0948\u0915\u0935\u093e\u091f\u0930\u094d\u0938 \u0915\u0940 \u0926\u0943\u0936\u094d\u092f\u092e\u092f\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0939\u0948\u0964",note_ML:"\u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 '\u0d2a\u0d1a\u0d4d\u0d1a\u0d15\u0d4d\u0d15\u0d1f\u0d32\u0d4d\u200d' \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d, \u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d28\u0d3e\u0d1f\u0d4d \u0d12\u0d30\u0d41 \u0d06\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d3e\u0d2f \u0d35\u0d40\u0d34\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d28\u0d46\u0d32\u0d4d\u0d32\u0d4d \u0d2a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d33\u0d41\u0d02 \u0d28\u0d28\u0d4d\u0d26\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d30\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d32\u0d46 \u0d38\u0d40\u0d28\u0d3f\u0d15 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d2e\u0d3e\u0d23\u0d4d, \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d35\u0d40\u0d34\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2f\u0d3e\u0d24\u0d4d\u0d30\u0d15\u0d33\u0d41\u0d02 \u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d40\u0d23 \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"76.342630",lat:"9.579662"},name:"Pathiramanal Island",name_HI:"\u092a\u0925\u093f\u0930\u092e\u093e\u0928\u0932 \u0926\u094d\u0935\u0940\u092a",name_ML:"\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d2e\u0d23\u0d7d \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d4d",name_TA:"\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0ba3\u0bb2\u0bcd \u0ba4\u0bc0\u0bb5\u0bc1",note:"A small island in the Vembanad Lake, known for its bird sanctuary and abundant migratory bird species, attracting birdwatchers and nature enthusiasts.",note_HI:"\u0935\u0947\u0902\u092c\u0928\u093e\u0921 \u091d\u0940\u0932 \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0926\u094d\u0935\u0940\u092a \u0939\u0948, \u091c\u093f\u0938\u0947 \u092a\u0915\u094d\u0937\u093f\u092e\u093f\u0924\u094d\u0930\u093e\u0932\u092f \u0914\u0930 \u092a\u094d\u0930\u091a\u0941\u0930 \u092a\u094d\u0930\u0935\u093e\u0938\u0940 \u092a\u0915\u094d\u0937\u0940 \u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u092a\u0915\u094d\u0937\u0940 \u0926\u0930\u094d\u0936\u0915\u094b\u0902 \u0914\u0930 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u092a\u094d\u0930\u0947\u092e\u093f\u092f\u094b\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",note_ML:"\u0d35\u0d46\u0d2e\u0d4d\u0d2a\u0d28\u0d3e\u0d1f\u0d4d \u0d15\u0d1f\u0d32\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d1a\u0d46\u0d31\u0d41\u0d24\u0d41\u0d2a\u0d41\u0d34\u0d2f\u0d3e\u0d23\u0d4d \u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d2e\u0d23\u0d7d \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d4d, \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d38\u0d2e\u0d42\u0d39\u0d38\u0d4d\u0d25\u0d32\u0d02\u0d2e\u0d3e\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d35\u0d3e\u0d38\u0d3f \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d1c\u0d3e\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d, \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d34\u0d4d\u0d1a\u0d4d\u0d1a\u0d15\u0d7e \u0d2e\u0d31\u0d4d\u0d31\u0d41\u0d02 \u0d38\u0d4d\u0d35\u0d3e\u0d2d\u0d3e\u0d35\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d41\u0d02 \u0d06\u0d15\u0d30\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"76.284217",lat:"9.606590"},name:"Marari Beach",name_HI:"\u092e\u093e\u0930\u093e\u0930\u0940 \u092c\u0940\u091a",name_ML:"\u0d2e\u0d3e\u0d30\u0d3e\u0d30\u0d3f \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0bae\u0bb0\u0bbe\u0bb0\u0bbf \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A pristine beach known for its idyllic surroundings, coconut groves, and a tranquil ambiance, perfect for relaxation and sunbathing.",note_HI:"\u0905\u092a\u0928\u0947 \u0930\u092e\u0923\u0940\u092f \u092a\u0930\u093f\u0935\u0947\u0936, \u0928\u093e\u0930\u093f\u092f\u0932 \u0915\u0947 \u092a\u0947\u0921\u093c\u094b\u0902 \u0914\u0930 \u090f\u0915 \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f, \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0914\u0930 \u0927\u0942\u092a \u0938\u0947\u0902\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915\u0926\u092e \u0938\u0939\u0940 \u0939\u0948\u0964",note_ML:"\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d1a\u0d41\u0d31\u0d4d\u0d31\u0d41\u0d2a\u0d3e\u0d1f\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d24\u0d46\u0d19\u0d4d\u0d19\u0d3f\u0d7b \u0d24\u0d4b\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d05\u0d28\u0d4d\u0d24\u0d30\u0d40\u0d15\u0d4d\u0d37\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d47\u0d1f\u0d4d\u0d1f \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d3e\u0d15\u0d43\u0d24 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d, \u0d35\u0d3f\u0d36\u0d4d\u0d30\u0d2e\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d38\u0d4d\u0d28\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d05\u0d28\u0d41\u0d2f\u0d4b\u0d1c\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0ba4\u0bc6\u0ba9\u0bcd\u0ba9\u0ba8\u0bcd\u0ba4\u0bcb\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b9a\u0bc2\u0bb4\u0bcd\u0ba8\u0bbf\u0bb2\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8, \u0b93\u0baf\u0bcd\u0bb5\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0b95\u0bc1\u0bb3\u0bbf\u0baf\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"76.420006",lat:"9.405390"},name:"Ambalappuzha Sri Krishna Temple",name_HI:"\u0905\u092e\u094d\u092c\u0932\u093e\u092a\u0941\u091c\u093e \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d05\u0d2e\u0d4d\u0d2a\u0d32\u0d2a\u0d4d\u0d2a\u0d41\u0d34 \u0d36\u0d4d\u0d30\u0d40 \u0d15\u0d43\u0d37\u0d4d\u0d23 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0b85\u0bae\u0bcd\u0baa\u0bb2\u0baa\u0bcd\u0baa\u0bc1\u0bb4\u0bbe \u0bb8\u0bcd\u0bb0\u0bc0 \u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bbe \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"A revered Hindu temple known for its rich history, architectural beauty, and the famous Palpayasam (sweet milk porridge) offering.",note_HI:"\u090f\u0915 \u092a\u0935\u093f\u0924\u094d\u0930 \u0939\u093f\u0928\u094d\u0926\u0942 \u092e\u0902\u0926\u093f\u0930 \u091c\u093f\u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u092e\u0943\u0926\u094d\u0927 \u0907\u0924\u093f\u0939\u093e\u0938, \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0915\u0940 \u0938\u0941\u0902\u0926\u0930\u0924\u093e, \u0914\u0930 \u092e\u0936\u0939\u0942\u0930 \u092a\u093e\u0932\u092a\u093e\u092f\u0938\u092e (\u092e\u093f\u0920\u0947 \u0926\u0942\u0927 \u0915\u0940 \u0916\u0940\u0930) \u0915\u0940 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d05\u0d24\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d2f \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d, \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d32\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d02, \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d2a\u0d3e\u0d7d\u0d2a\u0d3e\u0d2f\u0d38\u0d02 (\u0d2a\u0d3e\u0d32\u0d02 \u0d2a\u0d34\u0d1e\u0d4d\u0d1a\u0d4b\u0d31\u0d4d) \u0d2a\u0d4d\u0d30\u0d38\u0d02\u0d17\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d42\u0d1c\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d4d \u0d05\u0d2e\u0d4d\u0d2a\u0d32\u0d2a\u0d4d\u0d2a\u0d41\u0d34 \u0d36\u0d4d\u0d30\u0d40 \u0d15\u0d43\u0d37\u0d4d\u0d23 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02.",note_TA:"\u0b85\u0bb0\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1, \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b85\u0bb4\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0baa\u0bbe\u0bb2\u0bcd\u0baa\u0bbe\u0baf\u0bbe\u0b9a\u0bae\u0bcd (\u0baa\u0bbe\u0bb2\u0bcd \u0baa\u0b9e\u0bcd\u0b9a\u0bae\u0bbf\u0bb0\u0bae\u0bcd) \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bc2\u0b9c\u0bc8\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0b87\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd \u0b86\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.337927",lat:"9.493567"},name:"Nehru Trophy Boat Race",name_HI:"\u0928\u0947\u0939\u0930\u0942 \u091f\u094d\u0930\u0949\u092b\u0940 \u092c\u094b\u091f \u0930\u0947\u0938",name_ML:"\u0d28\u0d46\u0d39\u0d4d\u0d30\u0d41 \u0d1f\u0d4d\u0d30\u0d4b\u0d2b\u0d3f \u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d31\u0d47\u0d38\u0d4d",name_TA:"\u0ba8\u0bc7\u0bb0\u0bc1 \u0b9f\u0bcd\u0bb0\u0bcb\u0baa\u0bcd\u0baa\u0bbf \u0baa\u0b9f\u0b95\u0bc1 \u0baa\u0bcb\u0b9f\u0bcd\u0b9f\u0bbf",note:"An annual boat race held on Punnamada Lake, featuring traditional snake boats, vibrant processions, and enthusiastic rowing competitions.",note_HI:"\u092a\u0941\u0928\u094d\u0928\u093e\u092e\u0926\u093e \u091d\u0940\u0932 \u092a\u0930 \u0906\u092f\u094b\u091c\u093f\u0924 \u090f\u0915 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092c\u094b\u091f \u0930\u0947\u0938, \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0938\u093e\u092a \u0928\u093e\u0935\u094b\u0902, \u091c\u0940\u0935\u0902\u0924 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0914\u0930 \u0909\u0924\u094d\u0938\u093e\u0939\u0940 \u0930\u094b\u0907\u0902\u0917 \u092a\u094d\u0930\u0924\u093f\u092f\u094b\u0917\u093f\u0924\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925\u0964",note_ML:"\u0d2a\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d2e\u0d26 \u0d15\u0d1f\u0d32\u0d3e\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d06\u0d2f\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3f\u0d28\u0d4d \u0d15\u0d48\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3e\u0d17\u0d24 \u0d2a\u0d1f\u0d15\u0d4d\u0d15\u0d41 \u0d35\u0d34\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d1c\u0d40\u0d35\u0d28\u0d4d\u0d24 \u0d2a\u0d4d\u0d30\u0d35\u0d47\u0d36\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d09\u0d24\u0d4d\u0d38\u0d3e\u0d39\u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24 \u0d31\u0d4b\u0d2f\u0d3f\u0d19\u0d4d\u0d19\u0d4d \u0d2e\u0d24\u0d4d\u0d38\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d09\u0d7e\u0d15\u0d4d\u0d15\u0d4a\u0d33\u0d4d\u0d33\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d35\u0d3e\u0d7c\u0d37\u0d3f\u0d15 \u0d2a\u0d1f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d46 \u0d12\u0d30\u0d41\u0d35\u0d7b \u0d31\u0d47\u0d38\u0d4d \u0d06\u0d23\u0d4d \u0d28\u0d46\u0d39\u0d4d\u0d30\u0d41 \u0d1f\u0d4d\u0d30\u0d4b\u0d2b\u0d3f \u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d31\u0d47\u0d38\u0d4d.",note_TA:"\u0baa\u0bc1\u0ba9\u0bcd\u0ba9\u0bae\u0b9f\u0bbe \u0b8f\u0bb0\u0bbf \u0bae\u0bc0\u0ba4\u0bc1 \u0b92\u0bb0\u0bc1 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0baa\u0b9f\u0b95\u0bc1 \u0bb5\u0bc0\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0baa\u0bbe\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0b95\u0b9f\u0bb2\u0bcd\u0ba8\u0b95\u0bb0\u0bcd, \u0bae\u0bb0\u0bae\u0bbf\u0ba9\u0bcd\u0bb1\u0bbf \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bae\u0bb5\u0bc7\u0b95 \u0baa\u0bcb\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0ba8\u0b9f\u0bc8\u0baa\u0bc6\u0bb1\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"76.350952",lat:"9.396531"},name:"Karumadi Kuttan",name_HI:"\u0915\u0930\u0941\u092e\u093e\u0921\u0940 \u0915\u0941\u091f\u094d\u091f\u0928",name_ML:"\u0d15\u0d30\u0d41\u0d2e\u0d3e\u0d1f\u0d3f \u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d7b",name_TA:"\u0b95\u0bb0\u0bc1\u0bae\u0bbe\u0b9f\u0bbf \u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd",note:"A small village known for its ancient Karumadi Kuttan statue, a black granite sculpture of Lord Buddha dating back to the 9th century.",note_HI:"\u090f\u0915 \u091b\u094b\u091f\u093e \u0917\u093e\u0902\u0935 \u091c\u093f\u0938\u0947 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u0930\u0941\u092e\u093e\u0921\u0940 \u0915\u0941\u091f\u094d\u091f\u0928 \u092e\u0942\u0930\u094d\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b 9\u0935\u0940\u0902 \u0938\u0926\u0940 \u092e\u0947\u0902 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0915\u093e\u0932 \u0924\u0915 \u0935\u093e\u092a\u0938 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",note_ML:"\u0d15\u0d30\u0d41\u0d2e\u0d3e\u0d1f\u0d3f \u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d28\u0d4d\u200d \u0d2e\u0d42\u0d30\u0d4d\u200d\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28\u0d15\u0d3e\u0d32\u0d24\u0d4d\u0d24\u0d46 \u0d2e\u0d31\u0d4d\u0d31\u0d4a\u0d30\u0d41 \u0d1a\u0d46\u0d31\u0d41\u0d2a\u0d4d\u0d2a\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d3e\u0d2f \u0d17\u0d4d\u0d30\u0d28\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d32\u0d19\u0d4d\u0d15\u0d3e\u0d30\u0d02, 9-\u0d3e\u0d02 \u0d28\u0d42\u0d31\u0d4d\u0d31\u0d3e\u0d23\u0d4d\u0d1f\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d32\u0d4d\u200d \u0d2a\u0d34\u0d2f \u0d15\u0d32\u0d3e\u0d2a\u0d1f\u0d02 \u0d06\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"9 \u0b86\u0bae\u0bcd \u0ba8\u0bc2\u0bb1\u0bcd\u0bb1\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bbe\u0bb5\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bb0\u0bc1\u0bae\u0bbe\u0b9f\u0bbf \u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0b86\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b9a\u0bbf\u0bb1\u0bbf\u0baf \u0b8a\u0bb0\u0bcd, \u0b95\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0bbf\u0bb0\u0bbe\u0ba9\u0bc8\u0b9f\u0bcd \u0b95\u0bb2\u0bc8\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0bb5\u0bb4\u0bbf\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.327845",lat:"9.500155"},name:"Punnamada Lake",name_HI:"\u092a\u0941\u0928\u094d\u0928\u093e\u092e\u0926\u093e \u091d\u0940\u0932",name_ML:"\u0d2a\u0d41\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d26 \u0d15\u0d1f\u0d32\u0d4d\u200d",name_TA:"\u0baa\u0bc1\u0ba9\u0bcd\u0ba9\u0bae\u0b9f\u0bbe \u0b8f\u0bb0\u0bbf",note:"A scenic lake known for its picturesque beauty, boat races, and the starting point of the famous Nehru Trophy Boat Race.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u0926\u0943\u0936 \u091d\u0940\u0932 \u091c\u094b \u0905\u092a\u0928\u0940 \u0916\u0942\u092c\u0938\u0942\u0930\u0924\u0940, \u0928\u094c\u0915\u093e \u0926\u094c\u0921\u093c \u0914\u0930 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0928\u0947\u0939\u0930\u0942 \u091f\u094d\u0930\u0949\u092b\u0940 \u092c\u094b\u091f \u0930\u0947\u0938 \u0915\u093e \u0906\u0930\u0902\u092d\u093f\u0915 \u092c\u093f\u0902\u0926\u0941 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",note_ML:"\u0d2a\u0d41\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d26 \u0d15\u0d1f\u0d32\u0d4d\u200d \u0d05\u0d24\u0d3f\u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d38\u0d4c\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d02, \u0d15\u0d1f\u0d32\u0d4d\u200d \u0d31\u0d47\u0d38\u0d41\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27 \u0d28\u0d47\u0d39\u0d4d\u0d30\u0d42 \u0d1f\u0d4d\u0d30\u0d4b\u0d2b\u0d3f \u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d31\u0d47\u0d38\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d30\u0d02\u0d2d\u0d02\u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27 \u0d1c\u0d40\u0d35\u0d3f\u0d24\u0d15\u0d25\u0d2f\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0ba8\u0bc6\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc7\u0bb0\u0bbf \u0b9f\u0bcd\u0bb0\u0bcb\u0baa\u0bbf \u0baa\u0b9f\u0b95\u0bc1 \u0bb5\u0bc0\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1 \u0baa\u0bbf\u0bb0\u0bb8\u0bbf\u0ba4\u0bcd\u0ba4 \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8 \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd, \u0bae\u0bbe\u0bb0\u0bcd\u0bae\u0bb4\u0bc8\u0baf\u0bbe\u0b95 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0b95\u0bc1 \u0baa\u0bcb\u0b9f\u0bcd\u0b9f\u0bbf \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba9\u0bcd\u0ba9\u0bae\u0b9f\u0bbe \u0b8f\u0bb0\u0bbf \u0b86\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.485541",lat:"9.546405"},name:"Krishnapuram Palace",name_HI:"\u0915\u0943\u0937\u094d\u0923\u093e\u092a\u0941\u0930\u092e \u092e\u0939\u0932",name_ML:"\u0d15\u0d43\u0d37\u0d4d\u0d23\u0d3e\u0d2a\u0d41\u0d30\u0d02 \u0d15\u0d4a\u0d1f\u0d4d\u0d1f\u0d3e\u0d30\u0d02",name_TA:"\u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0baa\u0bc1\u0bb0\u0bae\u0bcd \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8",note:"A historical palace known for its stunning architecture, museum, and a mural depicting the Gajendramoksha (salvation of the elephant) story.",note_HI:"\u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092e\u0939\u0932 \u091c\u094b \u0905\u092a\u0928\u0940 \u0926\u093f\u0935\u094d\u092f\u092e\u092f \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u0914\u0930 \u090f\u0915 \u0926\u0940\u0935\u093e\u0930 \u091a\u093f\u0924\u094d\u0930 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u090f \u0917\u090f \u0917\u091c\u0947\u0902\u0926\u094d\u0930\u092e\u094b\u0915\u094d\u0937 (\u0939\u093e\u0925\u0940 \u0915\u0940 \u092e\u0941\u0915\u094d\u0924\u093f) \u0915\u0925\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d17\u0d1c\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2e\u0d4b\u0d15\u0d4d\u0d37 (\u0d06\u0d28\u0d2f\u0d41\u0d1f\u0d46 \u0d30\u0d15\u0d4d\u0d37) \u0d15\u0d25 \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d2c\u0d3f\u0d02\u0d2c\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d4d\u0d2f\u0d42\u0d31\u0d7d, \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27 \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d32, \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d36\u0d3e\u0d32, \u0d24\u0d47\u0d1f\u0d3f\u0d35\u0d28\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d15\u0d43\u0d37\u0d4d\u0d23\u0d3e\u0d2a\u0d41\u0d30\u0d02 \u0d15\u0d4a\u0d1f\u0d4d\u0d1f\u0d3e\u0d30\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d40 \u0d17\u0d35\u0d47\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d46 \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16 \u0d2a\u0d4d\u0d30\u0d24\u0d40\u0d15\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b95\u0b9c\u0bc7\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcb\u0b95\u0bcd\u0bb7 (\u0baf\u0bbe\u0ba9\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8) \u0b95\u0ba4\u0bc8\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0ba4\u0bbf\u0b9a\u0bc8\u0b9a\u0bc6\u0baf\u0bb2\u0bcd \u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd, \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0bb5\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1, \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0bae\u0b9a\u0bc2\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0baa\u0bc1\u0bb0\u0bae\u0bcd \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb4\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."}],Kottayam:[{location:{long:"76.403085",lat:"9.620799"},name:"Kumarakom Bird Sanctuary",name_HI:"\u0915\u0941\u092e\u093e\u0930\u093e\u0915\u094b\u092e \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d15\u0d41\u0d2e\u0d3e\u0d30\u0d15\u0d02 \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d23\u0d02",name_TA:"\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b95\u0bcb\u0bae\u0bcd \u0baa\u0bb1\u0bb5\u0bc8 \u0b9a\u0bb0\u0ba3\u0bbe\u0bb2\u0baf\u0bae\u0bcd",note:"A renowned bird sanctuary situated on the banks of Vembanad Lake, known for its diverse avian population and scenic beauty.",note_HI:"\u0935\u0947\u092e\u094d\u092c\u0928\u093e\u0921 \u091d\u0940\u0932 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f, \u0935\u093f\u0935\u093f\u0927 \u092a\u0915\u094d\u0937\u0940 \u091c\u0928\u0938\u0902\u0916\u094d\u092f\u093e \u0914\u0930 \u091a\u093f\u0924\u094d\u0930\u0938\u0926\u0943\u0936\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d35\u0d46\u0d2e\u0d4d\u0d2a\u0d28\u0d3e\u0d1f\u0d4d \u0d15\u0d1f\u0d32\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d24\u0d40\u0d30\u0d24\u0d4d\u0d24\u0d41 \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d24 \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d23\u0d02, \u0d35\u0d3f\u0d35\u0d3f\u0d27\u0d24\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d1c\u0d28\u0d38\u0d02\u0d16\u0d4d\u0d2f\u0d2f\u0d41\u0d02 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d38\u0d26\u0d43\u0d36\u0d24\u0d2f\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0bb5\u0bc6\u0bae\u0bcd\u0baa\u0ba8\u0bbe\u0b9f\u0bcd \u0b8f\u0bb0\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0baa\u0bb1\u0bb5\u0bc8 \u0b9a\u0bb0\u0ba3\u0bbe\u0bb2\u0baf\u0bae\u0bcd, \u0bb5\u0bc7\u0bb0\u0bc1\u0bb5\u0bbe\u0baf\u0bcd \u0baa\u0bb1\u0bb5\u0bc8 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0bb4\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc6\u0bb0\u0bbf\u0baf\u0bc1\u0bae\u0bcd."},{location:{long:"76.550598",lat:"9.692547"},name:"Ettumanoor Mahadeva Temple",name_HI:"\u090f\u091f\u094d\u091f\u0941\u092e\u093e\u0928\u0942\u0930 \u092e\u0939\u093e\u0926\u0947\u0935 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d0f\u0d31\u0d4d\u0d31\u0d41\u0d2e\u0d3e\u0d28\u0d42\u0d30\u0d4d\u200d \u0d2e\u0d39\u0d3e\u0d26\u0d47\u0d35 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0b8f\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bbe\u0ba9\u0bc2\u0bb0\u0bcd \u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bb0\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"A famous Hindu temple dedicated to Lord Shiva, featuring magnificent architecture and an annual festival called 'Ettumanoor Ezharapponnana.'",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u093f\u0928\u094d\u0926\u0942 \u092e\u0902\u0926\u093f\u0930, \u091c\u093f\u0938\u092e\u0947\u0902 \u0905\u0926\u094d\u092d\u0941\u0924 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0914\u0930 '\u090f\u091f\u094d\u091f\u0941\u092e\u093e\u0928\u0942\u0930 \u090f\u091d\u0930\u093e\u092a\u094d\u092a\u094b\u0928\u094d\u0928\u093e\u0928\u093e' \u0928\u093e\u092e\u0915 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092e\u0939\u094b\u0924\u094d\u0938\u0935 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d0f\u0d31\u0d4d\u0d31\u0d41\u0d2e\u0d3e\u0d28\u0d42\u0d30\u0d4d\u200d \u0d0e\u0d34\u0d3e\u0d30\u0d2a\u0d4d\u0d2a\u0d4a\u0d28\u0d4d\u0d28\u0d28\u0d2f\u0d46\u0d28\u0d4d\u0d28\u0d41 \u0d35\u0d3f\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d3e\u0d30\u0d4d\u200d\u0d37\u0d3f\u0d15 \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d35\u0d41\u0d02 \u0d06\u0d15\u0d3e\u0d30\u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d35\u0d41\u0d02 \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2e\u0d41\u0d28\u0d4d\u0d28\u0d47\u0d31\u0d4d\u0d31\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d4d \u0d0f\u0d31\u0d4d\u0d31\u0d41\u0d2e\u0d3e\u0d28\u0d42\u0d30\u0d4d\u200d \u0d2e\u0d39\u0d3e\u0d26\u0d47\u0d35 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02.",note_TA:"\u0b8f\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bbe\u0ba9\u0bc2\u0bb0\u0bcd \u0b8e\u0bb4\u0bb0\u0baa\u0bcd\u0baa\u0bca\u0ba9\u0bcd\u0ba9\u0bbe\u0ba9 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb4\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd, \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0bae\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bb5\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd '\u0b8f\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bbe\u0ba9\u0bc2\u0bb0\u0bcd \u0b8e\u0bb4\u0bb0\u0baa\u0bcd\u0baa\u0bca\u0ba9\u0bcd\u0ba9\u0bbe\u0ba9\u0bbe' \u0b8e\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.404894",lat:"9.591380"},name:"Vembanad Lake",name_HI:"\u0935\u0947\u092e\u094d\u092c\u0928\u093e\u0921 \u091d\u0940\u0932",name_ML:"\u0d35\u0d46\u0d2e\u0d4d\u0d2a\u0d28\u0d3e\u0d1f\u0d4d \u0d15\u0d1f\u0d32\u0d4d\u200d",name_TA:"\u0bb5\u0bc6\u0bae\u0bcd\u0baa\u0ba8\u0bbe\u0b9f\u0bcd \u0b8f\u0bb0\u0bbf",note:"The largest lake in Kerala and one of the longest in India, offering mesmerizing backwater experiences and beautiful sunset views.",note_HI:"\u0915\u0947\u0930\u0932 \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u091d\u0940\u0932 \u0914\u0930 \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u0932\u0902\u092c\u0940 \u091d\u0940\u0932\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915, \u091c\u094b \u092c\u0947\u0939\u0926 \u092e\u094b\u0939\u0915 \u092c\u0948\u0915\u0935\u0949\u091f\u0930 \u0905\u0928\u0941\u092d\u0935 \u0914\u0930 \u0938\u0941\u0902\u0926\u0930 \u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u0926\u0943\u0936\u094d\u092f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",note_ML:"\u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d35\u0d32\u0d3f\u0d2f \u0d15\u0d1f\u0d32\u0d4d\u200d \u0d05\u0d2a\u0d4d\u0d2a\u0d41\u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d34\u0d4d\u0d1a\u0d15\u0d33\u0d41\u0d02 \u0d2e\u0d28\u0d4b\u0d39\u0d30 \u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d3e\u0d38\u0d4d\u0d24 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d28\u0d32\u0d4d\u200d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d26\u0d40\u0d2a\u0d4d\u0d24\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d1f\u0d32\u0d3e\u0d23\u0d4d \u0d35\u0d46\u0d2e\u0d4d\u0d2a\u0d28\u0d3e\u0d1f\u0d4d.",note_TA:"\u0b95\u0bc7\u0bb0\u0bb3\u0bbe\u0bb5\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4\u0b95\u0bb0\u0bae\u0bbe\u0ba9 \u0b8f\u0bb0\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0bc0\u0bb3\u0bae\u0bbe\u0ba9 \u0b8f\u0bb0\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0b95\u0bc1\u0bae\u0bcd, \u0bae\u0baf\u0b95\u0bcd\u0b95\u0bae\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc2\u0bb1\u0bcd\u0bb1\u0baa\u0bcd \u0baa\u0bb0\u0bbf\u0bb5\u0bbe\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0bae\u0bbe\u0bb2\u0bc8 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"76.401139",lat:"9.740974"},name:"Vaikom Mahadeva Temple",name_HI:"\u0935\u0948\u0915\u094b\u092e \u092e\u0939\u093e\u0926\u0947\u0935 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d35\u0d48\u0d15\u0d4d\u0d15\u0d02 \u0d2e\u0d39\u0d3e\u0d26\u0d47\u0d35 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bcb\u0bae\u0bcd \u0bae\u0b95\u0bbe\u0ba4\u0bc7\u0bb5\u0bb0\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"A significant Hindu temple dedicated to Lord Shiva, known for its historical significance and the grand Vaikom Ashtami festival.",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u093f\u0928\u094d\u0926\u0942 \u092e\u0902\u0926\u093f\u0930, \u091c\u093f\u0938\u0947 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092e\u0939\u0924\u094d\u0924\u094d\u0935 \u0914\u0930 \u0935\u0948\u0915\u094b\u092e \u0905\u0937\u094d\u091f\u092e\u0940 \u092e\u0939\u094b\u0924\u094d\u0938\u0935 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d3e\u0d24\u0d41\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d4b\u0d1f\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2d\u0d17\u0d35\u0d3e\u0d28\u0d41\u0d02 \u0d35\u0d48\u0d15\u0d4d\u0d15\u0d02 \u0d05\u0d37\u0d4d\u0d1f\u0d2e\u0d3f \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d4d \u0d35\u0d48\u0d15\u0d4d\u0d15\u0d02 \u0d2e\u0d39\u0d3e\u0d26\u0d47\u0d35 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02.",note_TA:"\u0b86\u0bb0\u0bcd\u0bb5\u0bae\u0bbe\u0ba9 \u0b9a\u0bbf\u0bb5 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bbe\u0b95\u0bbf\u0baf \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0b87\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd, \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd \u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bc7\u0bbe\u0bae\u0bcd \u0b85\u0bb7\u0bcd\u0b9f\u0bae\u0bbf \u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{