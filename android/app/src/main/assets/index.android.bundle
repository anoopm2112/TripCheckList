__d(function(n,e,a,t,o,i,r){o.exports={Thiruvananthapuram:[{location:{long:"76.9758050",lat:"8.3859870"},name:"Kovalam Beach",name_ML:"\u0d15\u0d4b\u0d35\u0d33\u0d02 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_HI:"\u0915\u094b\u0935\u0932\u092e \u092c\u0940\u091a",name_TA:"\u0b95\u0bcb\u0bb5\u0bb3\u0bae\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A stunning beach destination known for its golden sands, clear waters, and beachside activities.",note_ML:"\u0d38\u0d4d\u0d35\u0d30\u0d4d\u200d\u0d23\u0d4d\u0d23\u0d2e\u0d23\u0d4d\u0d1f\u0d2a\u0d02, \u0d2a\u0d4d\u0d30\u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d1c\u0d32\u0d3e\u0d2a\u0d42\u0d30\u0d4d\u200d\u0d23\u0d4d\u0d23\u0d24, \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d30\u0d3f\u0d38\u0d30\u0d3e\u0d2d\u0d3f\u0d30\u0d2e\u0d23\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d32\u0d4d\u200d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d30 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d \u0d38\u0d4d\u0d25\u0d32\u0d02.",note_TA:"\u0ba4\u0b99\u0bcd\u0b95 \u0bae\u0ba3\u0bb2\u0bcd, \u0ba4\u0bc6\u0bb3\u0bbf\u0bb5\u0bbe\u0ba9 \u0ba8\u0bc0\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0baf\u0bcb\u0bb0 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bc1",note_HI:"\u0905\u092a\u0928\u0940 \u0938\u0941\u0928\u0939\u0930\u0940 \u0930\u0947\u0924, \u0938\u093e\u092b \u092a\u093e\u0928\u0940 \u0914\u0930 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f \u0915\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u0906\u0936\u094d\u091a\u0930\u094d\u092f\u091c\u0928\u0915 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f \u0917\u0902\u0924\u0935\u094d\u092f\u0964"},{location:{long:"76.94362278221936",lat:"8.482990120809525"},name:"Padmanabhaswamy Temple",name_ML:"\u0d2a\u0d24\u0d4d\u0d2e\u0d28\u0d3e\u0d2d\u0d38\u0d4d\u0d35\u0d3e\u0d2e\u0d3f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_HI:"\u092a\u0926\u094d\u092e\u0928\u093e\u092d\u0938\u094d\u0935\u093e\u092e\u0940 \u092e\u0902\u0926\u093f\u0930",name_TA:"\u0baa\u0ba4\u0bcd\u0bae\u0ba8\u0bbe\u0baa\u0b9a\u0bc1\u0bb5\u0bbe\u0bae\u0bbf \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd",note:"A magnificent temple dedicated to Lord Vishnu, known for its intricate architecture and spiritual significance.",note_ML:" \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d37\u0d4d\u0d20\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d39\u0d3e\u0d2a\u0d41\u0d30\u0d41\u0d37\u0d28\u0d4d\u200d \u0d35\u0d3f\u0d37\u0d4d\u0d23\u0d41\u0d35\u0d3f\u0d28\u0d4d\u200d\u0d31\u0d46 \u0d26\u0d48\u0d35\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d02 \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d24\u0d41\u0d02 \u0d2e\u0d3e\u0d28\u0d38\u0d3f\u0d15 \u0d2e\u0d39\u0d24\u0d4d\u0d35\u0d35\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d33\u0d4d\u200d \u0d05\u0d24\u0d4d \u0d05\u0d26\u0d4d\u0d26\u0d47\u0d39\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41 \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d2f\u0d3e\u0d23\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d.",note_TA:"\u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0b95\u0bcd\u0b95\u0bb2\u0bc8 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b86\u0ba9\u0bcd\u0bae\u0bc0\u0b95 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0935\u093f\u0937\u094d\u0923\u0941 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092d\u0935\u094d\u092f \u092e\u0902\u0926\u093f\u0930, \u091c\u094b \u0905\u092a\u0928\u0940 \u091c\u091f\u093f\u0932 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0914\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},{location:{long:"76.95505053751367",lat:"8.509103631135641"},name:"Napier Museum",name_ML:"\u0d28\u0d47\u0d2a\u0d4d\u0d2a\u0d3f\u0d2f\u0d30\u0d4d\u200d \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d36\u0d3e\u0d32",name_HI:"\u0928\u0947\u092a\u093f\u092f\u0930 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f",name_TA:"\u0ba8\u0bc7\u0baa\u0bcd\u0baa\u0bbf\u0baf\u0bb0\u0bcd \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0b95\u0bae\u0bcd",note:"An art and natural history museum displaying a vast collection of artifacts, paintings, and sculptures.",note_ML:"\u0d38\u0d3e\u0d39\u0d3f\u0d24\u0d4d\u0d2f\u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d4d\u200d, \u0d1a\u0d32\u0d1a\u0d4d\u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d28\u0d1f\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d4d\u200d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d28\u0d47\u0d30\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d30\u0d2e\u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2