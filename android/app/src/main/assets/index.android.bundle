\u0bbe \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b89\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb4\u0bbf\u0b95\u0bb3\u0bcd, \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb2\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1.",key:'1',color:'#9dcdfa'},{type:'Tamil Nadu',type_kl:'\u0d24\u0d2e\u0d3f\u0d34\u0d4d\u0d28\u0d3e\u0d1f\u0d4d',type_hi:"\u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941",type_ta:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd\u0ba8\u0bbe\u0b9f\u0bc1",imageUri:t.default.icons.tamilnadumap_image,heading:'Land of Temples',heading_kl:'\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Tamil Nadu is known for its magnificent temples, classical dance forms, offering a vibrant blend of history, culture, and culinary delights.',description_kl:'\u0d24\u0d2e\u0d3f\u0d34\u0d4d\u0d28\u0d3e\u0d1f\u0d4d \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d15\u0d4d\u0d32\u0d3e\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d28\u0d43\u0d24\u0d4d\u0d24 \u0d30\u0d42\u0d2a\u0d19\u0d4d\u0d19\u0d7e, \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02, \u0d38\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d02, \u0d2a\u0d3e\u0d1a\u0d15 \u0d06\u0d28\u0d28\u0d4d\u0d26\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d2e\u0d3f\u0d36\u0d4d\u0d30\u0d3f\u0d24\u0d02 \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941 \u0905\u092a\u0928\u0947 \u0936\u093e\u0928\u0926\u093e\u0930 \u092e\u0902\u0926\u093f\u0930\u094b\u0902, \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0928\u0943\u0924\u094d\u092f \u0930\u0942\u092a\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0907\u0924\u093f\u0939\u093e\u0938, \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u092a\u093e\u0915 \u092a\u094d\u0930\u0938\u0928\u094d\u0928\u0924\u093e \u0915\u093e \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u092e\u093f\u0936\u094d\u0930\u0923 \u092a\u0947\u0936 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0ba4\u0bae\u0bbf\u0bb4\u0bcd\u0ba8\u0bbe\u0b9f\u0bc1 \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0ba8\u0b9f\u0ba9 \u0bb5\u0b9f\u0bbf\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1, \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bc8\u0baf\u0bb2\u0bcd \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bb2\u0bb5\u0bc8\u0baf\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'2',color:'#f7d3a4'},{type:'Karnataka',type_kl:'\u0d15\u0d7c\u0d23\u0d3e\u0d1f\u0d15\u0d02 ',type_hi:"\u0915\u0930\u094d\u0928\u093e\u091f\u0915",type_ta:"\u0b95\u0bb0\u0bcd\u0ba8\u0bbe\u0b9f\u0b95\u0bbe",imageUri:t.default.icons.karnatakamap,heading:'Garden of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d42\u0d28\u0d4d\u0d24\u0d4b\u0d1f\u0d4d\u0d1f\u0d02',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u093e \u092c\u0917\u0940\u091a\u093e',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0ba4\u0bcb\u0b9f\u0bcd\u0b9f\u0bae\u0bcd',description:'Karnataka, with its historical monuments, diverse culture, and scenic beauty, is a captivating state that showcases the grandeur of South India.',description_kl:'\u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30 \u0d38\u0d4d\u0d2e\u0d3e\u0d30\u0d15\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d35\u0d48\u0d35\u0d3f\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d7c\u0d28\u0d4d\u0d28 \u0d38\u0d02\u0d38\u0d4d\u200c\u0d15\u0d3e\u0d30\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d15\u0d7c\u0d23\u0d3e\u0d1f\u0d15, \u0d26\u0d15\u0d4d\u0d37\u0d3f\u0d23\u0d47\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d2e\u0d39\u0d24\u0d4d\u0d35\u0d02 \u0d2a\u0d4d\u0d30\u0d15\u0d1f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d06\u0d15\u0d7c\u0d37\u0d15\u0d2e\u0d3e\u0d2f \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d23\u0d4d.',description_hi:'\u0915\u0930\u094d\u0928\u093e\u091f\u0915, \u0905\u092a\u0928\u0947 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0938\u094d\u092e\u093e\u0930\u0915\u094b\u0902, \u0935\u093f\u0935\u093f\u0927 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0938\u0941\u0902\u0926\u0930\u0924\u093e \u0915\u0947 \u0938\u093e\u0925, \u090f\u0915 \u092e\u0928\u094b\u0930\u092e \u0930\u093e\u091c\u094d\u092f \u0939\u0948 \u091c\u094b \u0926\u0915\u094d\u0937\u093f\u0923 \u092d\u093e\u0930\u0924 \u0915\u0940 \u092d\u0935\u094d\u092f\u0924\u093e \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b95\u0bb0\u0bcd\u0ba8\u0bbe\u0b9f\u0b95\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc1\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bae\u0bbe\u0bb1\u0bc1\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0b85\u0bb4\u0b95\u0bc1\u0b9f\u0ba9\u0bcd, \u0ba4\u0bc6\u0ba9\u0bcd\u0ba9\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc6\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bb5\u0b9a\u0bc0\u0b95\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0ba8\u0bbf\u0bb2\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd.',key:'3',color:'#7981f5'},{type:'Andhra Pradesh',type_kl:'\u0d06\u0d7b\u0d27\u0d4d\u0d30\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d',type_hi:"\u0906\u0902\u0927\u094d\u0930 \u092a\u094d\u0930\u0926\u0947\u0936",type_ta:"\u0b86\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd",imageUri:t.default.icons.andrapradeshmap,heading:'Rice Bowl of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d31\u0d48\u0d38\u0d4d \u0d2c\u0d57\u0d7e',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u093e \u091a\u093e\u0935\u0932 \u0915\u093e \u0915\u091f\u094b\u0930\u093e',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0bbf\u0b9a\u0bbf \u0b95\u0bbf\u0ba3\u0bcd\u0ba3\u0bae\u0bcd',description:'Andhra Pradesh, known for its vibrant cultural heritage, mouthwatering cuisine, and beautiful coastline.',description_kl:'\u0d0a\u0d37\u0d4d\u0d2e\u0d33\u0d2e\u0d3e\u0d2f \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d2a\u0d48\u0d24\u0d43\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d30\u0d41\u0d1a\u0d3f\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d3e\u0d1a\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d24\u0d40\u0d30\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d47\u0d1f\u0d4d\u0d1f \u0d06\u0d28\u0d4d\u0d27\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d.',description_hi:'\u0906\u0902\u0927\u094d\u0930 \u092a\u094d\u0930\u0926\u0947\u0936, \u0905\u092a\u0928\u0940 \u091c\u0940\u0935\u0902\u0924 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0935\u093f\u0930\u093e\u0938\u0924, \u092e\u0941\u0902\u0939 \u092e\u0947\u0902 \u092a\u093e\u0928\u0940 \u0932\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0902\u091c\u0928 \u0914\u0930 \u0938\u0941\u0902\u0926\u0930 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b86\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd, \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd, \u0bb5\u0bbe\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd \u0b8a\u0bb1\u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0ba3\u0bb5\u0bc1 \u0bb5\u0b95\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1.',key:'4',color:'#f88efa'},{type:'Telangana',type_kl:'\u0d24\u0d46\u0d32\u0d19\u0d4d\u0d15\u0d3e\u0d28',type_hi:"\u0924\u0947\u0932\u0902\u0917\u093e\u0928\u093e",type_ta:"\u0ba4\u0bc6\u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bbe",imageUri:t.default.icons.telunganamap,heading:'Land of Festivals',heading_kl:'\u0d09\u0d24\u0d4d\u0d38\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0924\u094d\u092f\u094b\u0939\u093e\u0930\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bc2\u0bae\u0bbf',description:'Telangana, with its rich historical legacy, architectural wonders like the iconic Charminar, and a vibrant cultural tapestry.',description_kl:'\u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30 \u0d2a\u0d48\u0d24\u0d43\u0d15\u0d35\u0d41\u0d02, \u0d1a\u0d3e\u0d7c\u0d2e\u0d3f\u0d28\u0d3e\u0d7c \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e \u0d35\u0d3f\u0d38\u0d4d\u0d2e\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d35\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d24\u0d46\u0d32\u0d19\u0d4d\u0d15\u0d3e\u0d28.',description_hi:'\u0924\u0947\u0932\u0902\u0917\u093e\u0928\u093e, \u0905\u092a\u0928\u0940 \u0938\u092e\u0943\u0926\u094d\u0927 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0935\u093f\u0930\u093e\u0938\u0924, \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u091a\u093e\u0930\u092e\u0940\u0928\u093e\u0930 \u091c\u0948\u0938\u0947 \u0935\u093e\u0938\u094d\u0924\u0941\u0936\u093f\u0932\u094d\u092a \u091a\u092e\u0924\u094d\u0915\u093e\u0930 \u0914\u0930 \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u091f\u0947\u092a\u0947\u0938\u094d\u091f\u094d\u0930\u0940 \u0915\u0947 \u0938\u093e\u0925\u0964',description_ta:'\u0ba4\u0bc6\u0bb2\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd, \u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0bae\u0bbe\u0ba9 \u0b9a\u0bbe\u0bb0\u0bcd\u0bae\u0bbf\u0ba9\u0bbe\u0bb0\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0b95\u0bcd\u0b95\u0bb2\u0bc8 \u0b85\u0ba4\u0bbf\u0b9a\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0b9a\u0bc0\u0bb2\u0bc8\u0b95\u0bb3\u0bcd.',key:'5',color:'#f7d3a4'},{type:'Odisha',type_kl:'\u0d12\u0d21\u0d3f\u0d37  ',type_hi:"\u0913\u0921\u093f\u0936\u093e",type_ta:"\u0b92\u0b9f\u0bbf\u0b9a\u0bbe",imageUri:t.default.icons.odishamap,heading:'Soul of Incredible India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d06\u0d24\u0d4d\u0d2e\u0d3e\u0d35\u0d4d',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u0940 \u0906\u0924\u094d\u092e\u093e',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b86\u0ba9\u0bcd\u0bae\u0bbe',description:'Odisha, with its magnificent temples, vibrant tribal heritage, and pristine natural beauty.',description_kl:'\u0d12\u0d21\u0d40\u0d37, \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d0a\u0d7c\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d17\u0d4b\u0d24\u0d4d\u0d30 \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d02, \u0d2a\u0d4d\u0d30\u0d3e\u0d15\u0d43\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d02.',description_hi:'\u0913\u0921\u093f\u0936\u093e, \u0905\u092a\u0928\u0947 \u0936\u093e\u0928\u0926\u093e\u0930 \u092e\u0902\u0926\u093f\u0930\u094b\u0902, \u091c\u0940\u0935\u0902\u0924 \u0906\u0926\u093f\u0935\u093e\u0938\u0940 \u0935\u093f\u0930\u093e\u0938\u0924 \u0914\u0930 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0938\u0941\u0902\u0926\u0930\u0924\u093e \u0915\u0947 \u0938\u093e\u0925\u0964',description_ta:'\u0b92\u0b9f\u0bbf\u0b9a\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0bbf \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0b85\u0bb4\u0b95\u0bc1.',key:'6',color:'#f7d3a4'},{type:'West Bengal',type_kl:'\u0d2a\u0d36\u0d4d\u0d1a\u0d3f\u0d2e\u0d2c\u0d02\u0d17\u0d3e\u0d7e ',type_hi:"\u092a\u0936\u094d\u091a\u093f\u092e \u092c\u0902\u0917\u093e\u0932",type_ta:"\u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0b99\u0bcd\u0b95\u0bae\u0bcd",imageUri:t.default.icons.westbengalmap,heading:'Cultural Capital of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d24\u0d32\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d02',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u0940 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0930\u093e\u091c\u0927\u093e\u0928\u0940',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0ba4\u0bb2\u0bc8\u0ba8\u0b95\u0bb0\u0bae\u0bcd',description:'Its a vibrant state that pulsates with a unique blend of history, culture, and creativity.',description_kl:'\u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02, \u0d38\u0d02\u0d38\u0d4d\u200c\u0d15\u0d3e\u0d30\u0d02, \u0d38\u0d7c\u0d17\u0d4d\u0d17\u0d3e\u0d24\u0d4d\u0d2e\u0d15\u0d24 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d4d\u0d2e\u0d3f\u0d36\u0d4d\u0d30\u0d23\u0d02 \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d4d\u0d2a\u0d28\u0d4d\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d05\u0d35\u0d38\u0d4d\u0d25\u0d2f\u0d3e\u0d23\u0d3f\u0d24\u0d4d.',description_hi:'\u092f\u0939 \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u0930\u093e\u091c\u094d\u092f \u0939\u0948 \u091c\u094b \u0907\u0924\u093f\u0939\u093e\u0938, \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u0930\u091a\u0928\u093e\u0924\u094d\u092e\u0915\u0924\u093e \u0915\u0947 \u0905\u0928\u0942\u0920\u0947 \u092e\u093f\u0936\u094d\u0930\u0923 \u0938\u0947 \u0938\u094d\u092a\u0902\u0926\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1, \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bc8\u0baa\u0bcd\u0baa\u0bbe\u0bb1\u0bcd\u0bb1\u0bb2\u0bcd \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0ba4\u0ba9\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bbe\u0ba9 \u0b95\u0bb2\u0bb5\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\u0bc1\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb2\u0bc8.',key:'7',color:'#f7d3a4'},{type:'Jharkhand',type_kl:'\u0d1d\u0d3e\u0d7c\u0d16\u0d23\u0d4d\u0d21\u0d4d ',type_hi:"\u091d\u093e\u0930\u0916\u0902\u0921",type_ta:"\u0b9c\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0ba3\u0bcd\u0b9f\u0bcd",imageUri:t.default.icons.jharkhandmap,heading:'Land of Forests',heading_kl:'\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0935\u0928\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Jharkhand, blessed with breathtaking waterfalls, dense forests, rich tribal culture, and abundant mineral resources.',description_kl:'\u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e, \u0d07\u0d1f\u0d24\u0d42\u0d7c\u0d28\u0d4d\u0d28 \u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e, \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d17\u0d4b\u0d24\u0d4d\u0d30 \u0d38\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d02, \u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d27\u0d3e\u0d24\u0d41 \u0d35\u0d3f\u0d2d\u0d35\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d7d \u0d05\u0d28\u0d41\u0d17\u0d4d\u0d30\u0d39\u0d40\u0d24\u0d2e\u0d3e\u0d23\u0d4d \u0d1c\u0d3e\u0d7c\u0d16\u0d23\u0d4d\u0d21\u0d4d.',description_hi:'\u0932\u0941\u092d\u093e\u0935\u0928\u0947 \u091d\u0930\u0928\u094b\u0902, \u0918\u0928\u0947 \u091c\u0902\u0917\u0932\u094b\u0902, \u0938\u092e\u0943\u0926\u094d\u0927 \u0906\u0926\u093f\u0935\u093e\u0938\u0940 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u092a\u094d\u0930\u091a\u0941\u0930 \u0916\u0928\u093f\u091c \u0938\u0902\u0938\u093e\u0927\u0928\u094b\u0902 \u0938\u0947 \u0938\u092e\u0943\u0926\u094d\u0927 \u091d\u093e\u0930\u0916\u0902\u0921\u0964',description_ta:'\u0b9c\u0bbe\u0bb0\u0bcd\u0b95\u0ba3\u0bcd\u0b9f\u0bcd, \u0bae\u0bc2\u0b9a\u0bcd\u0b9a\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bc0\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bcd, \u0b85\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd, \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0bbf \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8f\u0bb0\u0bbe\u0bb3\u0bae\u0bbe\u0ba9 \u0b95\u0ba9\u0bbf\u0bae \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b86\u0b9a\u0bc0\u0bb0\u0bcd\u0bb5\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.',key:'8',color:'#f7d3a4'},{type:'Bihar',type_kl:'\u0d2c\u0d3f\u0d39\u0d3e\u0d7c',type_hi:"\u092c\u093f\u0939\u093e\u0930",type_ta:"\u0baa\u0bc0\u0bb9\u0bbe\u0bb0\u0bcd",imageUri:t.default.icons.biharmap,heading:'Land of Enlightenment',heading_kl:'\u0d2a\u0d4d\u0d30\u0d2c\u0d41\u0d26\u0d4d\u0d27\u0d24\u0d2f\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u091c\u094d\u091e\u093e\u0928 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b9e\u0bbe\u0ba9\u0bae\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0baa\u0bc2\u0bae\u0bbf',description:'Bihar, with its ancient historical sites like Nalanda, Bodh Gaya and vibrant cultural heritage.',description_kl:'\u0d28\u0d33\u0d28\u0d4d\u0d26, \u0d2c\u0d4b\u0d27\u0d17\u0d2f \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30 \u0d38\u0d4d\u0d25\u0d32\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d2a\u0d48\u0d24\u0d43\u0d15\u0d35\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d2c\u0d40\u0d39\u0d3e\u0d7c.',description_hi:'\u092c\u093f\u0939\u093e\u0930, \u0928\u093e\u0932\u0902\u0926\u093e, \u092c\u094b\u0927\u0917\u092f\u093e \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0938\u094d\u0925\u0932\u094b\u0902 \u0914\u0930 \u091c\u0940\u0935\u0902\u0924 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0935\u093f\u0930\u093e\u0938\u0924 \u0915\u0947 \u0938\u093e\u0925\u0964',description_ta:'\u0baa\u0bc0\u0b95\u0bbe\u0bb0\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0ba3\u0bcd\u0b9f\u0bc8\u0baf \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0ba4\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0ba9 \u0ba8\u0bbe\u0bb3\u0ba8\u0bcd\u0ba4\u0bbe, \u0baa\u0bcb\u0ba4\u0bcd\u0b95\u0baf\u0bbe \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd.',key:'9',color:'#f7d3a4'},{type:'Chhattisgarh',type_kl:'\u0d1b\u0d24\u0d4d\u0d24\u0d40\u0d38\u0d4d\u0d17\u0d22\u0d4d',type_hi:"\u091b\u0924\u094d\u0924\u0940\u0938\u0917\u0922\u093c",type_ta:"\u0b9a\u0ba4\u0bcd\u0ba4\u0bc0\u0bb8\u0bcd\u0b95\u0bb0\u0bcd",imageUri:t.default.icons.chhattisgarhmap,heading:'Rice Bowl of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d31\u0d48\u0d38\u0d4d \u0d2c\u0d57\u0d7e',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u093e \u091a\u093e\u0935\u0932 \u0915\u093e \u0915\u091f\u094b\u0930\u093e',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0bbf\u0b9a\u0bbf \u0b95\u0bbf\u0ba3\u0bcd\u0ba3\u0bae\u0bcd',description:'Chhattisgarh, with its lush forests, tribal culture, ancient cave paintings in Bastar, and a rich tapestry of folk traditions.',description_kl:'\u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e, \u0d17\u0d4b\u0d24\u0d4d\u0d30\u0d35\u0d7c\u0d17 \u0d38\u0d02\u0d38\u0d4d\u200c\u0d15\u0d3e\u0d30\u0d02, \u0d2c\u0d38\u0d4d\u0d24\u0d31\u0d3f\u0d32\u0d46 \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28 \u0d17\u0d41\u0d39\u0d3e\u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d28\u0d3e\u0d1f\u0d4b\u0d1f\u0d3f \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d2a\u0d4d\u0d2a\u0d23\u0d3f\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d1b\u0d24\u0d4d\u0d24\u0d40\u0d38\u0d4d\u0d17\u0d21\u0d4d.',description_hi:'\u091b\u0924\u094d\u0924\u0940\u0938\u0917\u0922\u093c, \u0905\u092a\u0928\u0947 \u0939\u0930\u0947-\u092d\u0930\u0947 \u091c\u0902\u0917\u0932\u094b\u0902, \u0906\u0926\u093f\u0935\u093e\u0938\u0940 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f, \u092c\u0938\u094d\u0924\u0930 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0917\u0941\u092b\u093e \u091a\u093f\u0924\u094d\u0930\u094b\u0902 \u0914\u0930 \u0932\u094b\u0915 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0915\u0947 \u0938\u092e\u0943\u0926\u094d\u0927 \u091a\u093f\u0924\u094d\u0930\u092a\u091f \u0915\u0947 \u0938\u093e\u0925\u0964',description_ta:'\u0b9a\u0ba4\u0bcd\u0ba4\u0bc0\u0bb8\u0bcd\u0b95\u0bb0\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd, \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0bbf \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd, \u0baa\u0bb8\u0bcd\u0ba4\u0bb0\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bbe\u0bb2 \u0b95\u0bc1\u0b95\u0bc8 \u0b93\u0bb5\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bb4\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0ba8\u0bbe\u0b9f\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd.',key:'10',color:'#f7d3a4'},{type:'Maharashtra',type_kl:'\u0d2e\u0d39\u0d3e\u0d30\u0d3e\u0d37\u0d4d\u0d1f\u0d4d\u0d30',type_hi:"\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930",type_ta:"\u0bae\u0bb9\u0bbe\u0bb0\u0bbe\u0bb7\u0bcd\u0b9f\u0bbf\u0bb0\u0bae\u0bcd",imageUri:t.default.icons.maharstramap,heading:'Land of Saints',heading_kl:'\u0d35\u0d3f\u0d36\u0d41\u0d26\u0d4d\u0d27\u0d30\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0938\u0902\u0924\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0baa\u0bc1\u0ba9\u0bbf\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Maharashtra, known for its bustling cosmopolitan cities, iconic landmarks like the Gateway of India, enchanting hill stations of the Western Ghats.',description_kl:'\u0d24\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d47\u0d31\u0d3f\u0d2f \u0d15\u0d4b\u0d38\u0d4d\u200c\u0d2e\u0d4b\u0d2a\u0d4a\u0d33\u0d3f\u0d31\u0d4d\u0d31\u0d7b \u0d28\u0d17\u0d30\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d47\u0d1f\u0d4d\u0d1f \u0d2e\u0d39\u0d3e\u0d30\u0d3e\u0d37\u0d4d\u0d1f\u0d4d\u0d30, \u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d35\u0d47 \u0d13\u0d2b\u0d4d \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d10\u0d15\u0d4d\u0d15\u0d23\u0d3f\u0d15\u0d4d \u0d32\u0d3e\u0d7b\u0d21\u0d4d\u200c\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e, \u0d2a\u0d36\u0d4d\u0d1a\u0d3f\u0d2e\u0d18\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d39\u0d3f\u0d7d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d47\u0d37\u0d28\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d47\u0d1f\u0d4d\u0d1f\u0d24\u0d3e\u0d23\u0d4d.',description_hi:'\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930, \u0905\u092a\u0928\u0947 \u0939\u0932\u091a\u0932 \u092d\u0930\u0947 \u092e\u0939\u093e\u0928\u0917\u0930\u0940\u092f \u0936\u0939\u0930\u094b\u0902, \u0917\u0947\u091f\u0935\u0947 \u0911\u092b \u0907\u0902\u0921\u093f\u092f\u093e \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0938\u094d\u0925\u0932\u094b\u0902, \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0918\u093e\u091f\u094b\u0902 \u0915\u0947 \u0915\u0930\u093e\u092e\u093e\u0924\u0940 \u0939\u093f\u0932 \u0938\u094d\u091f\u0947\u0936\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0bae\u0b95\u0bbe\u0bb0\u0bbe\u0bb7\u0bcd\u0b9f\u0bbf\u0bb0\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0bb0\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bbe\u0bb8\u0bcd\u0bae\u0bcb\u0baa\u0bbe\u0bb2\u0bbf\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0ba8\u0b95\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1, \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0ba8\u0bc1\u0bb4\u0bc8\u0bb5\u0bbe\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0bae\u0bbe\u0ba9 \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0baf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bb2\u0bc8\u0bb5\u0bbe\u0b9a\u0bb8\u0bcd\u0ba4\u0bb2\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',key:'11',color:'#80d1f5'},{type:'Gujarat',type_kl:'\u0d17\u0d41\u0d1c\u0d31\u0d3e\u0d24\u0d4d\u0d24\u0d4d',type_hi:"\u0917\u0941\u091c\u0930\u093e\u0924",type_ta:"\u0b95\u0bc1\u0b9c\u0bb0\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1",imageUri:t.default.icons.gujarathmap,heading:'Jewel of the West',heading_kl:'\u0d2a\u0d3e\u0d36\u0d4d\u0d1a\u0d3e\u0d24\u0d4d\u0d2f\u0d30\u0d24\u0d4d\u0d28\u0d02',heading_hi:'\u092a\u0936\u094d\u091a\u093f\u092e \u0915\u093e \u0917\u0939\u0928\u093e',heading_ta:'\u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bbf\u0ba9\u0bcd \u0ba8\u0b95\u0bc8',description:'Gujarat, with its vibrant textiles, exquisite handicrafts, diverse wildlife, and a rich tapestry of cultural traditions.',description_kl:'\u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d24\u0d41\u0d23\u0d3f\u0d24\u0d4d\u0d24\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d30\u0d15\u0d57\u0d36\u0d32\u0d35\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d7e, \u0d35\u0d48\u0d35\u0d3f\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d7c\u0d28\u0d4d\u0d28 \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f\u0d15\u0d7e, \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d1a\u0d30\u0d1f\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d17\u0d41\u0d1c\u0d31\u0d3e\u0d24\u0d4d\u0d24\u0d4d.',description_hi:'\u0917\u0941\u091c\u0930\u093e\u0924, \u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0902\u0924 \u0935\u0938\u094d\u0924\u094d\u0930\u094b\u0902, \u0909\u0924\u094d\u0924\u092e \u0939\u0938\u094d\u0924\u0936\u093f\u0932\u094d\u092a, \u0935\u093f\u0935\u093f\u0927 \u0935\u0928\u094d\u092f \u091c\u0940\u0935\u0928 \u0914\u0930 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0915\u0947 \u0938\u092e\u0943\u0926\u094d\u0927 \u091a\u093f\u0924\u094d\u0930\u092a\u091f \u0915\u0947 \u0938\u093e\u0925\u0964',description_ta:'\u0b95\u0bc1\u0b9c\u0bb0\u0bbe\u0ba4\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b9c\u0bb5\u0bc1\u0bb3\u0bbf\u0b95\u0bb3\u0bcd, \u0ba8\u0bc7\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b95\u0bc8\u0bb5\u0bbf\u0ba9\u0bc8\u0baa\u0bcd\u0baa\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bb2\u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0ba9\u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bb4\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc8\u0b9a\u0bcd\u0b9a\u0bc0\u0bb2\u0bc8\u0b95\u0bb3\u0bcd.',key:'12',color:'#f7d3a4'},{type:'Delhi',type_kl:'\u0d21\u0d7d\u0d39\u0d3f',type_hi:'\u0926\u093f\u0932\u094d\u0932\u0940',type_ta:'\u0b9f\u0bc6\u0bb2\u0bcd\u0bb2\u0bbf',imageUri:t.default.icons.delhimap,heading:'Heart of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d39\u0d43\u0d26\u0d2f\u0d02',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u093e \u0926\u093f\u0932',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b87\u0ba4\u0baf\u0bae\u0bcd',description:'Delhi, the bustling capital city of India, showcases a mix of historical landmarks, vibrant culture, and a bustling cosmopolitan atmosphere.',description_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d24\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d47\u0d31\u0d3f\u0d2f \u0d24\u0d32\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d28\u0d17\u0d30\u0d2e\u0d3e\u0d2f \u0d21\u0d7d\u0d39\u0d3f, \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d32\u0d3e\u0d7b\u0d21\u0d4d\u200c\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e, \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d38\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d02, \u0d24\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d47\u0d31\u0d3f\u0d2f \u0d15\u0d4b\u0d38\u0d4d\u0d2e\u0d4b\u0d2a\u0d4a\u0d33\u0d3f\u0d31\u0d4d\u0d31\u0d7b \u0d05\u0d28\u0d4d\u0d24\u0d30\u0d40\u0d15\u0d4d\u0d37\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d2e\u0d3f\u0d36\u0d4d\u0d30\u0d3f\u0d24\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0926\u093f\u0932\u094d\u0932\u0940, \u092d\u093e\u0930\u0924 \u0915\u0940 \u0939\u0932\u091a\u0932 \u092d\u0930\u0940 \u0930\u093e\u091c\u0927\u093e\u0928\u0940, \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0938\u094d\u0925\u0932\u094b\u0902, \u091c\u0940\u0935\u0902\u0924 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u0939\u0932\u091a\u0932 \u092d\u0930\u0947 \u092e\u0939\u093e\u0928\u0917\u0930\u0940\u092f \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u093e \u092e\u093f\u0936\u094d\u0930\u0923 \u0926\u093f\u0916\u093e\u0924\u0940 \u0939\u0948\u0964',description_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0baa\u0bb0\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0ba4\u0bb2\u0bc8\u0ba8\u0b95\u0bb0\u0bae\u0bbe\u0ba9 \u0b9f\u0bc6\u0bb2\u0bcd\u0bb2\u0bbf, \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bb0\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b95\u0bbe\u0bb8\u0bcd\u0bae\u0bcb\u0baa\u0bbe\u0bb2\u0bbf\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0b9a\u0bc2\u0bb4\u0bb2\u0bbf\u0ba9\u0bcd \u0b95\u0bb2\u0bb5\u0bc8\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'13',color:'#f7d3a4'},{type:'Uttarakhand',type_kl:'\u0d09\u0d24\u0d4d\u0d24\u0d30\u0d3e\u0d16\u0d23\u0d4d\u0d21\u0d4d',type_hi:"\u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921",type_ta:"\u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bbe\u0b95\u0ba3\u0bcd\u0b9f\u0bcd",imageUri:t.default.icons.uttarakhandmap,heading:'Land of Gods',heading_kl:'\u0d26\u0d48\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b95\u0b9f\u0bb5\u0bc1\u0bb3\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Uttarakhand, nestled in the Himalayas, offers serene landscapes, spiritual retreats, and adventure opportunities.',description_kl:'\u0d39\u0d3f\u0d2e\u0d3e\u0d32\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d09\u0d24\u0d4d\u0d24\u0d30\u0d3e\u0d16\u0d23\u0d4d\u0d21\u0d4d, \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d06\u0d24\u0d4d\u0d2e\u0d40\u0d2f \u0d35\u0d3f\u0d36\u0d4d\u0d30\u0d2e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d38\u0d3e\u0d39\u0d38\u0d3f\u0d15 \u0d05\u0d35\u0d38\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0939\u093f\u092e\u093e\u0932\u092f \u092e\u0947\u0902 \u092c\u0938\u093e \u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921, \u0936\u093e\u0902\u0924 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f, \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0930\u093f\u091f\u094d\u0930\u0940\u091f \u0914\u0930 \u0938\u093e\u0939\u0938\u093f\u0915 \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b87\u0bae\u0baf\u0bae\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bcd, \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb2\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b86\u0ba9\u0bcd\u0bae\u0bc0\u0b95 \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bbe\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bbe\u0b95\u0b9a \u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'14',color:'#f7d3a4'},{type:'Meghalaya',type_kl:'\u0d2e\u0d46\u0d18\u0d3e\u0d32\u0d2f',type_hi:"\u092e\u0947\u0918\u093e\u0932\u092f",type_ta:"\u0bae\u0bc7\u0b95\u0bbe\u0bb2\u0baf\u0bbe",imageUri:t.default.icons.meghalayamap,heading:'Abode of Clouds',heading_kl:'\u0d2e\u0d47\u0d18\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3e\u0d38\u0d38\u0d4d\u0d25\u0d32\u0d02',heading_hi:'\u092c\u093e\u0926\u0932\u094b\u0902 \u0915\u093e \u0928\u093f\u0935\u093e\u0938',heading_ta:'\u0bae\u0bc7\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0bb1\u0bc8\u0bb5\u0bbf\u0b9f\u0bae\u0bcd',description:'Meghalaya, with its breathtaking landscapes, cascading waterfalls, living root bridges, and captivating blend of natural beauty.',description_kl:'\u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e, \u0d1c\u0d40\u0d35\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d31\u0d42\u0d1f\u0d4d\u0d1f\u0d4d \u0d2c\u0d4d\u0d30\u0d3f\u0d21\u0d4d\u0d1c\u0d41\u0d15\u0d7e, \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d15\u0d7c\u0d37\u0d15\u0d2e\u0d3e\u0d2f \u0d2e\u0d3f\u0d36\u0d4d\u0d30\u0d3f\u0d24\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d47\u0d18\u0d3e\u0d32\u0d2f.',description_hi:'\u092e\u0947\u0918\u093e\u0932\u092f, \u0905\u092a\u0928\u0947 \u0932\u0941\u092d\u093e\u0935\u0928\u0947 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f\u094b\u0902, \u091d\u0930\u0924\u0947 \u091d\u0930\u0928\u094b\u0902, \u091c\u0940\u0935\u093f\u0924 \u092e\u0942\u0932 \u092a\u0941\u0932\u094b\u0902 \u0914\u0930 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0938\u0941\u0902\u0926\u0930\u0924\u093e \u0915\u0947 \u092e\u0928\u094b\u0930\u092e \u092e\u093f\u0936\u094d\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925\u0964',description_ta:'\u0bae\u0bc7\u0b95\u0bbe\u0bb2\u0baf\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0b9a\u0bcd\u0b9a\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bcd, \u0b85\u0bb0\u0bc1\u0bb5\u0bbf\u0b95\u0bb3\u0bcd \u0b85\u0bb0\u0bc1\u0bb5\u0bbf\u0b95\u0bb3\u0bcd, \u0bb5\u0bbe\u0bb4\u0bc1\u0bae\u0bcd \u0bb0\u0bc2\u0b9f\u0bcd \u0baa\u0bbe\u0bb2\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0b85\u0bb4\u0b95\u0bc1 \u0bb5\u0b9a\u0bc0\u0b95\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0bc8.',key:'15',color:'#f7d3a4'},{type:'Haryana',type_kl:'\u0d39\u0d30\u0d3f\u0d2f\u0d3e\u0d23',type_hi:"\u0939\u0930\u093f\u092f\u093e\u0923\u093e",type_ta:"\u0bb9\u0bb0\u0bbf\u0baf\u0bbe\u0ba9\u0bbe",imageUri:t.default.icons.haryanamap,heading:'Land of Rotis and Wrestlers',heading_kl:'\u0d31\u0d4a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d17\u0d41\u0d38\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0930\u094b\u091f\u093f\u092f\u094b\u0902 \u0914\u0930 \u092a\u0939\u0932\u0935\u093e\u0928\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0bb0\u0bca\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bb2\u0bcd\u0baf\u0bc1\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc0\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Haryana, celebrates its agricultural prowess, and a strong emphasis on sports, particularly wrestling.',description_kl:'\u0d39\u0d30\u0d3f\u0d2f\u0d3e\u0d28, \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d3e\u0d7c\u0d37\u0d3f\u0d15 \u0d35\u0d48\u0d26\u0d17\u0d4d\u0d27\u0d4d\u0d2f\u0d02 \u0d06\u0d18\u0d4b\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d15\u0d3e\u0d2f\u0d3f\u0d15\u0d30\u0d02\u0d17\u0d24\u0d4d\u0d24\u0d4d, \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d17\u0d41\u0d38\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d36\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d0a\u0d28\u0d4d\u0d28\u0d7d \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0939\u0930\u093f\u092f\u093e\u0923\u093e, \u0905\u092a\u0928\u0947 \u0915\u0943\u0937\u093f \u0915\u094c\u0936\u0932 \u0915\u093e \u091c\u0936\u094d\u0928 \u092e\u0928\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 \u0916\u0947\u0932, \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0915\u0941\u0936\u094d\u0924\u0940 \u092a\u0930 \u091c\u094b\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0bb9\u0bb0\u0bbf\u0baf\u0bbe\u0ba9\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0bb5\u0bbf\u0bb5\u0b9a\u0bbe\u0baf\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba9\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbe\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1, \u0bae\u0bc7\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb3\u0bc8\u0baf\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0b95 \u0bae\u0bb2\u0bcd\u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0ba4\u0bbf\u0b95 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'16',color:'#f7d3a4'},{type:'Uttar Pradesh',type_kl:'\u0d09\u0d24\u0d4d\u0d24\u0d7c\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d',type_hi:"\u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936",type_ta:"\u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd",imageUri:t.default.icons.uttarpradesh,heading:'Heartland of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d39\u0d43\u0d26\u0d2f\u0d2d\u0d42\u0d2e\u0d3f',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u0940 \u0939\u0943\u0926\u092f\u092d\u0942\u092e\u093f',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b87\u0ba4\u0baf\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf',description:'Uttar Pradesh, home to the iconic Taj Mahal, showcases a rich historical legacy, sacred pilgrimage sites.',description_kl:'\u0d10\u0d24\u0d3f\u0d39\u0d3e\u0d38\u0d3f\u0d15\u0d2e\u0d3e\u0d2f \u0d24\u0d3e\u0d1c\u0d4d\u0d2e\u0d39\u0d32\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d2f \u0d09\u0d24\u0d4d\u0d24\u0d7c\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d, \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30 \u0d2a\u0d48\u0d24\u0d43\u0d15\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d23\u0d4d\u0d2f \u0d24\u0d40\u0d7c\u0d24\u0d4d\u0d25\u0d3e\u0d1f\u0d28 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0924\u093e\u091c\u092e\u0939\u0932 \u0915\u093e \u0918\u0930, \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u090f\u0915 \u0938\u092e\u0943\u0926\u094d\u0927 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0935\u093f\u0930\u093e\u0938\u0924, \u092a\u0935\u093f\u0924\u094d\u0930 \u0924\u0940\u0930\u094d\u0925 \u0938\u094d\u0925\u0932\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0bae\u0bbe\u0ba9 \u0ba4\u0bbe\u0b9c\u0bcd\u0bae\u0bb9\u0bbe\u0bb2\u0bbf\u0ba9\u0bcd \u0ba4\u0bbe\u0baf\u0b95\u0bae\u0bbe\u0ba9 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd, \u0b92\u0bb0\u0bc1 \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd, \u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc8 \u0ba4\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'17',color:'#f7d3a4'},{type:'Arunachal Pradesh',type_kl:'\u0d05\u0d30\u0d41\u0d23\u0d3e\u0d1a\u0d7d\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d',type_hi:"\u0905\u0930\u0941\u0923\u093e\u091a\u0932 \u092a\u094d\u0930\u0926\u0947\u0936",type_ta:"\u0b85\u0bb0\u0bc1\u0ba3\u0bbe\u0b9a\u0bcd\u0b9a\u0bb2\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd",imageUri:t.default.icons.arunachalpradeshmap,heading:'Land of the Rising Sun',heading_kl:'\u0d09\u0d26\u0d2f\u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d28\u0d4d\u0d31\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0909\u0917\u0924\u0947 \u0938\u0942\u0930\u091c \u0915\u0947 \u0926\u0947\u0936',heading_ta:'\u0b89\u0ba4\u0baf \u0b9a\u0bc2\u0bb0\u0bbf\u0baf\u0ba9\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Arunachal Pradesh, Mesmerizes with its pristine beauty, snow-capped mountains.',description_kl:'\u0d05\u0d30\u0d41\u0d23\u0d3e\u0d1a\u0d7d \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d, \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d2e\u0d1e\u0d4d\u0d1e\u0d41\u0d2e\u0d42\u0d1f\u0d3f\u0d2f \u0d2a\u0d7c\u0d35\u0d24\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d2e\u0d28\u0d02\u0d2e\u0d2f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0905\u0930\u0941\u0923\u093e\u091a\u0932 \u092a\u094d\u0930\u0926\u0947\u0936, \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0938\u0941\u0902\u0926\u0930\u0924\u093e, \u092c\u0930\u094d\u092b \u0938\u0947 \u0922\u0915\u0947 \u092a\u0939\u093e\u0921\u093c\u094b\u0902 \u0938\u0947 \u092e\u0902\u0924\u094d\u0930\u092e\u0941\u0917\u094d\u0927 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b85\u0bb0\u0bc1\u0ba3\u0bbe\u0b9a\u0bcd\u0b9a\u0bb2 \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b85\u0bb4\u0b95\u0bc1\u0b9f\u0ba9\u0bcd, \u0baa\u0ba9\u0bbf \u0bae\u0bc2\u0b9f\u0bbf\u0baf \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0bae\u0baf\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'18',color:'#f7d3a4'},{type:'Punjab',type_kl:"\u0d2a\u0d1e\u0d4d\u0d1a\u0d3e\u0d2c\u0d4d",type_hi:"\u092a\u0902\u091c\u093e\u092c",type_ta:"\u0baa\u0b9e\u0bcd\u0b9a\u0bbe\u0baa\u0bcd",imageUri:t.default.icons.punjabmap,heading:'Land of Five Rivers',heading_kl:'\u0d05\u0d1e\u0d4d\u0d1a\u0d4d \u0d28\u0d26\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u092a\u093e\u0902\u091a \u0928\u0926\u093f\u092f\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b90\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0ba8\u0bbe\u0b9f\u0bc1',description:'Punjab, captivates with its Sikh heritage, agricultural prosperity, and zestful Bhangra dance and music.',description_kl:'\u0d2a\u0d1e\u0d4d\u0d1a\u0d3e\u0d2c\u0d4d, \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d3f\u0d16\u0d4d \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d02, \u0d15\u0d3e\u0d7c\u0d37\u0d3f\u0d15 \u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d3f, \u0d09\u0d24\u0d4d\u0d38\u0d3e\u0d39\u0d2d\u0d30\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d2d\u0d3e\u0d02\u0d17\u0d4d\u0d30 \u0d28\u0d43\u0d24\u0d4d\u0d24\u0d35\u0d41\u0d02 \u0d38\u0d02\u0d17\u0d40\u0d24\u0d35\u0d41\u0d02 \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d06\u0d15\u0d7c\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u092a\u0902\u091c\u093e\u092c, \u0905\u092a\u0928\u0940 \u0938\u093f\u0916 \u0935\u093f\u0930\u093e\u0938\u0924, \u0915\u0943\u0937\u093f \u0938\u092e\u0943\u0926\u094d\u0927\u093f \u0914\u0930 \u0909\u0924\u094d\u0938\u093e\u0939\u092a\u0942\u0930\u094d\u0923 \u092d\u093e\u0902\u0917\u0921\u093c\u093e \u0928\u0943\u0924\u094d\u092f \u0914\u0930 \u0938\u0902\u0917\u0940\u0924 \u0915\u0947 \u0938\u093e\u0925 \u092e\u0902\u0924\u094d\u0930\u092e\u0941\u0917\u094d\u0927 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0baa\u0b9e\u0bcd\u0b9a\u0bbe\u0baa\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0b9a\u0bc0\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd, \u0bb5\u0bbf\u0bb5\u0b9a\u0bbe\u0baf \u0b9a\u0bc6\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b86\u0bb0\u0bcd\u0bb5\u0bae\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bbe\u0b99\u0bcd\u0b95\u0bcd\u0bb0\u0bbe \u0ba8\u0b9f\u0ba9\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0b9a\u0bc8 \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bbe\u0bb2\u0bcd \u0b95\u0bb5\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bbf\u0bb4\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'19',color:'#f7d3a4'},{type:'Assam',type_kl:'\u0d06\u0d38\u0d4d\u0d38\u0d3e\u0d02',type_hi:"\u0905\u0938\u092e",type_ta:"\u0b85\u0b9a\u0bbe\u0bae\u0bcd",imageUri:t.default.icons.assammap,heading:'Land of Tea and Rhinos',heading_kl:'\u0d24\u0d47\u0d2f\u0d3f\u0d32\u0d2f\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d15\u0d3e\u0d23\u0d4d\u0d1f\u0d3e\u0d2e\u0d43\u0d17\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u091a\u093e\u092f \u0914\u0930 \u0917\u0948\u0902\u0921\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0ba4\u0bc7\u0baf\u0bbf\u0bb2\u0bc8 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbe\u0bae\u0bbf\u0bb0\u0bc1\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Assam, Enthralls with its tea gardens, wildlife sanctuaries.',description_kl:'\u0d24\u0d47\u0d2f\u0d3f\u0d32\u0d24\u0d4d\u0d24\u0d4b\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e, \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f \u0d38\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d7d \u0d06\u0d15\u0d7c\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d05\u0d38\u0d02.',description_hi:'\u0905\u0938\u092e, \u0905\u092a\u0928\u0947 \u091a\u093e\u092f \u092c\u093e\u0917\u093e\u0928\u094b\u0902, \u0935\u0928\u094d\u092f\u091c\u0940\u0935 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0930\u094b\u092e\u093e\u0902\u091a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b85\u0bb8\u0bcd\u0bb8\u0bbe\u0bae\u0bcd, \u0ba4\u0bc7\u0baf\u0bbf\u0bb2\u0bc8 \u0ba4\u0bcb\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bb5\u0ba9\u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bc1 \u0b9a\u0bb0\u0ba3\u0bbe\u0bb2\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b95\u0bb5\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bbf\u0bb4\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'20',color:'#f7d3a4'},{type:'Tripura',type_kl:'\u0d24\u0d4d\u0d30\u0d3f\u0d2a\u0d41\u0d30',type_hi:"\u0924\u094d\u0930\u093f\u092a\u0941\u0930\u093e",type_ta:"\u0ba4\u0bbf\u0bb0\u0bbf\u0baa\u0bc1\u0bb0\u0bbe",imageUri:t.default.icons.tripuramap,heading:'Land of Two Queens',heading_kl:'\u0d30\u0d23\u0d4d\u0d1f\u0d4d \u0d30\u0d3e\u0d1c\u0d4d\u0d1e\u0d3f\u0d2e\u0d3e\u0d30\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0926\u094b \u0930\u093e\u0928\u093f\u092f\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb0\u0bbe\u0ba3\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Tripura, showcases magnificent palaces and ancient temples.',description_kl:'\u0d24\u0d4d\u0d30\u0d3f\u0d2a\u0d41\u0d30, \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d4a\u0d1f\u0d4d\u0d1f\u0d3e\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0924\u094d\u0930\u093f\u092a\u0941\u0930\u093e, \u0936\u093e\u0928\u0926\u093e\u0930 \u092e\u0939\u0932\u094b\u0902 \u0914\u0930 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0ba4\u0bbf\u0bb0\u0bbf\u0baa\u0bc1\u0bb0\u0bbe, \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bb4\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'21',color:'#f7d3a4'},{type:'Nagaland',type_kl:'\u0d28\u0d3e\u0d17\u0d3e\u0d32\u0d3e\u0d28\u0d4d\u0d31\u0d4d',type_hi:"\u0928\u093e\u0917\u093e\u0932\u0948\u0902\u0921",type_ta:"\u0ba8\u0bbe\u0b95\u0bb2\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1",imageUri:t.default.icons.nagalandmap,heading:'Land of Festivals',heading_kl:'\u0d09\u0d24\u0d4d\u0d38\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0924\u094d\u092f\u094b\u0939\u093e\u0930\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bc2\u0bae\u0bbf',description:"Nagaland, offers a glimpse into the indigenous Naga tribes' traditions, vibrant music, intricate handicrafts, and a deep sense of community.",description_kl:'\u0d28\u0d3e\u0d17\u0d3e\u0d32\u0d3e\u0d7b\u0d21\u0d4d, \u0d24\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d40\u0d2f \u0d28\u0d3e\u0d17\u0d3e \u0d17\u0d4b\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d38\u0d02\u0d17\u0d40\u0d24\u0d02, \u0d38\u0d19\u0d4d\u0d15\u0d40\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d3e\u0d2f \u0d15\u0d30\u0d15\u0d57\u0d36\u0d32 \u0d35\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d7e, \u0d06\u0d34\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d2e\u0d42\u0d39\u0d2c\u0d4b\u0d27\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d28\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d34\u0d4d\u0d1a \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0928\u093e\u0917\u093e\u0932\u0948\u0902\u0921, \u0938\u094d\u0935\u0926\u0947\u0936\u0940 \u0928\u093e\u0917\u093e \u091c\u0928\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902, \u091c\u0940\u0935\u0902\u0924 \u0938\u0902\u0917\u0940\u0924, \u091c\u091f\u093f\u0932 \u0939\u0938\u094d\u0924\u0936\u093f\u0932\u094d\u092a \u0914\u0930 \u0938\u092e\u0941\u0926\u093e\u092f \u0915\u0940 \u0917\u0939\u0930\u0940 \u0938\u092e\u091d \u0915\u0940 \u091d\u0932\u0915 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0ba8\u0bbe\u0b95\u0bbe\u0bb2\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1, \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0bbf \u0ba8\u0bbe\u0b95\u0bbe \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bbf\u0ba9\u0bb0\u0bbf\u0ba9\u0bcd \u0bae\u0bb0\u0baa\u0bc1\u0b95\u0bb3\u0bcd, \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b87\u0b9a\u0bc8, \u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0ba9 \u0b95\u0bc8\u0bb5\u0bbf\u0ba9\u0bc8\u0baa\u0bcd\u0baa\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bc2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b86\u0bb4\u0bae\u0bbe\u0ba9 \u0b89\u0ba3\u0bb0\u0bcd\u0bb5\u0bc1 \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b92\u0bb0\u0bc1 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'22',color:'#f7d3a4'},{type:'Manipur',type_kl:'\u0d2e\u0d23\u0d3f\u0d2a\u0d4d\u0d2a\u0d42\u0d7c',type_hi:"\u092e\u0923\u093f\u092a\u0941\u0930",type_ta:"\u0bae\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd",imageUri:t.default.icons.manipurmap,heading:'Land of Jewels',heading_kl:'\u0d06\u0d2d\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0930\u0924\u094d\u0928\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0ba8\u0b95\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Manipur, boasts breathtaking landscapes, rich cultural traditions, and a history steeped in martial arts and folk dances.',description_kl:'\u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d2d\u0d42\u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d06\u0d2f\u0d4b\u0d27\u0d28\u0d15\u0d32\u0d15\u0d33\u0d3f\u0d32\u0d41\u0d02 \u0d28\u0d3e\u0d1f\u0d4b\u0d1f\u0d3f \u0d28\u0d43\u0d24\u0d4d\u0d24\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d41\u0d02 \u0d28\u0d3f\u0d31\u0d1e\u0d4d\u0d1e\u0d41\u0d28\u0d3f\u0d7d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d35\u0d41\u0d02 \u0d2e\u0d23\u0d3f\u0d2a\u0d4d\u0d2a\u0d42\u0d30\u0d3f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d4d.',description_hi:'\u092e\u0923\u093f\u092a\u0941\u0930, \u0932\u0941\u092d\u093e\u0935\u0928\u0947 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f, \u0938\u092e\u0943\u0926\u094d\u0927 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0914\u0930 \u092e\u093e\u0930\u094d\u0936\u0932 \u0906\u0930\u094d\u091f \u0914\u0930 \u0932\u094b\u0915 \u0928\u0943\u0924\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0921\u0942\u092c\u093e \u0939\u0941\u0906 \u0907\u0924\u093f\u0939\u093e\u0938 \u0938\u092e\u0947\u091f\u0947 \u0939\u0941\u090f \u0939\u0948\u0964',description_ta:'\u0bae\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd, \u0bae\u0bc2\u0b9a\u0bcd\u0b9a\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bcd, \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0bae\u0bb0\u0baa\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0bb2\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1 \u0ba8\u0b9f\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bae\u0bc2\u0bb4\u0bcd\u0b95\u0bbf\u0baf \u0b92\u0bb0\u0bc1 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.',key:'23',color:'#f7d3a4'},{type:'Rajasthan',type_kl:'\u0d30\u0d3e\u0d1c\u0d38\u0d4d\u0d25\u0d3e\u0d7b',type_hi:"\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928",type_ta:"\u0bb0\u0bbe\u0b9c\u0bb8\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd",imageUri:t.default.icons.rajasthanmap,heading:'Land of Kings',heading_kl:'\u0d30\u0d3e\u0d1c\u0d3e\u0d15\u0d4d\u0d15\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0930\u093e\u091c\u093e\u0913\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0bae\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Rajasthan, dazzles with its majestic forts, opulent palaces, vibrant festivals, and a rich tapestry of Rajputana heritage.',description_kl:'\u0d30\u0d3e\u0d1c\u0d38\u0d4d\u0d25\u0d3e\u0d7b, \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d15\u0d7e, \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d15\u0d4a\u0d1f\u0d4d\u0d1f\u0d3e\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d19\u0d4d\u0d19\u0d7e, \u0d30\u0d1c\u0d4d\u0d2a\u0d41\u0d24\u0d28 \u0d2a\u0d48\u0d24\u0d43\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d1f\u0d47\u0d2a\u0d4d\u0d2a\u0d4d\u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d7d \u0d35\u0d3f\u0d38\u0d4d\u0d2e\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928, \u0905\u092a\u0928\u0947 \u0930\u093e\u091c\u0938\u0940 \u0915\u093f\u0932\u094b\u0902, \u092d\u0935\u094d\u092f \u092e\u0939\u0932\u094b\u0902, \u091c\u0940\u0935\u0902\u0924 \u0924\u094d\u092f\u094b\u0939\u093e\u0930\u094b\u0902 \u0914\u0930 \u0930\u093e\u091c\u092a\u0941\u0924\u093e\u0928\u093e \u0935\u093f\u0930\u093e\u0938\u0924 \u0915\u0940 \u090f\u0915 \u0938\u092e\u0943\u0926\u094d\u0927 \u091a\u093f\u0924\u094d\u0930\u092a\u091f \u0915\u0947 \u0938\u093e\u0925 \u091a\u0915\u093e\u091a\u094c\u0902\u0927 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0bb0\u0bbe\u0b9c\u0bb8\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0b95\u0bae\u0bcd\u0baa\u0bc0\u0bb0\u0bae\u0bbe\u0ba9 \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bb3\u0bcd, \u0b9a\u0bc6\u0bb4\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8\u0b95\u0bb3\u0bcd, \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb0\u0bbe\u0b9c\u0baa\u0bc1\u0ba4\u0ba9 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bb4\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc8\u0b9a\u0bcd\u0b9a\u0bc0\u0bb2\u0bc8\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u0b95\u0bc8\u0b95\u0bcd\u0b95 \u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'24',color:'#f7d3a4'},{type:'Himachal Pradesh',type_kl:'\u0d39\u0d3f\u0d2e\u0d3e\u0d1a\u0d7d\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d',type_hi:"\u0939\u093f\u092e\u093e\u091a\u0932 \u092a\u094d\u0930\u0926\u0947\u0936",type_ta:"\u0bb9\u0bbf\u0bae\u0bbe\u0b9a\u0bb2\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd",imageUri:t.default.icons.himachalpradeshmap,heading:'Land of Gods',heading_kl:'\u0d26\u0d48\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0b95\u0b9f\u0bb5\u0bc1\u0bb3\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Himachal Pradesh is "Land of Gods" because abundance of sacred Hindu temples, spiritual centers.',description_kl:'\u0d39\u0d3f\u0d2e\u0d3e\u0d1a\u0d7d \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d "\u0d26\u0d48\u0d35\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d", \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d35\u0d3f\u0d36\u0d41\u0d26\u0d4d\u0d27 \u0d39\u0d48\u0d28\u0d4d\u0d26\u0d35 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d06\u0d24\u0d4d\u0d2e\u0d40\u0d2f \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d27\u0d3e\u0d30\u0d3e\u0d33\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d4d.',description_hi:'\u0939\u093f\u092e\u093e\u091a\u0932 \u092a\u094d\u0930\u0926\u0947\u0936 "\u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f" \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092a\u0935\u093f\u0924\u094d\u0930 \u0939\u093f\u0902\u0926\u0942 \u092e\u0902\u0926\u093f\u0930\u094b\u0902, \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u0940 \u092c\u0939\u0941\u0924\u093e\u092f\u0924 \u0939\u0948\u0964',description_ta:'\u0bb9\u0bbf\u0bae\u0bbe\u0b9a\u0bcd\u0b9a\u0bb2\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd "\u0b95\u0b9f\u0bb5\u0bc1\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0bc7\u0b9a\u0bae\u0bcd", \u0b8f\u0ba9\u0bc6\u0ba9\u0bbf\u0bb2\u0bcd \u0baa\u0bc1\u0ba9\u0bbf\u0ba4\u0bae\u0bbe\u0ba9 \u0b87\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0b86\u0ba9\u0bcd\u0bae\u0bc0\u0b95 \u0bae\u0bc8\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8f\u0bb0\u0bbe\u0bb3\u0bae\u0bbe\u0b95 \u0b89\u0bb3\u0bcd\u0bb3\u0ba9.',key:'25',color:'#f7d3a4'},{type:'Goa',type_kl:"\u0d17\u0d4b\u0d35",type_hi:"\u0917\u094b\u0935\u093e",type_ta:"\u0b95\u0bcb\u0bb5\u0bbe",imageUri:t.default.icons.goa_map,heading:'Rome of the East',heading_kl:'\u0d15\u0d3f\u0d34\u0d15\u0d4d\u0d15\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d31\u0d4b\u0d02',heading_hi:'\u092a\u0942\u0930\u094d\u0935 \u0915\u093e \u0930\u094b\u092e',heading_ta:'\u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd \u0bb0\u0bcb\u0bae\u0bcd',description:'Goa, with its golden sandy beaches, delicious cuisine, and vibrant nightlife, offers a perfect blend of relaxation.',description_kl:'\u0d17\u0d4b\u0d35, \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d41\u0d35\u0d7c\u0d23\u0d4d\u0d23 \u0d2e\u0d23\u0d7d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d41\u0d15\u0d7e, \u0d38\u0d4d\u0d35\u0d3e\u0d26\u0d3f\u0d37\u0d4d\u0d1f\u0d2e\u0d3e\u0d2f \u0d2a\u0d3e\u0d1a\u0d15\u0d30\u0d40\u0d24\u0d3f, \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d28\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d32\u0d48\u0d2b\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d35\u0d3f\u0d36\u0d4d\u0d30\u0d2e\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d2e\u0d4d\u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23 \u0d38\u0d02\u0d2f\u0d4b\u0d1c\u0d28\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0917\u094b\u0935\u093e, \u0905\u092a\u0928\u0947 \u0938\u0941\u0928\u0939\u0930\u0947 \u0930\u0947\u0924\u0940\u0932\u0947 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f\u094b\u0902, \u0938\u094d\u0935\u093e\u0926\u093f\u0937\u094d\u091f \u0935\u094d\u092f\u0902\u091c\u0928\u094b\u0902 \u0914\u0930 \u091c\u0940\u0935\u0902\u0924 \u0928\u093e\u0907\u091f\u0932\u093e\u0907\u092b\u093c \u0915\u0947 \u0938\u093e\u0925 \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0915\u093e \u090f\u0915 \u0906\u0926\u0930\u094d\u0936 \u092e\u093f\u0936\u094d\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b95\u0bcb\u0bb5\u0bbe, \u0b85\u0ba4\u0ba9\u0bcd \u0ba4\u0b99\u0bcd\u0b95 \u0bae\u0ba3\u0bb2\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0b95\u0bb3\u0bcd, \u0b9a\u0bc1\u0bb5\u0bc8\u0baf\u0bbe\u0ba9 \u0b89\u0ba3\u0bb5\u0bc1 \u0bb5\u0b95\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b87\u0bb0\u0bb5\u0bc1 \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8 \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bc8 \u0b93\u0baf\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0bb0\u0bbf\u0baf\u0bbe\u0ba9 \u0b95\u0bb2\u0bb5\u0bc8\u0baf\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'26',color:'#e59595'},{type:'Sikkim',type_kl:"\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d02",type_hi:"\u0938\u093f\u0915\u094d\u0915\u093f\u092e",type_ta:"\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bae\u0bcd",imageUri:t.default.icons.sikkim_map,heading:'Land of Mystical Monasteries',heading_kl:'\u0d2e\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d2e\u0d4a\u0d23\u0d3e\u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u0930\u0939\u0938\u094d\u092f\u092e\u092f \u092e\u0920\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0bae\u0bbe\u0baf \u0bae\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:'Sikkim, nestled in the lap of the Himalayas, mesmerizes with its snow-capped peaks, vibrant Buddhist monasteries.',description_kl:'\u0d39\u0d3f\u0d2e\u0d3e\u0d32\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2e\u0d1f\u0d3f\u0d24\u0d4d\u0d24\u0d1f\u0d4d\u0d1f\u0d3f\u0d7d \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d02, \u0d2e\u0d1e\u0d4d\u0d1e\u0d41\u0d2e\u0d42\u0d1f\u0d3f\u0d2f \u0d15\u0d4a\u0d1f\u0d41\u0d2e\u0d41\u0d1f\u0d3f\u0d15\u0d7e, \u0d0a\u0d7c\u0d1c\u0d4d\u0d1c\u0d38\u0d4d\u0d35\u0d32\u0d2e\u0d3e\u0d2f \u0d2c\u0d41\u0d26\u0d4d\u0d27\u0d35\u0d3f\u0d39\u0d3e\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d7d \u0d2e\u0d2f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',description_hi:'\u0939\u093f\u092e\u093e\u0932\u092f \u0915\u0940 \u0917\u094b\u0926 \u092e\u0947\u0902 \u092c\u0938\u093e \u0938\u093f\u0915\u094d\u0915\u093f\u092e \u0905\u092a\u0928\u0940 \u092c\u0930\u094d\u092b \u0938\u0947 \u0922\u0915\u0940 \u091a\u094b\u091f\u093f\u092f\u094b\u0902, \u091c\u0940\u0935\u0902\u0924 \u092c\u094c\u0926\u094d\u0927 \u092e\u0920\u094b\u0902 \u0938\u0947 \u092e\u0902\u0924\u094d\u0930\u092e\u0941\u0917\u094d\u0927 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964',description_ta:'\u0b87\u0bae\u0baf\u0bae\u0bb2\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0b9f\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bae\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0ba9\u0bbf \u0bae\u0bc2\u0b9f\u0bbf\u0baf \u0b9a\u0bbf\u0b95\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0ba4\u0bc1\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0baa\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0b9f\u0bbe\u0bb2\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0bae\u0bc6\u0baf\u0bcd\u0b9a\u0bbf\u0bb2\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.',key:'27',color:'#aeaeae'},{type:'Mizoram',type_kl:"\u0d2e\u0d3f\u0d38\u0d4b\u0d31\u0d02",type_hi:"\u092e\u093f\u091c\u093c\u094b\u0930\u092e",type_ta:"\u0bae\u0bbf\u0b9a\u0bcb\u0bb0\u0bae\u0bcd",imageUri:t.default.icons.mizoram_map,heading:'Land of the Hill People',heading_kl:'\u0d2e\u0d32\u0d2f\u0d4b\u0d30 \u0d1c\u0d28\u0d24\u0d2f\u0d41\u0d1f\u0d46 \u0d28\u0d3e\u0d1f\u0d4d',heading_hi:'\u092a\u0939\u093e\u0921\u093c\u0940 \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u092d\u0942\u092e\u093f',heading_ta:'\u0bae\u0bb2\u0bc8\u0bb5\u0bbe\u0bb4\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0bae\u0bcd',description:"Mizoram, with its lush greenery, cascading waterfalls, rich tribal culture, and warm hospitality.",description_kl:'\u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d2a\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d4d, \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e, \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d17\u0d4b\u0d24\u0d4d\u0d30 \u0d38\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d02, \u0d0a\u0d37\u0d4d\u0d2e\u0d33\u0d2e\u0d3e\u0d2f \u0d06\u0d24\u0d3f\u0d25\u0d4d\u0d2f\u0d2e\u0d30\u0d4d\u0d2f\u0d3e\u0d26 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d3f\u0d38\u0d4b\u0d31\u0d3e\u0d02',description_hi:'\u092e\u093f\u091c\u093c\u094b\u0930\u092e, \u0905\u092a\u0928\u0940 \u0939\u0930\u0940-\u092d\u0930\u0940 \u0939\u0930\u093f\u092f\u093e\u0932\u0940, \u091d\u0930\u0924\u0947 \u091d\u0930\u0928\u094b\u0902, \u0938\u092e\u0943\u0926\u094d\u0927 \u091c\u0928\u091c\u093e\u0924\u0940\u092f \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u0917\u0930\u094d\u092e \u0906\u0924\u093f\u0925\u094d\u092f \u0915\u0947 \u0938\u093e\u0925',description_ta:'\u0bae\u0bbf\u0b9a\u0bcb\u0bb0\u0bae\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0baa\u0b9a\u0bc1\u0bae\u0bc8, \u0b85\u0bb0\u0bc1\u0bb5\u0bbf\u0b95\u0bb3\u0bcd, \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0bbf \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bcd\u0baa\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bcb\u0bae\u0bcd\u0baa\u0bb2\u0bcd',key:'28',color:'#88fffb'},{type:'Madhya Pradesh',type_kl:'\u0d2e\u0d27\u0d4d\u0d2f\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d4d',type_hi:'\u092e\u0927\u094d\u092f \u092a\u094d\u0930\u0926\u0947\u0936',type_ta:'\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd',imageUri:t.default.icons.madyapradeshmap,heading:'Heart of India',heading_kl:'\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d39\u0d43\u0d26\u0d2f\u0d02',heading_hi:'\u092d\u093e\u0930\u0924 \u0915\u093e \u0926\u093f\u0932',heading_ta:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b87\u0ba4\u0baf\u0bae\u0bcd',description:"Madhya Pradesh, with its magnificent UNESCO World Heritage Sites like Khajuraho and Sanchi, rich wildlife in national parks.",description_kl:'\u0d16\u0d1c\u0d41\u0d30\u0d3e\u0d39\u0d4b, \u0d38\u0d3e\u0d1e\u0d4d\u0d1a\u0d3f \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d2f\u0d41\u0d28\u0d46\u0d38\u0d4d\u200c\u0d15\u0d4b\u0d2f\u0d41\u0d1f\u0d46 \u0d32\u0d4b\u0d15 \u0d2a\u0d48\u0d24\u0d43\u0d15 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d27\u0d4d\u0d2f\u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d3f\u0d32\u0d46 \u0d26\u0d47\u0d36\u0d40\u0d2f \u0d09\u0d26\u0d4d\u0d2f\u0d3e\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d38\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d2e\u0d3e\u0d2f \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f\u0d15\u0d33\u0d41\u0d23\u0d4d\u0d1f\u0d4d.',description_hi:'\u0905\u092a\u0928\u0947 \u0936\u093e\u0928\u0926\u093e\u0930 \u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0935\u093f\u0936\u094d\u0935 \u0927\u0930\u094b\u0939\u0930 \u0938\u094d\u0925\u0932\u094b\u0902 \u091c\u0948\u0938\u0947 \u0916\u091c\u0941\u0930\u093e\u0939\u094b \u0914\u0930 \u0938\u093e\u0902\u091a\u0940 \u0915\u0947 \u0938\u093e\u0925, \u092e\u0927\u094d\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \u092e\u0947\u0902 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0909\u0926\u094d\u092f\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u092e\u0943\u0926\u094d\u0927 \u0935\u0928\u094d\u092f \u091c\u0940\u0935\u0928 \u0939\u0948\u0964',description_ta:'\u0b95\u0b9c\u0bc1\u0bb0\u0bbe\u0bb9\u0bcb \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bbe\u0b9e\u0bcd\u0b9a\u0bbf \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0baf\u0bc1\u0ba9\u0bc6\u0bb8\u0bcd\u0b95\u0bcb \u0b89\u0bb2\u0b95 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0ba4\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd, \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bcd \u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bb5\u0bb3\u0bae\u0bbe\u0ba9 \u0bb5\u0ba9\u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.',key:'29',color:'#f7d3a4'},{type:'Jammu And Kashmir',type_kl:'\u0d1c\u0d2e\u0d4d\u0d2e\u0d41 \u0d15\u0d36\u0d4d\u0d2e\u0d40\u0d7c',type_hi:'\u091c\u092e\u094d\u092e\u0942 \u0914\u0930 \u0915\u0936\u094d\u092e\u0940\u0930',type_ta:'\u0b9c\u0bae\u0bcd\u0bae\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bb7\u0bcd\u0bae\u0bc0\u0bb0\u0bcd',imageUri:t.default.icons.jkmap,heading:'Paradise on Earth',heading_kl:'\u0d2d\u0d42\u0d2e\u0d3f\u0d2f\u0d3f\u0d32\u0d46 \u0d2a\u0d31\u0d41\u0d26\u0d40\u0d38',heading_hi:'\u092a\u0943\u0925\u094d\u0935\u0940 \u092a\u0930 \u0938\u094d\u0935\u0930\u094d\u0917',heading_ta:'\u0baa\u0bc2\u0bae\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bca\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bae\u0bcd',description:'Jammu and Kashmir, Enthralls with its breathtaking valleys, pristine lakes, snow-capped mountains.',description_kl:'\u0d1c\u0d2e\u0d4d\u0d2e\u0d41 \u0d15\u0d3e\u0d36\u0d4d\u0d2e\u0d40\u0d7c, \u0d05\u0d24\u0d3f\u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d24\u0d3e\u0d34\u0d4d\u200c\u0d35\u0d30\u0d15\u0d7e, \u0d2a\u0d4d\u0d30\u0d3e\u0d15\u0