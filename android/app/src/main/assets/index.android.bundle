0d35\u0d3f\u0d36\u0d4d\u0d35\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2d\u0d15\u0d4d\u0d24\u0d30\u0d46 \u0d06\u0d15\u0d30\u0d4d\u200d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"9\u0b86\u0bae\u0bcd \u0ba8\u0bc2\u0bb1\u0bcd\u0bb1\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bb5\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0baa\u0bb4\u0bc8\u0baf \u0b86\u0b9f\u0bc8\u0baa\u0bcd \u0baa\u0bc7\u0bb0\u0bbe\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd, \u0b95\u0b9f\u0bb5\u0bc1\u0bb3\u0bcd \u0bb5\u0bb4\u0bbf\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0bb2 \u0bae\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0baa\u0b95\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bc8 \u0b86\u0b95\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bb0\u0bbf\u0baf\u0bbe\u0bae\u0bcd\u0bae\u0bbe \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd."},{location:{long:"76.521717",lat:"9.595951"},name:"Kottayam Market",name_HI:"\u0915\u094b\u091f\u094d\u091f\u093e\u092f\u092e \u092c\u093e\u091c\u093e\u0930",name_ML:"\u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d2f\u0d02 \u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",name_TA:"\u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0baf\u0bae\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8",note:"A bustling market known for its vibrant atmosphere, fresh produce, spices, and local handicrafts, offering an authentic shopping experience.",note_HI:"\u090f\u0915 \u0917\u0941\u0902\u091c\u093e\u092f\u093e\u092e\u093e\u0928 \u092c\u093e\u091c\u093e\u0930 \u091c\u0939\u093e\u0902 \u091c\u0940\u0935\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923, \u0924\u093e\u091c\u0917\u0940 \u0909\u0924\u094d\u092a\u093e\u0926, \u092e\u0938\u093e\u0932\u0947 \u0914\u0930 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0939\u0938\u094d\u0924\u0936\u093f\u0932\u094d\u092a \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948, \u090f\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d02, \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d2a\u0d34\u0d19\u0d4d\u0d19\u0d7e, \u0d2e\u0d38\u0d3e\u0d32\u0d15\u0d7e, \u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15 \u0d39\u0d38\u0d4d\u0d24\u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4d\u0d30\u0d15\u0d1f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d05\u0d24\u0d3f\u0d25\u0d40\u0d28\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d15\u0d32\u0d3e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d06\u0d23\u0d4d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d2f\u0d02 \u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d.",note_TA:"\u0b89\u0baf\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbe\u0ba9\u0bbf\u0bb2\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b85\u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0ba4 \u0bb5\u0bbe\u0ba3\u0bbf\u0b95\u0bae\u0bcd, \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0baa\u0bb4\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bae\u0b9a\u0bbe\u0bb2\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b95\u0bc8\u0bb5\u0bbf\u0ba9\u0bc8\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1 \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0bb3\u0bae\u0bcd\u0baa\u0bb0\u0bae\u0bbe\u0ba9 \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0baf\u0bae\u0bcd \u0bae\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc6\u0b9f\u0bcd."},{location:{long:"77.287229",lat:"9.752431"},name:"Illikkal Kallu",name_HI:"\u0907\u0932\u094d\u0932\u093f\u0915\u0932 \u0915\u0932\u094d\u0932\u0942",name_ML:"\u0d07\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d15\u0d32\u0d4d\u0d32\u0d4d",name_TA:"\u0b87\u0bb3\u0bcd\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0b95\u0bb2\u0bcd\u0bb2\u0bc1",note:"A scenic hill station known for its towering peaks and breathtaking views, ideal for trekking and adventurous activities.",note_HI:"\u0907\u0932\u094d\u0932\u093f\u0915\u0932 \u0915\u0932\u094d\u0932\u0942, \u090a\u0901\u091a\u0947 \u092a\u0930\u094d\u0935\u0924 \u0936\u093f\u0916\u0930\u094b\u0902 \u0914\u0930 \u092e\u0928\u092e\u094b\u0939\u0915 \u0928\u091c\u093e\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u090f\u0915 \u0926\u0930\u094d\u0936\u0928\u0940\u092f \u092a\u0939\u093e\u0921\u093c\u0940 \u0938\u094d\u091f\u0947\u0936\u0928 \u0939\u0948, \u091c\u094b \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0914\u0930 \u0938\u093e\u0939\u0938\u093f\u0915 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0926\u0930\u094d\u0936 \u0939\u0948\u0964",note_ML:"\u0d15\u0d4a\u0d1f\u0d41\u0d2e\u0d41\u0d1f\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d06\u0d15\u0d3e\u0d36\u0d2d\u0d47\u0d26\u0d2e\u0d3e\u0d2f \u0d28\u0d3f\u0d32\u0d35\u0d3e\u0d30\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d39\u0d3f\u0d32\u0d4d\u0d32\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d47\u0d37\u0d7b, \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d3e\u0d39\u0d38\u0d3f\u0d15 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d26\u0d7c\u0d36\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0b89\u0baf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0bae\u0bb0\u0baa\u0bc1 \u0ba8\u0bbf\u0bb2\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b9f\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0bb2\u0bb5\u0bc1\u0ba8\u0bbf\u0bb2\u0bc8 \u0bae\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0bb3\u0bcd\u0bb3\u0bbf, \u0b9a\u0bc6\u0bbe\u0bb0\u0bcd\u0bb5\u0bc7\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bbe\u0bb9\u0b9a\u0bae\u0bbe\u0ba9 \u0b9a\u0bc6\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1 \u0b9a\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.522881",lat:"9.587163"},name:"Thirunakkara Mahadeva Temple",name_HI:"\u0924\u093f\u0930\u0941\u0928\u093e\u0915\u094d\u0915\u093e\u0930\u093e \u092e\u0939\u093e\u0926\u0947\u0935 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d24\u0d3f\u0d30\u0d41\u0d28\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d30 \u0d2e\u0d39\u0d3e\u0d26\u0d47\u0d35 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bbe\u0bb0\u0bbe \u0bae\u0bb9\u0bbe\u0ba4\u0bc7\u0bb5\u0bb0\u0bcd \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd",note:"An ancient temple dedicated to Lord Shiva, known for its exquisite architecture, murals, and the annual festival called 'Arattu.'",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092e\u0902\u0926\u093f\u0930, \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u0926\u0940\u0935\u093e\u0930 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930\u0940 \u0914\u0930 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0924\u094d\u092f\u094b\u0939\u093e\u0930 '\u0906\u0930\u0924\u094d\u0924\u0941' \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d2d\u0d17\u0d35\u0d3e\u0d28\u0d4d\u200d \u0d36\u0d3f\u0d35\u0d28\u0d46 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d2e\u0d3e\u0d2f \u0d06\u0d7c\u0d15\u0d4d\u0d15\u0d3f\u0d1f\u0d47\u0d15\u0d4d\u0d1a\u0d30\u0d41\u0d02, \u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d46 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d15\u0d32\u0d2f\u0d41\u0d02, '\u0d06\u0d30\u0d3e\u0d1f\u0d4d\u0d1f\u0d4d' \u0d0e\u0d28\u0d4d\u0d28 \u0d35\u0d3e\u0d7c\u0d37\u0d3f\u0d15 \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b85\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb4\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0b9a\u0bbf\u0bb5\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0ba3\u0bcd\u0b9f\u0bc8\u0baf \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0bb5\u0bbe\u0bb8\u0bcd\u0ba4\u0bc1\u0b9a\u0bc6\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b9a\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0baa\u0bca\u0ba4\u0bc1\u0bb5\u0bbe\u0ba9 \u0bb5\u0ba3\u0bcd\u0ba3\u0bae\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0bb5\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3\u0ba9."},{location:{long:"76.323684",lat:"9.680110"},name:"Bay Island Driftwood Museum",name_HI:"\u092c\u0947 \u0906\u0907\u0932\u0948\u0902\u0921 \u0921\u094d\u0930\u093f\u092b\u094d\u091f\u0935\u0941\u0921 \u092e\u094d\u092f\u0942\u091c\u093f\u092f\u092e",name_ML:"\u0d2c\u0d47 \u0d10\u0d32\u0d28\u0d4d\u0d31\u0d4d \u0d21\u0d4d\u0d30\u0d3f\u0d2b\u0d4d\u0d31\u0d4d\u0d31\u0d4d\u0d35\u0d41\u0d21\u0d4d \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02",name_TA:"\u0baa\u0bc7 \u0ba4\u0bc0\u0bb5\u0bc1 \u0baa\u0bb4\u0bc8\u0baf\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bb0\u0bc8 \u0ba8\u0bc2\u0bb2\u0b95\u0bae\u0bcd",note:"A unique museum showcasing an extensive collection of intricately shaped driftwood sculptures, capturing the artistic finesse of nature.",note_HI:"\u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u092e\u094d\u092f\u0942\u091c\u093f\u092f\u092e \u091c\u094b \u091c\u091f\u093f\u0932 \u0906\u0915\u093e\u0930 \u0935\u093e\u0932\u0947 \u0921\u094d\u0930\u093f\u092b\u094d\u091f\u0935\u0941\u0921 \u0938\u094d\u0915\u0932\u094d\u092a\u091a\u0930 \u0915\u093e \u0935\u094d\u092f\u093e\u092a\u0915 \u0938\u0902\u0917\u094d\u0930\u0939 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u094b \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0915\u0940 \u0915\u0932\u093e\u0924\u094d\u092e\u0915\u0924\u093e \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u092c\u093f\u0902\u092c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d28\u0d3e\u0d28\u0d3e\u0d15\u0d3e\u0d30\u0d02 \u0d06\u0d15\u0d43\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d21\u0d4d\u0d30\u0d3f\u0d2b\u0d4d\u0d31\u0d4d\u0d31\u0d4d\u0d35\u0d41\u0d21\u0d4d \u0d05\u0d2e\u0d42\u0d32\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d15\u0d1f\u0d4d\u0d1f\u0d41\u0d30\u0d48 \u0d2a\u0d4d\u0d30\u0d26\u0d30\u0d4d\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d05\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02, \u0d38\u0d4d\u0d35\u0d2d\u0d3e\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d32\u0d3e\u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d46 \u0d2a\u0d1f\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d2e\u0d40\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0bae\u0bc0\u0ba9\u0bcd\u0baa\u0bbe\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc7\u0bb1\u0bc1\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0bae\u0bc2\u0bb2\u0bcd\u0baf\u0bae\u0bbe\u0ba9 \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0bb2\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bb0\u0bc8\u0b95\u0bb3\u0bc8 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0 \u0ba8\u0bc2\u0bb2\u0b95\u0bae\u0bcd, \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b95\u0bb2\u0bc8\u0baf\u0bc8 \u0b95\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0baf\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"77.034448",lat:"9.715023"},name:"Kottathavalam",name_HI:"\u0915\u094b\u091f\u094d\u091f\u093e\u0925\u093e\u0935\u0932\u092e",name_ML:"\u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d35\u0d33\u0d02",name_TA:"\u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb5\u0bb3\u0bae\u0bcd",note:"A serene and picturesque spot nestled amidst lush greenery, offering a peaceful retreat and panoramic views of the surroundings.",note_HI:"\u0939\u0930\u093f\u092f\u093e\u0932\u0940 \u0938\u0947 \u0918\u093f\u0930\u0947 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0914\u0930 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0935\u0930\u0942\u092a\u0940 \u0938\u094d\u0925\u093e\u0928, \u091c\u094b \u0906\u092a\u0915\u094b \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0906\u0936\u094d\u0930\u092f \u0914\u0930 \u092a\u0930\u093f\u0935\u0947\u0936 \u0915\u0947 \u092a\u0948\u0928\u094b\u0930\u093e\u092e\u093f\u0915 \u0926\u0943\u0936\u094d\u092f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d39\u0d30\u0d3f\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3f\u0d2f\u0d3f\u0d7d \u0d05\u0d1f\u0d15\u0d4d\u0d15\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d38\u0d4d\u0d35\u0d30\u0d42\u0d2a\u0d3f\u0d2f\u0d3e\u0d2f \u0d38\u0d4d\u0d25\u0d32\u0d02, \u0d28\u0d3f\u0d30\u0d28\u0d4d\u0d24\u0d30\u0d2e\u0d3e\u0d2f \u0d2e\u0d28\u0d03\u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d3e\u0d28\u0d4b\u0d30\u0d3e\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d2f \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0bb3\u0bcd\u0bb3\u0bbf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bb3\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0bb2\u0bc8\u0bb5\u0bbe\u0bb4\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0b92\u0bb0\u0bc1 \u0bae\u0bb2\u0bb0\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bb5\u0bc1\u0bae\u0bc1\u0bb1\u0bc8 \u0baa\u0bc1\u0bb2\u0bae\u0bcd, \u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bb3\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0bae\u0bc0\u0b9f\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."}],Idukki:[{location:{long:"77.062957",lat:"10.088933"},name:"Munnar",name_HI:"\u092e\u0941\u0928\u094d\u0928\u093e\u0930",name_ML:"\u0d2e\u0d42\u0d28\u0d4d\u0d28\u0d3e\u0d7c",name_TA:"\u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bbe\u0bb0\u0bcd",note:"A popular hill station known for its tea plantations, scenic landscapes, and pleasant weather, offering opportunities for trekking and wildlife spotting.",note_HI:"\u091a\u093e\u092f \u092c\u0917\u0940\u091a\u094b\u0902, \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0935\u0930\u0942\u092a\u0940 \u0926\u0943\u0936\u094d\u092f \u0914\u0930 \u0938\u0941\u0939\u093e\u0935\u0928\u093e \u092e\u094c\u0938\u092e \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u090f\u0915 \u092a\u0939\u093e\u0921\u093c\u0940 \u0938\u094d\u0925\u093e\u0928, \u091c\u0939\u093e\u0902 \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0914\u0930 \u0935\u0928\u094d\u092f\u091c\u0940\u0935 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0935\u0938\u0930 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964",note_ML:"\u0d1a\u0d3e\u0d2f\u0d3e\u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d3e\u0d15\u0d3e\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d28\u0d3f\u0d34\u0d32\u0d35\u0d3e\u0d34\u0d15\u0d33\u0d41\u0d02, \u0d06\u0d30\u0d3e\u0d2e\u0d26\u0d3e\u0d2f\u0d15\u0d2e\u0d3e\u0d2f \u0d15\u0d3e\u0d32\u0d3e\u0d35\u0d38\u0d4d\u0d25\u0d2f\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d24 \u0d2e\u0d46\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e \u0d2a\u0d4d\u0d30\u0d35\u0d43\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d7e, \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d19\u0d4d\u0d19\u0d41\u0d02 \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f \u0d38\u0d4d\u0d2a\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d19\u0d4d\u0d19\u0d41\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0ba4\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b9f\u0bbf\u0bb0\u0bc6\u0b95\u0bcd\u0b95\u0bbf\u0b99\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0ba9\u0baa\u0bcd\u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bbe\u0bb0\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0bb2\u0bc8 \u0ba8\u0b95\u0bb0\u0bae\u0bcd."},{location:{long:"77.170636",lat:"9.601357"},name:"Thekkady",name_HI:"\u0925\u0947\u0915\u094d\u0915\u0921\u0940",name_ML:"\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d1f\u0d3f",name_TA:"\u0ba4\u0bc6\u0b95\u0bcd\u0b95\u0b9f\u0bbf",note:"Home to the Periyar National Park, known for its wildlife sanctuary, boat cruises, elephant rides, and a chance to witness herds of wild elephants.",note_HI:"\u092a\u0947\u0930\u093f\u092f\u093e\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0909\u0926\u094d\u092f\u093e\u0928 \u0915\u093e \u0918\u0930, \u091c\u093e\u0928\u0935\u0930\u094b\u0902 \u0915\u0947 \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0938\u094d\u0925\u0932, \u0928\u093e\u0935 \u092f\u093e\u0924\u094d\u0930\u093e\u090f\u0902, \u0939\u093e\u0925\u0940 \u0938\u0935\u093e\u0930\u0940, \u0914\u0930 \u091c\u0902\u0917\u0932\u0940 \u0939\u093e\u0925\u093f\u092f\u094b\u0902 \u0915\u0947 \u091d\u0941\u0902\u0921\u094b\u0902 \u0915\u093e \u0926\u0943\u0936\u094d\u092f \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u0905\u0935\u0938\u0930\u0964",note_ML:"\u0d2a\u0d46\u0d30\u0d3f\u0d2f\u0d3e\u0d7c \u0d26\u0d47\u0d36\u0d40\u0d2f\u0d4b\u0d26\u0d4d\u0d2f\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d40\u0d1f\u0d4d, \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f\u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d23\u0d02, \u0d15\u0d1f\u0d32\u0d3e\u0d38\u0d28\u0d4d\u0d28\u0d35\u0d47\u0d26\u0d28, \u0d06\u0d28\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d35\u0d3e\u0d30\u0d3f, \u0d35\u0d28\u0d4d\u0d2f\u0d2e\u0d43\u0d17\u0d36\u0d3e\u0d32\u0d2f\u0d41\u0d02 \u0d28\u0d4b\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d05\u0d35\u0d38\u0d30\u0d02.",note_TA:"\u0baa\u0bc6\u0bb0\u0bbf\u0baf\u0bbe\u0bb0\u0bcd \u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd, \u0baa\u0b9f\u0b95\u0bc1 \u0baa\u0baf\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd, \u0baf\u0bbe\u0ba9\u0bc8 \u0baa\u0baf\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd, \u0bb5\u0ba9\u0baa\u0bcd\u0baa\u0bc2\u0b9a\u0bcd\u0b9a\u0bbf \u0bae\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbe\u0ba3\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0baf\u0bb3\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"77.189220",lat:"9.849206"},name:"Idukki Dam",name_HI:"\u0907\u0921\u0941\u0915\u094d\u0915\u0940 \u092c\u093e\u0902\u0927",name_ML:"\u0d07\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3f \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d4d",name_TA:"\u0b87\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbf \u0b85\u0ba3\u0bc8",note:"One of the largest arch dams in Asia, offering stunning views of the reservoir, surrounding hills, and serving as a major source of hydroelectric power.",note_HI:"\u090f\u0936\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0947 \u0906\u0930\u094d\u091a \u0921\u0948\u092e \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915, \u091c\u094b \u091c\u0932\u093e\u0936\u092f, \u0906\u0938\u092a\u093e\u0938 \u0915\u0940 \u092a\u0939\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0936\u093e\u0928\u0926\u093e\u0930 \u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0914\u0930 \u091c\u0932\u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0936\u0915\u094d\u0924\u093f \u0915\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0938\u094d\u0930\u094b\u0924 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d0f\u0d37\u0d4d\u0d2f\u0d2f\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d35\u0d32\u0d3f\u0d2f \u0d06\u0d7c\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d4a\u0d28\u0d4d\u0d28\u0d4d, \u0d1c\u0d32\u0d3e\u0d36\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46, \u0d1a\u0d41\u0d31\u0d4d\u0d31\u0d41\u0d2a\u0d41\u0d31\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d32\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2e\u0d1e\u0d4d\u0d1e\u0d41\u0d2a\u0d42\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2e\u0d3f\u0d15\u0d1a\u0d4d\u0d1a \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d39\u0d48\u0d21\u0d4d\u0d30\u0d4b\u0d07\u0d32\u0d15\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d2a\u0d35\u0d7c\u0d28\u0d3f\u0d32 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d2e\u0d42\u0d32\u0d02 \u0d2a\u0d4d\u0d30\u0d38\u0d02\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b8f\u0b9a\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0bae\u0bbf\u0b95\u0baa\u0bcd\u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0b95\u0bb2\u0bcd \u0b85\u0ba3\u0bc8\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc1, \u0b9a\u0bc1\u0bb0\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0b95\u0bb2\u0bcd, \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc2\u0b9a\u0bcd\u0b9a\u0bbf \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc8\u0baf\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bbe\u0ba9 \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0bae\u0bbf\u0ba9\u0bcd \u0b86\u0bb1\u0bcd\u0bb1\u0bb2\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0bae\u0bc2\u0bb2\u0bae\u0bbe\u0b95 \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"77.280951",lat:"9.692692"},name:"Ramakkalmedu",name_HI:"\u0930\u093e\u092e\u0915\u094d\u0915\u0932\u092e\u0947\u0921\u0941",name_ML:"\u0d30\u0d3e\u0d2e\u0d15\u0d4d\u0d15\u0d7d\u0d2e\u0d47\u0d1f\u0d4d",name_TA:"\u0bb0\u0bbe\u0bae\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0bae\u0bc7\u0b9f\u0bc1",note:"A scenic hill station with vast stretches of wind-swept grasslands, offering panoramic views of the Western Ghats and picturesque sunrises.",note_HI:"\u090f\u0915 \u0930\u094b\u092e\u093e\u0902\u091a\u0915 \u092a\u0939\u093e\u0921\u093c\u0940 \u0938\u094d\u091f\u0947\u0936\u0928 \u091c\u093f\u0938\u092e\u0947\u0902 \u0939\u0935\u093e \u0938\u0947 \u092d\u0930\u0947 \u092c\u093e\u0917\u0940\u091a\u094b\u0902 \u0915\u0947 \u0935\u093f\u0936\u093e\u0932 \u0938\u092e\u0941\u0926\u094d\u0930, \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0918\u093e\u091f\u094b\u0902 \u0915\u0947 \u091a\u093f\u0924\u094d\u0930\u0938\u0942\u091a\u0940 \u0914\u0930 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930\u0940 \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f \u0915\u093e \u0906\u092d\u093e\u0938 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d35\u0d3f\u0d38\u0d4d\u0d24\u0d40\u0d7c\u0d23\u0d4d\u0d23\u0d15\u0d4d\u0d15\u0d23\u0d4d\u0d23\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d32\u0d3f\u0d36\u0d15\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d30\u0d3f\u0d37\u0d4d\u0d15\u0d43\u0d24 \u0d2e\u0d32\u0d2f\u0d3e\u0d33\u0d02 \u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d2e\u0d47\u0d1f\u0d4d, \u0d2a\u0d36\u0d4d\u0d1a\u0d3f\u0d2e\u0d18\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d1a\u0d4d\u0d1a \u0d09\u0d37\u0d38\u0d4d\u0d38\u0d41\u0d28\u0d3f\u0d2f\u0d3e\u0d2e\u0d15\u0d47\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d15\u0d42\u0d1f\u0d3f\u0d2f \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d3f\u0d36\u0d3e\u0d32\u0d2e\u0d3e\u0d2f \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0b9a\u0bcd\u0b9a\u0bbf\u0bae \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb0\u0bbf\u0baf \u0baa\u0bbe\u0ba9\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba4\u0bbf\u0ba9\u0bcd\u0baa\u0bc1\u0bb1\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bc2\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0ba8\u0b9f\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0ba9\u0bc8\u0bb5\u0bbe\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bb2\u0bc8\u0ba8\u0b95\u0bb0\u0bae\u0bcd, \u0bae\u0bb0\u0b95\u0bcd\u0b95\u0bb3\u0bbe\u0ba9 \u0bb5\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0bae\u0bc1\u0bb4\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb0\u0bbf\u0baf \u0bae\u0bc7\u0bb2\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"77.276523",lat:"10.156809"},name:"Anamudi",name_HI:"\u0905\u0928\u093e\u092e\u0941\u0926\u0940",name_ML:"\u0d06\u0d28\u0d2e\u0d41\u0d1f\u0d3f",name_TA:"\u0b86\u0ba9\u0bae\u0bc1\u0b9f\u0bbf",note:"The highest peak in South India, known for its challenging trekking trails, rich biodiversity, and mesmerizing views of the surrounding valleys.",note_HI:"\u0926\u0915\u094d\u0937\u093f\u0923 \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u090a\u091a\u093e \u0936\u093f\u0916\u0930, \u091c\u093f\u0938\u0947 \u0915\u0920\u093f\u0928 \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u092e\u093e\u0930\u094d\u0917\u094b\u0902, \u0938\u092e\u0943\u0926\u094d\u0927 \u091c\u0948\u0935 \u0935\u093f\u0935\u093f\u0927\u0924\u093e, \u0914\u0930 \u0906\u0938\u092a\u093e\u0938 \u0915\u0947 \u0909\u092a\u0928\u0926\u0940\u092f\u094b\u0902 \u0915\u0947 \u092e\u094b\u0939\u0915 \u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d47 \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d09\u0d2f\u0d7c\u0d28\u0d4d\u0d28 \u0d2e\u0d41\u0d1f\u0d3f, \u0d15\u0d20\u0d3f\u0d28\u0d2e\u0d3e\u0d2f \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d3e\u0d24\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24 \u0d1c\u0d48\u0d35\u0d35\u0d48\u0d35\u0d3f\u0d27\u0d4d\u0d2f\u0d35\u0d41\u0d02, \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d1f\u0d3f\u0d2e\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d3f\u0d38\u0d4d\u0d2e\u0d30\u0d47\u0d3e\u0d1a\u0d4d\u0d1a\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bcd \u0b89\u0baf\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1, \u0bb5\u0bb2\u0bc1\u0bb5\u0bbe\u0ba9 \u0b9a\u0bc7\u0bbe\u0bb0\u0bcd\u0bb5\u0bc1 \u0baa\u0bbe\u0ba4\u0bc8\u0b95\u0bb3\u0bcd, \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baa\u0bcd \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0ba9 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"77.139869",lat:"9.973285"},name:"Kulamavu Dam",name_HI:"\u0915\u0941\u0932\u093e\u092e\u0935\u0941 \u092c\u093e\u0902\u0927",name_ML:"\u0d15\u0d41\u0d33\u0d2e\u0d3e\u0d35\u0d4d \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d4d",name_TA:"\u0b95\u0bc1\u0bb3\u0bae\u0bbe\u0bb5\u0bc1 \u0b85\u0ba3\u0bc8",note:"A picturesque dam nestled amidst lush green hills, offering breathtaking views of the reservoir and a serene ambiance for relaxation and picnicking.",note_HI:"\u0939\u0930\u093f\u0924 \u092c\u0939\u0941\u092e\u0942\u0932\u094d\u092f \u092a\u0939\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092c\u0938\u0947 \u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u0942\u091a\u0940 \u092c\u093e\u0902\u0927, \u091c\u0932\u093e\u0936\u092f \u0915\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0915\u093e \u0906\u092d\u093e\u0938 \u0914\u0930 \u0906\u0930\u093e\u092e \u0914\u0930 \u092a\u093f\u0915\u0928\u093f\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d39\u0d30\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d30\u0d4d\u0d35\u0d24\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d41\u0d02\u0d35\u0d47\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c\u0d23\u0d4d \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d1f\u0d02\u0d2e\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2a\u0d3e\u0d1a\u0d15\u0d4b\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d4d, \u0d05\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d36\u0d4d\u0d1a\u0d30\u0d4d\u0d2f\u0d3e\u0d28\u0d4d\u0d35\u0d47\u0d37\u0d23\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d06\u0d28\u0d28\u0d4d\u0d26\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d06\u0d34\u0d4d\u0d1a\u0d2f\u0d3f\u0d7d \u0d38\u0d28\u0d4d\u0d24\u0d47\u0d3e\u0d37\u0d35\u0d3e\u0d39\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2a\u0d3f\u0d15\u0d4d\u200c\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d3f\u0d28\u0d41\u0d02 \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d24\u0d3e\u0d24\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b87\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bcd \u0b85\u0ba3\u0bc8, \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0b95\u0b9f\u0bb2\u0bcd\u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bbf, \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bbe\u0ba9 \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0ba4\u0bcd \u0ba4\u0baf\u0bbe\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b92\u0bb0\u0bc1 \u0bae\u0ba9\u0bae\u0bbe\u0b95 \u0b85\u0bb4\u0bc8\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"77.034448",lat:"9.715023"},name:"Kalvari Mount",name_HI:"\u0915\u0932\u0935\u0930\u0940 \u092a\u0939\u093e\u0921\u093c\u0940",name_ML:"\u0d15\u0d32\u0d4d\u200d\u0d35\u0d3e\u0d30\u0d3f \u0d2e\u0d57\u0d23\u0d4d\u0d1f\u0d4d",name_TA:"\u0b95\u0bb2\u0bcd\u0bb5\u0bbe\u0bb0\u0bbf \u0bae\u0bb2\u0bc8",note:"A popular religious spot with a stunning view of Idukki town, featuring the stations of the cross and a pilgrimage destination during the Lenten season.",note_HI:"\u090f\u0915 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u094d\u0925\u0932 \u091c\u0939\u093e\u0902 \u0907\u0921\u0941\u0915\u094d\u0915\u0940 \u0936\u0939\u0930 \u0915\u093e \u090f\u0915 \u0936\u093e\u0928\u0926\u093e\u0930 \u0926\u0943\u0936\u094d\u092f \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0915\u094d\u0930\u0942\u0938 \u0915\u0947 \u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u091a\u0941\u0902\u092c\u0915\u0940\u092f \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u090f\u0915 \u0924\u0940\u0930\u094d\u0925\u092f\u093e\u0924\u094d\u0930\u093e \u0938\u094d\u0925\u0932 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d07\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3f \u0d1f\u0d57\u0d23\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d7d \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d28\u0d4d\u0d31\u0d46 \u0d28\u0d17\u0d30\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d3f\u0d24 \u0d2e\u0d24\u0d38\u0d4d\u0d25\u0d32\u0d02, \u0d26\u0d3f\u0d35\u0d38\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d32\u0d46\u0d28\u0d4d\u0d31\u0d28\u0d4d\u200d \u0d15\u0d3e\u0d32\u0d24\u0d4d\u0d24\u0d46 \u0d2a\u0d4d\u0d30\u0d2f\u0d3e\u0d23\u0d38\u0d4d\u0d25\u0d32\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b87\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbf \u0ba8\u0b95\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bbe\u0ba4\u0baa\u0bcd\u0baa\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0baa\u0bbf\u0bb0\u0baa\u0bb2 \u0bae\u0ba4 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b92\u0bb0\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc7\u0bbe\u0b9f\u0bc1 \u0baa\u0baf\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd \u0baa\u0bc1\u0bb0\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0b9f\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.965030",lat:"9.764705"},name:"Painavu",name_HI:"\u092a\u0948\u0928\u093e\u0935\u0941",name_ML:"\u0d2a\u0d48\u0d28\u0d3e\u0d35\u0d4d",name_TA:"\u0baa\u0bc8\u0ba9\u0bbe\u0bb5\u0bc1",note:"The headquarters of Idukki district, known for its pleasant climate, rolling hills, and proximity to various tourist attractions in the region.",note_HI:"\u0907\u0921\u0941\u0915\u094d\u0915\u0940 \u091c\u093f\u0932\u0947 \u0915\u093e \u092e\u0941\u0916\u094d\u092f\u093e\u0932\u092f, \u0905\u092a\u0928\u0940 \u0938\u0941\u0939\u093e\u0935\u0928\u093e \u091c\u0932\u0935\u093e\u092f\u0941, \u0918\u0942\u092e\u0928\u0947 \u0915\u0947 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0909\u091a\u094d\u091a\u0924\u093e, \u0914\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u0930\u094d\u092f\u091f\u0928 \u0906\u0915\u0930\u094d\u0937\u0923\u094b\u0902 \u0915\u0947 \u092a\u0921\u093c\u094b\u0938 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d07\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3f \u0d1c\u0d3f\u0d32\u0d4d\u0d32\u0d2f\u0d41\u0d1f\u0d46 \u0d2e\u0d41\u0d16\u0d4d\u0d2f\u0d3e\u0d32\u0d2f\u0d02, \u0d38\u0d57\u0d39\u0d43\u0d26 \u0d1c\u0d32\u0d35\u0d3e\u0d2f\u0d41\u0d35\u0d41\u0d02, \u0d09\u0d2f\u0d30\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d32\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d24\u0d4d\u0d24\u0d46 \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d2a\u0d30\u0d4d\u0d2f\u0d1f\u0d28 \u0d06\u0d15\u0d30\u0d4d\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d09\u0d33\u0d4d\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d2e\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b87\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbf \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bae\u0bc7\u0bb2\u0bbe\u0bb3\u0bb0\u0bbf\u0ba9\u0bcd \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0bae\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0b95\u0bbe\u0bb1\u0bcd\u0bb1\u0bb2\u0bcd, \u0b95\u0bc1\u0ba9\u0bbf\u0ba8\u0b95\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0bbf\u0baf \u0baa\u0bb2\u0bcd\u0bb5\u0bc7\u0bb1\u0bc1 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0b86\u0b95\u0bb0\u0bcd\u0bb7\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bb0\u0bc8\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.919094",lat:"10.072114"},name:"Cheeyappara Waterfalls",name_HI:"\u091a\u0940\u092f\u092a\u094d\u092a\u093e\u0930\u093e \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d1a\u0d40\u0d2f\u0d2a\u0d4d\u0d2a\u0d3e\u0d30 \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0b9a\u0bc0\u0baf\u0baa\u0bcd\u0baa\u0bb0\u0bbe \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd",note:"A beautiful waterfall located between Neriamangalam and Adimali, known for its picturesque setting and a popular pit-stop for travelers.",note_HI:"\u0928\u0947\u0930\u093f\u092f\u093e\u092e\u0902\u0917\u0932\u092e \u0914\u0930 \u0906\u0926\u093f\u092e\u093e\u0932\u093f \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924, \u091c\u093f\u0938\u0915\u0940 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932\u0940 \u0914\u0930 \u092f\u093e\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0920\u0939\u0930\u093e\u0935 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d28\u0d47\u0d30\u0d3f\u0d2f\u0d2e\u0d02\u0d17\u0d32\u0d02 \u0d05\u0d1f\u0d3f\u0d2e\u0d3e\u0d32\u0d3f\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d23\u0d4d \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02, \u0d05\u0d24\u0d3f\u0d30\u0d42\u0d2a\u0d15\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d25\u0d32\u0d2e\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41 \u0d2e\u0d31\u0d4d\u0d31\u0d41 \u0d2a\u0d4d\u0d30\u0d2f\u0d3e\u0d23\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d1c\u0d28\u0d2a\u0d4d\u0d30\u0d3f\u0d2f \u0d2a\u0d3f\u0d1f\u0d4d-\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4b\u0d2a\u0d4d\u0d2a\u0d3e\u0d23\u0d4d.",note_TA:"\u0ba8\u0bc6\u0bb0\u0bbf\u0baf\u0bae\u0b99\u0bcd\u0b95\u0bb2\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bbf\u0bae\u0bbe\u0bb2\u0bbf \u0b87\u0b9f\u0bc8\u0baf\u0bc7 \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1, \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0baa\u0bc1\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"77.243996",lat:"10.325113"},name:"Chinnar Wildlife Sanctuary",name_HI:"\u091a\u093f\u0928\u094d\u0928\u093e\u0930 \u0935\u0928\u094d\u092f\u091c\u0940\u0935 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d1a\u0d3f\u0d28\u0d4d\u0d28\u0d3e\u0d30\u0d4d\u200d \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35 \u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d02",name_TA:"\u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0bbe\u0bb0\u0bcd \u0bb5\u0ba9 \u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bc1 \u0baa\u0bc1\u0bb0\u0b9f\u0bcd\u0b9a\u0bbf",note:"A wildlife reserve known for its diverse flora and fauna, including endangered species like the grizzled giant squirrel and the star tortoise.",note_HI:"\u090f\u0915 \u0935\u0928\u094d\u092f\u091c\u0940\u0935 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f \u091c\u094b \u0935\u093f\u0935\u093f\u0927 \u092a\u094d\u0930\u093e\u0923\u093f\u091c\u093e\u0924\u093f \u0914\u0930 \u0935\u0928\u0938\u094d\u092a\u0924\u093f \u0938\u092e\u0947\u0924 \u0905\u092a\u094d\u0930\u093e\u0923\u093f\u091c\u093e\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0917\u094d\u0930\u093f\u091c\u093c\u0932\u094d\u0921 \u091c\u093e\u0902\u092d\u0941\u0915 \u0914\u0930 \u0938\u094d\u091f\u093e\u0930 \u091f\u0949\u0930\u094d\u091f\u094b\u0907\u091c\u093c \u091c\u0948\u0938\u0940 \u092a\u094d\u0930\u092e\u0941\u0916\u0924\u093e \u0938\u0902\u0915\u091f\u093e\u0927\u093f\u0915\u0943\u0924 \u091c\u093e\u0928\u0935\u0930 \u0938\u092e\u0947\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",note_ML:"\u0d2a\u0d32\u0d35\u0d3f\u0d27 \u0d1c\u0d48\u0d35\u0d35\u0d3f\u0d32\u0d19\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d35\u0d28\u0d4d\u0d2f\u0d1c\u0d40\u0d35\u0d3f\u0d24\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d35\u0d3f\u0d27\u0d24, \u0d35\u0d3f\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d1c\u0d48\u0d35\u0d35\u0d3f\u0d32\u0d15\u0d4d\u0d15\u0d02 \u0d2a\u0d4b\u0d32\u0d46 \u0d17\u0d4d\u0d30\u0d3f\u0d38\u0d3f\u0d7d\u0d21\u0d4d \u0d1c\u0d2f\u0d28\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d15\u0d4d\u0d35\u0d3f\u0d31\u0d32\u0d41\u0d02 \u0d38\u0d4d\u0d1f\u0d3e\u0d7c \u0d1f\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d38\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d7e\u0d15\u0d4d\u0d15\u0d4a\u0d33\u0d4d\u0d33\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d23\u0d4d\u0d1f\u0d4d.",note_TA:"\u0bb5\u0bc7\u0bb2\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0bb5\u0bbf\u0bb5\u0b9a\u0bbe\u0baf \u0bae\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0baa\u0bb2 \u0bb5\u0ba9\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0bb5\u0ba9\u0bae\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0bb5\u0bbf\u0baf\u0bb2\u0bcd \u0baa\u0bcb\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd."}],Ernakulam:[{location:{long:"76.242215",lat:"9.963386"},name:"Fort Kochi",name_HI:"\u092b\u094b\u0930\u094d\u091f \u0915\u094b\u091a\u094d\u091a\u093f",name_ML:"\u0d2b\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d15\u0d4a\u0d1a\u0d4d\u0d1a\u0d3f",name_TA:"\u0baa\u0bc6\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1 \u0b95\u0bca\u0b9a\u0bcd\u0b9a\u0bbf",note:"A historic neighborhood known for its colonial architecture, Chinese fishing nets, bustling streets, art galleries, and cultural performances.",note_HI:"\u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092a\u0921\u093c\u094b\u0938 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0909\u0928\u0915\u0947 \u0909\u092a\u0928\u0917\u0930 \u0915\u0940 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f, \u091a\u0940\u0928\u0940 \u092e\u091b\u0932\u0940 \u092a\u0915\u0921\u093c\u0928\u0947 \u0915\u0940 \u091c\u093e\u0932, \u0917\u0941\u0932\u091c\u093e\u0930\u0940 \u0917\u0932\u093f\u092f\u093e\u0902, \u0915\u0932\u093e \u0926\u0930\u094d\u0936\u0928\u0917\u094d\u0930\u0939, \u0914\u0930 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d4a\u0d33\u0d4b\u0d23\u0d3f\u0d2f\u0d7d \u0d06\u0d7c\u0d15\u0d4d\u0d15\u0d3f\u0d1f\u0d46\u0d15\u0d4d\u0d1a\u0d4d\u0d1a\u0d7c, \u0d1a\u0d48\u0d28\u0d40\u0d38\u0d4d \u0d2e\u0d40\u0d7b \u0d2a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d7e, \u0d2a\u0d41\u0d1f\u0d15\u0d4d\u0d15\u0d4b\u0d1f\u0d4d \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c, \u0d15\u0d32\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d05\u0d28\u0d41\u0d37\u0d4d\u0d20\u0d3e\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d10\u0d24\u0d3f\u0d39\u0d4d\u0d2f\u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d4d\u0d25\u0d32\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b90\u0ba4\u0bbf\u0bb9\u0bbe\u0bb8\u0bbf\u0b95 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf\u0b95\u0bb3\u0bcd, \u0b9a\u0bc0\u0ba9 \u0bae\u0bc0\u0ba9\u0bcd \u0bb5\u0bb2\u0bc8\u0b95\u0bb3\u0bcd, \u0b9a\u0bc7\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0bbf \u0bb5\u0bc0\u0ba4\u0bbf\u0b95\u0bb3\u0bcd, \u0b95\u0bb2\u0bc8 \u0b95\u0bb2\u0bc8\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0b90\u0ba4\u0bbf\u0baf\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf."},{location:{long:"76.238719",lat:"9.957232"},name:"Mattancherry Palace",name_HI:"\u092e\u091f\u094d\u091f\u093e\u091e\u094d\u091a\u0947\u0930\u0940 \u092e\u0939\u0932",name_ML:"\u0d2e\u0d1f\u0d4d\u0d1f\u0d3e\u0d1e\u0d4d\u0d1a\u0d47\u0d30\u0d3f \u0d2a\u0d3e\u0d33\u0d38\u0d4d",name_TA:"\u0bae\u0b9f\u0bcd\u0b9f\u0bbe\u0b9e\u0bcd\u0b9a\u0bc7\u0bb0\u0bbf \u0bae\u0bb9\u0bb2\u0bcd",note:"A Portuguese palace also known as the Dutch Palace, featuring stunning murals, traditional architecture, and a museum showcasing artifacts.",note_HI:"\u090f\u0915 \u092a\u0941\u0930\u094d\u0924\u0917\u093e\u0932\u0940 \u092e\u0939\u0932 \u091c\u093f\u0938\u0947 \u0921\u091a \u092e\u0939\u0932 \u0915\u0947 \u0928\u093e\u092e \u0938\u0947 \u092d\u0940 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0926\u093f\u0935\u094d\u092f\u0926\u0930\u094d\u0936\u0940 \u0926\u0940\u0935\u093e\u0930 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930\u0940, \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u0914\u0930 \u090f\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d21\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d3e\u0d33\u0d38\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4b\u0d7c\u0d1a\u0d4d\u0d1a\u0d41\u0d17\u0d40\u0d38\u0d4d \u0d2a\u0d3e\u0d33\u0d38\u0d4d, \u0d38\u0d4d\u0d24\u0d42\u0d2a\u0d36\u0d41\u0d36\u0d4d\u0d30\u0d41\u0d37, \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d3e\u0d32\u0d2f\u0d02 \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b92\u0bb0\u0bc1 \u0baa\u0bcb\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0bb8\u0bcd \u0bae\u0b95\u0bb0\u0bae\u0bbe\u0ba9 \u0ba4\u0b9a\u0bcd\u0b9a\u0bc1 \u0bae\u0bb9\u0bb2\u0bcd, \u0b85\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0bae\u0bcd, \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b95\u0bb2\u0bc8 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1 \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bc6\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"76.242455",lat:"9.964325"},name:"Jew Town",name_HI:"\u091c\u0942 \u091f\u093e\u0909\u0928",name_ML:"\u0d1c\u0d42 \u0d1f\u0d57\u0d7a",name_TA:"\u0b9c\u0bc2 \u0b9f\u0bb5\u0bc1\u0ba9\u0bcd",note:"A vibrant market area known for its antique shops, spice stores, handicrafts, and the famous Paradesi Synagogue, the oldest active synagogue in the Commonwealth.",note_HI:"\u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0926\u0941\u0915\u093e\u0928\u094b\u0902, \u092e\u0938\u093e\u0932\u093e \u0938\u094d\u091f\u094b\u0930, \u0939\u0938\u094d\u0924\u0936\u093f\u0932\u094d\u092a \u0914\u0930 \u092a\u094d\u0930\u092e\u0941\u0916 \u092a\u0930\u093e\u0926\u0947\u0936\u0940 \u0938\u093f\u0928\u0947\u0917\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u092c\u093e\u091c\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0964 \u092f\u0939 \u0938\u0902\u0918 \u0915\u0940 \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0938\u093f\u0928\u0947\u0917\u094b\u0917 \u0939\u0948\u0964",note_ML:"\u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28 \u0d37\u0d4b\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e, \u0d2e\u0d38\u0d3e\u0d32 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4b\u0d31\u0d41\u0d15\u0d7e, \u0d15\u0d31\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24 \u0d2a\u0d30\u0d26\u0d47\u0d36\u0d3f \u0d38\u0d3f\u0d28\u0d17\u0d4b\u0d17\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d40 \u0d12\u0d30\u0d41 \u0d1c\u0d40\u0d35\u0d28\u0d4d\u0d24 \u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d15\u0d2e\u0d7a\u0d35\u0d46\u0d7d\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d34\u0d2f \u0d38\u0d15\u0d4d\u0d30\u0d3f\u0d2f\u0d2e\u0d3e\u0d2f \u0d38\u0d3f\u0d28\u0d17\u0d4b\u0d17\u0d4d.",note_TA:"\u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b95\u0b9f\u0bc8\u0b95\u0bb3\u0bcd, \u0bae\u0bbf\u0bb3\u0b95\u0bc1 \u0b95\u0b9f\u0bc8\u0b95\u0bb3\u0bcd, \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\u0bc7\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0baa\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bc1\u0b95\u0bb4\u0bbe\u0ba9 \u0baa\u0bb0\u0ba4\u0bc7\u0b9a\u0bbf \u0b9a\u0bbf\u0ba9\u0b95\u0bcb\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bc1\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0b9a\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bb0\u0bae\u0bbe\u0ba9 \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.278409",lat:"9.963395"},name:"Marine Drive",name_HI:"\u092e\u0930\u0940\u0928 \u0921\u094d\u0930\u093e\u0907\u0935",name_ML:"\u0d2e\u0d30\u0d40\u0d7b \u0d21\u0d4d\u0d30\u0d48\u0d35\u0d4d",name_TA:"\u0bae\u0bb0\u0bbf\u0ba9\u0bcd \u0b9f\u0bbf\u0bb0\u0bc8\u0bb5\u0bcd",note:"A popular promenade along the backwaters, offering scenic views, boating, and a vibrant atmosphere with shopping complexes and street food stalls.",note_HI:"\u092a\u093e\u0928\u0940 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0915\u093e \u090f\u0915 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u091f\u094d\u0930\u0948\u0915, \u091c\u0939\u093e\u0902 \u0938\u094c\u0902\u0926\u0930\u094d\u092f\u092a\u0942\u0930\u094d\u0923 \u0926\u0943\u0936\u094d\u092f, \u0928\u094c\u0915\u093e\u092f\u0928 \u0914\u0930 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0947\u0902\u0926\u094d\u0930 \u0914\u0930 \u0938\u0921\u093c\u0915 \u092d\u094b\u091c\u0928 \u0915\u0940 \u0926\u0941\u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u091c\u0940\u0935\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d24\u0d40\u0d30\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d3f\u0d24 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d, \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d02, \u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d19\u0d4d\u0d19\u0d4d, \u0d37\u0d4b\u0d2a\u0d4d\u0d2a\u0d3f\u0d02\u0d17\u0d4d \u0d15\u0d4b\u0d02\u0d2a\u0d4d\u0d32\u0d46\u0d15\u0d4d\u0d38\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d38\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e \u0d2d\u0d4b\u0d1c\u0d28 \u0d15\u0d1f\u0d15\u0d4d\u0d15\u0d15\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d1c\u0d40\u0d35\u0d28\u0d4d\u0d24 \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0bae\u0bbf\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0b87\u0bb0\u0bc1\u0baa\u0ba4\u0bcd\u0ba4\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba4\u0bbf\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd, \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bcd, \u0baa\u0b9f\u0b95\u0bc1\u0b95\u0bb3\u0bcd, \u0bb7\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0b99\u0bcd \u0b95\u0bbe\u0bae\u0bcd\u0baa\u0bbf\u0bb3\u0bc6\u0b95\u0bcd\u0bb8\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc6\u0bb0\u0bc1 \u0b89\u0ba3\u0bb5\u0bc1 \u0bae\u0b9f\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bbe\u0ba9 \u0b85\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0ba9\u0bb5\u0bb0\u0bae\u0bbe\u0ba9 \u0b86\u0bb5\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9\u0bcd."},{location:{long:"76.290587",lat:"9.957712"},name:"Bolgatty Palace",name_HI:"\u092c\u094b\u0932\u0917\u091f\u094d\u091f\u0940 \u092e\u0939\u0932",name_ML:"\u0d2c\u0d4b\u0d7e\u0d17\u0d1f\u0d4d\u0d1f\u0d3f \u0d2a\u0d3e\u0d32\u0d38\u0d4d",name_TA:"\u0baa\u0bcb\u0bb2\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bbf \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8",note:"A beautiful island palace converted into a heritage hotel, featuring exquisite architecture, lush green gardens, and a scenic location by the backwaters.",note_HI:"\u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u0926\u094d\u0935\u0940\u092a \u092e\u0939\u0932 \u091c\u093f\u0938\u0947 \u090f\u0915 \u0927\u0930\u094b\u0939\u0930 \u0939\u094b\u091f\u0932 \u092e\u0947\u0902 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0905\u0924\u094d\u092f\u0902\u0924 \u0938\u0941\u0902\u0926\u0930 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u0939\u0930\u093e \u092c\u0917\u0940\u091a\u0947, \u0914\u0930 \u092a\u093e\u0928\u0940 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0915\u0940 \u090f\u0915 \u091a\u0930\u094d\u091a\u093f\u0924 \u0938\u094d\u0925\u093e\u0928 \u0939\u0948\u0964",note_ML:"\u0d12\u0d30\u0d41 \u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d4d \u0d2a\u0d3e\u0d32\u0d38\u0d4d \u0d27\u0d30\u0d4d\u200d\u0d2e\u0d4d\u0d2e\u0d3f\u0d15 \u0d39\u0d4b\u0d1f\u0d4d\u0d1f\u0d32\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d1a\u0d4d\u0d1a\u0d41, \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24 \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d02, \u0d2a\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d41\u0d28\u0d40\u0d32\u0d15\u0d4d\u0d15\u0d47\u0d3e\u0d1f\u0d4d \u0d38\u0d26\u0d43\u0d36\u0d2e\u0d3e\u0d2f \u0d06\u0d35\u0d3e\u0d38\u0d3e\u0d35\u0d38\u0d3e\u0d26\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d2a\u0d1f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d1c\u0d32\u0d35\u0d47\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d \u0d12\u0d30\u0d41 \u0d35\u0d3f\u0d38\u0d4d\u0d2e\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d4d.",note_TA:"\u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0ba4\u0bc0\u0bb5\u0bc1 \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8 \u0baa\u0bc1\u0bb0\u0bbe\u0ba3 \u0bb5\u0bbf\u0b9a\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b92\u0bb0\u0bc1 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bbf \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1, \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b95\u0bb2\u0bc8\u0bae\u0bc1\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc0\u0bb0 \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b87\u0b9f\u0bae\u0bcd \u0b86\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.378051",lat:"9.947469"},name:"Hill Palace Museum",name_HI:"\u0939\u093f\u0932 \u092a\u0948\u0932\u0947\u0938 \u092e\u094d\u092f\u0942\u091c\u093f\u092f\u092e",name_ML:"\u0d39\u0d3f\u0d32\u0d4d\u200d \u0d2a\u0d3e\u0d32\u0d38\u0d4d \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02",name_TA:"\u0bae\u0bb2\u0bc8 \u0b85\u0bb0\u0ba3\u0bcd\u0bae\u0ba9\u0bc8 \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0b95\u0bae\u0bcd",note:"The largest archaeological museum in Kerala, housing a vast collection of artifacts, royal belongings, and ancient manuscripts.",note_HI:"\u0915\u0947\u0930\u0932 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092a\u0941\u0930\u093e\u0924\u0924\u094d\u0935\u093f\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f, \u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u093f\u0936\u093e\u0932 \u0938\u0902\u0917\u094d\u0930\u0939 \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u0948, \u0936\u093e\u0939\u0940 \u0938\u092e\u094d\u092a\u0926\u093e\u0913\u0902 \u0914\u0930 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0939\u0938\u094d\u0924\u0932\u093f\u0916\u093f\u0924 \u092a\u093e\u0920\u094b\u0902 \u0915\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u0923 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d35\u0d32\u0d3f\u0d2f \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d38\u0d02\u0d18\u0d02, \u0d35\u0d3f\u0d36\u0d3e\u0d32\u0d2e\u0d3e\u0d2f \u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d30\u0d3e\u0d1c\u0d15\u0d40\u0d2f \u0d35\u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d2a\u0d41\u0d38\u0d4d\u0d24\u0d15\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d4d.",note_TA:"\u0b95\u0bc7\u0bb0\u0bb3\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0bae\u0bbf\u0b95\u0baa\u0bcd \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0ba4\u0bca\u0bb2\u0bc8\u0bb5\u0bbf\u0baf\u0bb2\u0bcd \u0b85\u0bb0\u0b9a\u0bc1\u0b95\u0bcd \u0b95\u0bb2\u0bc8\u0bae\u0bbe\u0b9f\u0bae\u0bcd, \u0b85\u0baa\u0bb0\u0bbe\u0ba3\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0ba9\u0bae\u0bbe\u0ba9 \u0b95\u0bb2\u0bc8\u0b95\u0bb3\u0bc8, \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd\u0b95\u0bb3\u0bc8, \u0baa\u0bb4\u0bc8\u0baf \u0bae\u0bc8\u0baf \u0ba8\u0bc2\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0ba4\u0bc1."},{location:{long:"76.323092",lat:"10.139889"},name:"Wonderla Amusement Park",name_HI:"\u0935\u0902\u0921\u0930\u0932\u093e \u092e\u0928\u094b\u0930\u0902\u091c\u0928 \u092a\u093e\u0930\u094d\u0915",name_ML:"\u0d35\u0d4b\u0d23\u0d4d\u0d1f\u0d46\u0d30\u0d4d\u200d\u0d32 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3e\u0d30\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d4d",name_TA:"\u0bb5\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd\u0bb2\u0bbe \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe",note:"A thrilling amusement park with a variety of rides, water slides, and entertainment options for all age groups.",note_HI:"\u090f\u0915 \u0930\u094b\u092e\u093e\u0902\u091a\u0915 \u092e\u0928\u094b\u0930\u0902\u091c\u0928 \u092a\u093e\u0930\u094d\u0915 \u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0930\u093e\u0907\u0921, \u0935\u0949\u091f\u0930 \u0938\u094d\u0932\u093e\u0907\u0921 \u0914\u0930 \u0938\u092d\u0940 \u0906\u092f\u0941 \u0938\u092e\u0942\u0939\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092e\u0928\u094b\u0930\u0902\u091c\u0928 \u0935\u093f\u0915\u0932\u094d\u092a \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0902\u0964",note_ML:"\u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d35\u0d3f\u0d28\u0d4b\u0d26 \u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d35\u0d4b\u0d1f\u0d4d\u0d1f\u0d7c \u0d38\u0d4d\u0d32\u0d48\u0d21\u0d41\u0d15\u0d33\u0d41\u0d02, \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3e\u0d30\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d23\u0d4d.",note_TA:"\u0bb5\u0bc7\u0bb1\u0bc1\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc7\u0bb1\u0bc1\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe\u0baf\u0bae\u0bbe\u0ba9 \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe."},{location:{long:"76.337085",lat:"10.009131"},name:"Kerala Folklore Museum",name_HI:"\u0915\u0947\u0930\u0932 \u0932\u094b\u0915\u0915\u0925\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f",name_ML:"\u0d15\u0d47\u0d30\u0d33 \u0d32\u0d47\u0d3e\u0d15\u0d15\u0d25\u0d3e \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d3e\u0d32\u0d2f\u0d02",name_TA:"\u0b95\u0bc7\u0bb0\u0bb3\u0bbe \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0b95\u0ba4\u0bc8 \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bae\u0bcd",note:"A museum showcasing a rich collection of traditional art, cultural artifacts, costumes, and sculptures, providing insights into Kerala's rich cultural heritage.",note_HI:"\u090f\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u091c\u094b \u092a\u0930\u0902\u092a\u0930\u093e\u0917\u0924 \u0915\u0932\u093e, \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0909\u092a\u0915\u0930\u0923, \u092a\u094b\u0937\u093e\u0915 \u0914\u0930 \u092e\u0942\u0930\u094d\u0924\u093f\u0915\u0932\u093e\u0913\u0902 \u0915\u093e \u090f\u0915 \u0938\u092e\u0943\u0926\u094d\u0927 \u0938\u0902\u0917\u094d\u0930\u0939 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u094b \u0915\u0947\u0930\u0932 \u0915\u0940 \u0938\u092e\u0943\u0926\u094d\u0927 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0935\u093f\u0930\u093e\u0938\u0924 \u092e\u0947\u0902 \u0905\u0935\u0917\u0924\u093f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3e\u0d17\u0d24 \u0d15\u0d32, \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d43\u0d24\u0d3f\u0d15 \u0d38\u0d02\u0d30\u0d02\u0d2d\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d2a\u0d1f\u0d35\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d23\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d05\u0d2e\u0d42\u0d32\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d3e\u0d32\u0d2f\u0d02.",note_TA:"\u0b92\u0bb0\u0bc1 \u0bae\u0bb0\u0bc1\u0bae\u0b95\u0bb3\u0bcd \u0b95\u0bb2\u0bc8, \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd\u0b95\u0bb3\u0bcd, \u0b85\u0ba3\u0bbf\u0b95\u0bb2\u0ba9\u0bcd\u0b95\u0bb3\u0bcd, \u0b89\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1 \u0b92\u0bb0\u0bc1 \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bae\u0bcd."},{location:{long:"76.056465",lat:"10.159815"},name:"Cherai Beach",name_HI:"\u091a\u0947\u0930\u093e\u0908 \u092c\u0940\u091a",name_ML:"\u0d1a\u0d46\u0d31\u0d3e\u0d2f\u0d3f \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b9a\u0bc7\u0bb0\u0bc8 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A serene and clean beach with golden sand, backwaters, and coconut groves, offering a relaxing ambiance and picturesque sunsets.",note_HI:"\u0938\u094d\u0935\u0930\u094d\u0917\u0940\u092f \u0914\u0930 \u0938\u094d\u0935\u091a\u094d\u091b \u092c\u0940\u091a \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u094b\u0928\u0947 \u0915\u0940 \u0930\u0947\u0924, \u092c\u0948\u0915\u0935\u093e\u091f\u0930 \u0914\u0930 \u0928\u093e\u0930\u093f\u092f\u0932 \u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u091c\u094b \u090f\u0915 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0914\u0930 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932\u0940 \u0917\u094b\u0932 \u0905\u0938\u094d\u0924 \u0938\u092e\u094d\u092a\u094d\u0930\u0926\u093e\u092f \u0938\u0941\u0928\u094d\u0938\u0947\u091f\u094d\u0938 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",note_ML:"\u0d38\u0d46\u0d31\u0d2f\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\u0d2f \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d, \u0d2e\u0d1e\u0d4d\u0d1e \u0d2a\u0d3e\u0d31\u0d15\u0d7e, \u0d35\u0d40\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d3e\u0d1f\u0d4d \u0d24\u0d7d\u0d38\u0d2e\u0d2f \u0d24\u0d3e\u0d2a\u0d28\u0d3f\u0d32, \u0d2a\u0d4d\u0d30\u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d2e\u0d3e\u0d39\u0d3f\u0d24\u0d3f, \u0d06\u0d15\u0d46 \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d38\u0d42\u0d30\u0d4d\u0d2f\u0d3e\u0d38\u0d4d\u0d24\u0d2e\u0d2f\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0bae\u0bc7\u0bb2\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0bb2\u0bc8\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0ba4\u0bc7\u0b99\u0bcd\u0b95\u0bbe\u0baf\u0bcd \u0bae\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0ba9\u0ba4\u0bc8 \u0b85\u0bb4\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0ba9\u0bbf\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bae\u0ba3\u0bb2\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8."},{location:{long:"76.282939",lat:"9.981531"},name:"Mangalavanam Bird Sanctuary",name_HI:"\u092e\u0902\u0917\u0932\u0935\u0928\u092e \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d2e\u0d02\u0d17\u0d32\u0d35\u0d28\u0d02 \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d38\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d02",name_TA:"\u0bae\u0b99\u0bcd\u0b95\u0bb2\u0bb5\u0ba9\u0bae\u0bcd \u0baa\u0bb1\u0bb5\u0bc8 \u0b9a\u0bb0\u0ba3\u0bbe\u0bb2\u0baf\u0bae\u0bcd",note:"A small but ecologically important bird sanctuary in the heart of Kochi city, known for its diverse bird species and lush mangrove vegetation.",note_HI:"\u0915\u094b\u091a\u094d\u091a\u093f \u0936\u0939\u0930 \u0915\u0947 \u0926\u093f\u0932 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u091b\u094b\u091f\u093e \u092a\u0930\u0902\u092a\u0930\u093e\u0917\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f \u0939\u0948, \u091c\u093f\u0938\u0947 \u0935\u093f\u0935\u093f\u0927 \u092a\u0915\u094d\u0937\u0940 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0914\u0930 \u0918\u0928\u0947 \u092e\u0948\u0902\u0917\u094d\u0930\u094b\u0935 \u0935\u0928\u0938\u094d\u092a\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d35\u0d48\u0d35\u0d3f\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d7c\u0d28\u0d4d\u0d28 \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d07\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d15\u0d23\u0d4d\u0d1f\u0d7d \u0d38\u0d38\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d47\u0d1f\u0d4d\u0d1f, \u0d15\u0d4a\u0d1a\u0d4d\u0d1a\u0d3f \u0d28\u0d17\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d39\u0d43\u0d26\u0d2f\u0d2d\u0d3e\u0d17\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d1a\u0d46\u0d31\u0d41\u0d24\u0d41\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d7d \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f \u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d38\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d02.",note_TA:"\u0b95\u0bca\u0b9a\u0bcd\u0b9a\u0bbf \u0ba8\u0b95\u0bb0\u0bbf\u0ba9\u0bcd \u0bae\u0bc8\u0baf\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b9a\u0bbf\u0bb1\u0bbf\u0baf \u0b86\u0ba9\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0b9a\u0bcd\u0b9a\u0bc2\u0bb4\u0bb2\u0bcd \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0bb5\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0bb1\u0bb5\u0bc8\u0b95\u0bb3\u0bcd \u0b9a\u0bb0\u0ba3\u0bbe\u0bb2\u0baf\u0bae\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0bb2\u0bcd\u0bb5\u0bc7\u0bb1\u0bc1 \u0baa\u0bb1\u0bb5\u0bc8 \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b9a\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0ba8\u0bbf\u0bb2 \u0ba4\u0bbe\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1."}],Thrissur:[{location:{long:"76.214782",lat:"10.525574"},name:"Vadakkunnathan Temple",name_HI:"\u0935\u0921\u0915\u094d\u0915\u0941\u0928\u094d\u0928\u093e\u0925\u0928 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d35\u0d1f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d25\u0d7b \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0ba9\u0bcd\u0ba9\u0bbe\u0ba4\u0ba9\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"An ancient Hindu temple dedicated to Lord Shiva, featuring magnificent architecture, vibrant festivals, and the iconic Thrissur Pooram celebration.",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0939\u093f\u0902\u0926\u0942 \u092e\u0902\u0926\u093f\u0930 \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0936\u093e\u0928\u0926\u093e\u0930 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u091c\u0940\u0935\u0902\u0924 \u0924\u094d\u092f\u094b\u0939\u093e\u0930 \u0914\u0930 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0924\u0943\u0937\u094d\u0923\u093e\u092a\u0942\u0930\u092e \u092e\u0939\u094b\u0924\u094d\u0938\u0935 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964",note_ML:"\u0d2d\u0d17\u0d35\u0d3e\u0d7b \u0d36\u0d3f\u0d35\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d30\u0d4d\u200d\u0d2a\u0d4d\u0d2a\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28\u0d2e\u0d3e\u0d2f \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d4d \u0d35\u0d1f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d25\u0d7b \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d2e\u0d3f\u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d42\u0d30\u0d02 \u0d2e\u0d39\u0d4b\u0d24\u0d4d\u0d38\u0d35\u0d35\u0d41\u0d02 \u0d2d\u0d35\u0d4d\u0d2f \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d2f\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d35\u0d2f\u0d3e\u0d23\u0d4d.",note_TA:""},{location:{long:"76.517876",lat:"10.287460"},name:"Athirappilly Waterfalls",name_HI:"\u0905\u0925\u093f\u0930\u092a\u094d\u092a\u093f\u0932\u094d\u0932\u0940 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d05\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d2a\u0d4d\u0d2a\u0d3f\u0d33\u0d4d\u0d33\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bb3\u0bcd\u0bb3\u0bbf \u0b85\u0bb0\u0bc1\u0bb5\u0bbf",note:"A majestic waterfall cascading through lush green forests, known for its scenic beauty and often referred to as the 'Niagara Falls of India.'",note_HI:"\u090f\u0915 \u0936\u093e\u0928\u0926\u093e\u0930 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924 \u0939\u0948 \u091c\u094b \u0939\u0930\u0947-\u092d\u0930\u0947 \u091c\u0902\u0917\u0932\u094b\u0902 \u0938\u0947 \u092c\u0939\u0915\u0930 \u0917\u093f\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \u0926\u0943\u0936\u094d\u092f\u092e\u092f \u0938\u094c\u0902\u0926\u0930\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u092f\u0939 '\u092d\u093e\u0930\u0924 \u0915\u093e \u0928\u093f\u092f\u093e\u0917\u0930\u093e \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924' \u0915\u0939\u0932\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d4a\u0d32\u0d4d\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d23\u0d02 \u0d24\u0d1f\u0d3e\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d32\u0d3f\u0d2f \u0d1c\u0d32\u0d2a\u0d4d\u0d30\u0d2a\u0d3e\u0d24\u0d2e\u0d3e\u0d23\u0d4d \u0d05\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d2a\u0d4d\u0d2a\u0d3f\u0d33\u0d4d\u0d33\u0d3f, \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41; '\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d41\u0d1f\u0d46 \u0d28\u0d3f\u0d2f\u0d3e\u0d17\u0d3e\u0d30 \u0d1c\u0d32\u0d2a\u0d4d\u0d30\u0d2a\u0d3e\u0d24\u0d02' \u0d0e\u0d28\u0d4d\u0d28\u0d41 \u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"76.223858",lat:"10.521329"},name:"Thrissur Zoo",name_HI:"\u0924\u094d\u0930\u093f\u0936\u0942\u0930 \u091a\u093f\u0921\u093c\u093f\u092f\u093e\u0918\u0930",name_ML:"\u0d24\u0d43\u0d36\u0d4d\u0d36\u0d42\u0d30\u0d4d\u200d \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d2e\u0d23\u0d4d\u0d1f\u0d2a\u0d02",name_TA:"\u0ba4\u0bbf\u0bb0\u0bbf\u0b9a\u0bc2\u0bb0\u0bcd \u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bc1 \u0bae\u0bc8\u0baf\u0bae\u0bcd",note:"A well-maintained zoological park housing a wide variety of animals, including lions, tigers, elephants, reptiles, and a butterfly park.",note_HI:"\u090f\u0915 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u091a\u093f\u0921\u093c\u093f\u092f\u093e\u0918\u0930 \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u093f\u0902\u0939, \u092c\u093e\u0918, \u0939\u093e\u0925\u0940, \u0938\u0930\u0940\u0938\u0943\u092a \u0914\u0930 \u090f\u0915 \u0924\u093f\u0924\u0932\u0940 \u0909\u0926\u094d\u092f\u093e\u0928 \u0938\u0939\u093f\u0924 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u091c\u093e\u0928\u0935\u0930\u094b\u0902 \u0915\u094b \u0906\u0935\u093e\u0938 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d3e\u0d32\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d, \u0d2a\u0d41\u0d32\u0d3f, \u0d06\u0d28, \u0d05\u0d32\u0d19\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d24\u0d3f\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d2f\u0d3e\u0d33\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d1c\u0d28\u0d4d\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d7e \u0d06\u0d2f\u0d3e\u0d38\u0d02\u0d17\u0d24\u0d4d\u0d24\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d2a\u0d3e\u0d1f\u0d4d\u0d1f\u0d47\u0d30\u0d3f\u0d2f\u0d35\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d1c\u0d42\u0d33\u0d1c\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2a\u0d41\u0d24\u0d3f\u0d2f\u0d24\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"76.430254",lat:"10.567080"},name:"Peechi Dam",name_HI:"\u092a\u0940\u091a\u0940 \u092c\u093e\u0902\u0927",name_ML:"\u0d2a\u0d40\u0d1a\u0d4d\u0d1a\u0d3f \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d4d",name_TA:"\u0baa\u0bc0\u0b9a\u0bcd\u0b9a\u0bbf \u0b85\u0ba3\u0bc8",note:"A picturesque dam surrounded by verdant forests, offering boating facilities and a tranquil environment for picnicking and nature walks.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u093e\u092f\u0940 \u092c\u093e\u0902\u0927 \u091c\u094b \u0939\u0930\u093f\u0924\u093e\u092d\u0930\u093f\u0924 \u091c\u0902\u0917\u0932\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0918\u093f\u0930\u093e \u0939\u0941\u0906 \u0939\u0948, \u091c\u094b \u092c\u094b\u091f\u093f\u0902\u0917 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0914\u0930 \u092a\u093f\u0915\u0928\u093f\u0915 \u0914\u0930 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0915\u0947 \u0938\u0902\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d42\u0d30\u0d4d\u200d\u0d23\u0d3f\u0d2e\u0d2f\u0d4b\u0d1f\u0d46 \u0d35\u0d3f\u0d2d\u0d4d\u0d30\u0d2e\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d3e\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d4d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d3f\u0d36\u0d4d\u0d30\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a\u0d41 \u0d2a\u0d4b\u0d15\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d43\u0d15\u0d4d\u0d37\u0d2a\u0d1f\u0d3f\u0d2f\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2a\u0d42\u0d28\u0d4d\u0d24\u0d41\u0d31 \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d3e\u0d23\u0d4d \u0d2a\u0d40\u0d1a\u0d4d\u0d1a\u0d3f \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d4d.",note_TA:"\u0baa\u0bb4\u0bc8\u0baf \u0bb5\u0ba9\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bc8\u0ba8\u0bcd\u0ba4\u0baf\u0ba4\u0bcd\u0ba4\u0bc8 \u0b85\u0bb4\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1, \u0baa\u0baf\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbe\u0bb4\u0bc8\u0baa\u0bcd\u0baa\u0bc2 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0b9a\u0bae\u0bbe\u0ba9 \u0bb5\u0bbe\u0ba9\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bc8\u0ba8\u0bcd\u0ba4\u0baf \u0b86\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.040886",lat:"10.595646"},name:"Guruvayur Temple",name_HI:"\u0917\u0941\u0930\u0941\u0935\u093e\u092f\u0942\u0930 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d17\u0d41\u0d30\u0d41\u0d35\u0d3e\u0d2f\u0d42\u0d30\u0d4d\u200d \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0b95\u0bc1\u0bb0\u0bc1\u0bb5\u0bbe\u0baf\u0bc2\u0bb0\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"One of the most important pilgrimage sites for Hindus in Kerala, dedicated to Lord Krishna and known for its grand architecture and festivals.",note_HI:"\u0915\u0947\u0930\u0932 \u092e\u0947\u0902 \u0939\u093f\u0902\u0926\u0941\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0924\u0940\u0930\u094d\u0925\u0938\u094d\u0925\u0932\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915, \u092d\u0917\u0935\u093e\u0928 \u0915\u0943\u0937\u094d\u0923 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092e\u0939\u093e\u0928 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0914\u0930 \u0924\u094d\u092f\u094b\u0939\u093e\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d41\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d05\u0d24\u0d4d \u0d2e\u0d39\u0d24\u0d4d\u0d24\u0d3e\u0d2f \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d36\u0d4d\u0d30\u0d40\u0d15\u0d43\u0d37\u0d4d\u0d23\u0d28\u0d46 \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d37\u0d4d\u0d20\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16\u0d2e\u0d3e\u0d2f \u0d24\u0d40\u0d7c\u0d25\u0d38\u0d4d\u0d25\u0d32\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d12\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d17\u0d41\u0d30\u0d41\u0d35\u0d3e\u0d2f\u0d42\u0d7c \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02.",note_TA:"\u0b95\u0bc7\u0bb0\u0bb3\u0bbe\u0bb5\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0baa\u0bcd \u0baa\u0bc1\u0bb0\u0bbe\u0ba3\u0b95\u0bcd\u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd, \u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0ba9 \u0bb5\u0bbe\u0bb8\u0bcd\u0ba4\u0bc1\u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bc1\u0bae\u0bcd \u0b89\u0b9f\u0ba9\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"76.013697",lat:"10.529050"},name:"Chavakkad Beach",name_HI:"\u091a\u093e\u0935\u0915\u094d\u0915\u0921 \u092c\u0940\u091a",name_ML:"\u0d1a\u0d3e\u0d35\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b9a\u0bbe\u0bb5\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A pristine beach known for its scenic beauty, tranquil atmosphere, and the popular fishing harbor nearby.",note_HI:"\u0905\u092a\u0928\u0940 \u0926\u0943\u0936\u094d\u092f\u092e\u092f \u0938\u0941\u0902\u0926\u0930\u0924\u093e, \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0914\u0930 \u0928\u091c\u0926\u0940\u0915\u0940 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u092e\u0924\u094d\u0938\u094d\u092f \u092a\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u090f\u0915 \u0936\u0941\u0926\u094d\u0927 \u092c\u0940\u091a\u0964",note_ML:"\u0d06\u0d26\u0d4d\u0d2f\u0d30\u0d3e\u0d24\u0d4d\u0d30\u0d3f\u0d2f\u0d41\u0d02 \u0d2a\u0d30\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d2f \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d02, \u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d35\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16\u0d2e\u0d3e\u0d2f \u0d2e\u0d40\u0d28\u0d2a\u0d4d\u0d2a\u0d1f\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d3e\u0d32\u0d3f\u0d28\u0d4d\u0d2f\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24 \u0d15\u0d1f\u0d31\u0d4d\u0d31\u0d3f\u0d32\u0d3e\u0d23\u0d4d \u0d1a\u0d3e\u0d35\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d.",note_TA:"\u0ba8\u0bc7\u0bb0\u0bcd\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b85\u0bae\u0bcd\u0baa\u0bbf\u0bb0\u0bae\u0bae\u0bc1\u0bae\u0bcd, \u0b85\u0bb0\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bae\u0bc0\u0ba9\u0bcd \u0baa\u0b9f\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0b9f\u0bb1\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8\u0baf\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"76.212036",lat:"10.606628"},name:"Punnathur Kotta Elephant Sanctuary",name_HI:"\u092a\u0941\u0928\u094d\u0928\u0925\u0941\u0930 \u0915\u094b\u091f\u094d\u091f\u093e \u0939\u093e\u0925\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d2a\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d\u0d24\u0d42\u0d30\u0d4d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f \u0d06\u0d28 \u0d38\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d02",name_TA:"\u0baa\u0bc1\u0ba9\u0bcd\u0ba9\u0ba4\u0bcd\u0ba4\u0bc2\u0bb0\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe \u0baf\u0bbe\u0ba9\u0bc8 \u0b85\u0bb0\u0ba3\u0bcd\u0baf\u0bae\u0bcd",note:"A unique sanctuary located near Guruvayur Temple, housing dozens of elephants and offering visitors an opportunity to interact with these gentle giants.",note_HI:"\u0917\u0941\u0930\u0941\u0935\u093e\u092f\u0942\u0930 \u092e\u0902\u0926\u093f\u0930 \u0915\u0947 \u092a\u093e\u0938 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f, \u091c\u0939\u093e\u0902 \u0926\u0930\u094d\u0936\u0915\u094b\u0902 \u0915\u094b \u0907\u0928 \u092a\u094d\u092f\u093e\u0930\u0947 \u0935\u093f\u0936\u093e\u0932\u0915\u093e\u092f \u091c\u093e\u0928\u0935\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0935\u0938\u0930 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d17\u0d41\u0d30\u0d41\u0d35\u0d3e\u0d2f\u0d42\u0d7c \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d4a\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d38\u0d19\u0d4d\u0d15\u0d47\u0d24\u0d02, \u0d05\u0d28\u0d47\u0d15\u0d02 \u0d06\u0d28\u0d15\u0d33\u0d46 \u0d06\u0d36\u0d4d\u0d30\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d23\u0d4d\u0d1f\u0d4d, \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d26\u0d30\u0d4d\u0d36\u0d15\u0d30\u0d4b\u0d1f\u0d4a\u0d2a\u0d4d\u0d2a\u0d02 \u0d07\u0d23\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d05\u0d35\u0d38\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b95\u0bc1\u0bb0\u0bc1\u0bb5\u0bbe\u0baf\u0bc2\u0bb0\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0ba3\u0bcd\u0baf\u0bae\u0bcd, \u0baa\u0bb2\u0bb5\u0bbf\u0ba4 \u0baf\u0bbe\u0ba9\u0bc8\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1 \u0baa\u0bca\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb5\u0bb0\u0bb5\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1\u0b95\u0bca\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"76.190428",lat:"10.542364"},name:"Vilangan Hills",name_HI:"\u0935\u093f\u0932\u0902\u0917\u0928 \u092a\u0939\u093e\u0921\u093c\u093f\u092f\u093e\u0901",name_ML:"\u0d35\u0d3f\u0d32\u0d19\u0d4d\u0d19\u0d7b \u0d2a\u0d7c\u0d35\u0d4d\u0d35\u0d24\u0d02",name_TA:"\u0bb5\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0ba9\u0bcd \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bcd",note:"A hillock with lush green surroundings, offering panoramic views of Thrissur city and an ideal spot for nature walks and trekking.",note_HI:"\u0939\u0930\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u091b\u094b\u091f\u093e \u092a\u0939\u093e\u0921\u093c\u0940, \u0925\u094d\u0930\u093f\u0936\u0942\u0930 \u0936\u0939\u0930 \u0915\u093e \u0906\u092d\u093e\u0938\u0940 \u0926\u0943\u0936\u094d\u092f \u0914\u0930 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0915\u0947 \u0938\u093e\u0925 \u0938\u0948\u0930-\u0938\u092a\u093e\u091f\u0947 \u0914\u0930 \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0906\u0926\u0930\u094d\u0936 \u0938\u094d\u0925\u093e\u0928\u0964",note_ML:"\u0d2a\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d4a\u0d30\u0d41\u0d2a\u0d4d\u0d2a\u0d3e\u0d2f \u0d1a\u0d46\u0d31\u0d41\u0d2a\u0d41\u0d1f\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d24\u0d43\u0d36\u0d4d\u0d36\u0d42\u0d7c \u0d28\u0d17\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d1f\u0d2a\u0d4d\u0d2a\u0d3e\u0d1f\u0d41\u0d15\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d, \u0d38\u0d4d\u0d35\u0d2d\u0d3e\u0d35\u0d35\u0d47\u0d26\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d38\u0d4d\u0d35\u0d3e\u0d2d\u0d3e\u0d35\u0d3f\u0d15 \u0d28\u0d1f\u0d2a\u0d4d\u0d2a\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d3e\u0d28\u0d41\u0d02 \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d3f\u0d28\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d06\u0d26\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d46 \u0d38\u0d4d\u0d25\u0d32\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0bae\u0bbe\u0ba9 \u0b9a\u0bbf\u0bb5\u0ba9\u0bcd \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0bb1\u0bae\u0bcd\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bae\u0bcd, \u0ba4\u0bbf\u0bb0\u0bbf\u0b9a\u0bc2\u0bb0\u0bcd \u0ba8\u0b95\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bb0\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0ba8\u0bbf\u0bb2\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b92\u0bb0\u0bc1 \u0b86\u0bb1\u0bcd\u0bb1\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4 \u0b87\u0b9f\u0bae\u0bbe\u0b95 \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.222791",lat:"10.527485"},name:"Museum of Kerala History",name_HI:"\u0915\u0947\u0930\u0932 \u0907\u0924\u093f\u0939\u093e\u0938 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f",name_ML:"\u0d15\u0d47\u0d30\u0d33 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d36\u0d3e\u0d32",name_TA:"\u0b95\u0bc7\u0bb0\u0bb3 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bcd",note:"A museum showcasing Kerala's history, culture, art, and heritage through a vast collection of artifacts, dioramas, and multimedia presentations.",note_HI:"\u090f\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u091c\u094b \u0915\u0947\u0930\u0932 \u0915\u0947 \u0907\u0924\u093f\u0939\u093e\u0938, \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f, \u0915\u0932\u093e \u0914\u0930 \u0927\u0930\u094b\u0939\u0930 \u0915\u094b \u0935\u093f\u0936\u093e\u0932 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u0935\u0938\u094d\u0924\u094d\u0930\u093e\u0926\u093f\u092f\u094b\u0902, \u0921\u093e\u092f\u094b\u0930\u093e\u092e\u093e \u0914\u0930 \u092e\u0932\u094d\u091f\u0940\u092e\u0940\u0921\u093f\u092f\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02, \u0d38\u0d02\u0d38\u0d4d\u0d15\u0d43\u0d24\u0d3f, \u0d15\u0d32\u0d2f\u0d41\u0d02 \u0d2a\u0d41\u0d30\u0d3e\u0d24\u0d28\u0d35\u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d36\u0d3e\u0d32 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d02, \u0d21\u0d2f\u0d4b\u0d31\u0d3e\u0d2e\u0d15\u0d33\u0d41\u0d02 \u0d2c\u0d39\u0d41\u0d2e\u0d41\u0d16\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d35\u0d34\u0d3f \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d36\u0d3e\u0d32\u0d2f\u0d3e\u0d23\u0d4d.",note_TA:"\u0baa\u0bb2\u0bcd\u0bb5\u0bc7\u0bb1\u0bc1 \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd\u0b95\u0bb3\u0bcd, \u0b9f\u0baf\u0bb0\u0bbe\u0bae\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bb2\u0bcd\u0b9f\u0bbf\u0bae\u0bc0\u0b9f\u0bbf\u0baf\u0bbe \u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b95\u0bc7\u0bb0\u0bb3\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1, \u0b95\u0bb2\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd, \u0b95\u0bb2\u0bc8 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf\u0bae\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1 \u0b92\u0bb0\u0bc1 \u0b85\u0bb0\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0bae\u0bc1\u0bb1\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0ba4\u0bc1 \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0bb3\u0bcd."},{location:{long:"76.211862",lat:"10.526013"},name:"Puthan Pally (Basilica of Our Lady of Dolours)",name_HI:"\u092a\u0941\u0925\u0928 \u092a\u0932\u094d\u0932\u0940 (\u0926\u094b\u0932\u094c\u0930\u094d\u0938 \u0905\u0935 \u092e\u093e\u0924\u093e \u092c\u0947\u0938\u093f\u0932\u093f\u0915\u093e)",name_ML:"\u0d2a\u0d41\u0d24\u0d4d\u0d24\u0d7b \u0d2a\u0d33\u0d4d\u0d33\u0d3f (\u0d21\u0d4b\u0d33\u0d4b\u0d7c\u0d38\u0d4d \u0d05\u0d35\u0d7c \u0d2e\u0d3e\u0d24\u0d3e \u0d2c\u0d38\u0d3f\u0d32\u0d3f\u0d15\u0d4d\u0d15)",name_TA:"\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0ba9\u0bcd \u0baa\u0bb3\u0bcd\u0bb3\u0bbf (\u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb2\u0bc7\u0b9f\u0bbf \u0b86\u0b83\u0baa\u0bcd \u0b9f\u0bb2\u0bb0\u0bcd\u0bb8\u0bcd \u0baa\u0bc7\u0b9a\u0bbf\u0bb2\u0bbf\u0b95\u0bcd\u0b95\u0bbe)",note:"A famous Catholic church in Thrissur known for its Gothic architecture, religious significance, and the annual feast of the Mother Mary.",note_HI:"\u0917\u094b\u0925\u093f\u0915 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0914\u0930 \u092e\u093e\u0924\u093e \u092e\u0947\u0930\u0940 \u0915\u0947 \u0935\u093e\u0930\u094d\u0937\u093f\u0915\u094b\u0924\u094d\u0938\u0935 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0925\u094d\u0930\u093f\u0938\u094d\u0938\u0942\u0930 \u092e\u0947\u0902 \u090f\u0915 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0915\u0948\u0925\u094b\u0932\u093f\u0915 \u091a\u0930\u094d\u091a\u0964",note_ML:"\u0d17\u0d4b\u0d24\u0d3f\u0d15\u0d4d \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d35\u0d3f\u0d26\u0d4d\u0d2f, \u0d2e\u0d24\u0d2a\u0d4d\u0d2a\u0d4a\u0d30\u0d41\u0d33\u0d3e\u0d2f \u0d2e\u0d39\u0d24\u0d4d\u0d35\u0d35\u0d41\u0d02 \u0d2e\u0d3e\u0d24\u0d3e \u0d2e\u0d47\u0d30\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d35\u0d3e\u0d7c\u0d37\u0d3f\u0d15\u0d4b\u0d24\u0d4d\u0d38\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d24\u0d43\u0d36\u0d4d\u0d36\u0d42\u0d30\u0d3f\u0d7d \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27 \u0d15\u0d24\u0d4d\u0d24\u0d4b\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d3e \u0d2a\u0d33\u0d4d\u0d33\u0d3f.",note_TA:"\u0b95\u0bcb\u0ba4\u0bbf\u0b95\u0bcd \u0bb5\u0bbe\u0bb8\u0bcd\u0ba4\u0bc1\u0b95\u0bb3\u0bcd, \u0bae\u0ba4 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bbe\u0baf\u0bcd \u0bae\u0bc7\u0bb0\u0bbf \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bcb\u0bb0\u0bcd \u0baa\u0bca\u0ba4\u0bc1\u0bb5\u0bbe\u0ba9 \u0baa\u0bcb\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bbe\u0b95 \u0ba4\u0bbf\u0bb0\u0bbf\u0b9a\u0bc2\u0bb0\u0bbf\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0baa\u0bbf\u0bb0\u0baa\u0bb2\u0bae\u0bbe\u0ba9 \u0b95\u0ba4\u0bcd\u0ba4\u0bcb\u0bb2\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0ba4\u0bc7\u0bb5\u0bbe\u0bb2\u0baf\u0bae\u0bcd."}],Palakkad:[{location:{long:"76.623502",lat:"10.814971"},name:"Malampuzha Dam",name_HI:"\u092e\u093e\u0932\u092e\u094d\u092a\u0941\u091d\u093e \u092c\u093e\u0902\u0927",name_ML:"\u0d2e\u0d32\u0d2e\u0d4d\u0d2a\u0d41\u0d34 \u0d05\u0d23\u0d15\u0d4d\u0d15\u0d46\u0d1f\u0d4d\u0d1f\u0d4d",name_TA:"\u0bae\u0bb2\u0bae\u0bcd\u0baa\u0bc1\u0bb4\u0bbe \u0b85\u0ba3\u0bc8",note:"A picturesque dam surrounded by lush green gardens, offering boating facilities, a ropeway ride, and a beautiful garden called the 'Malampuzha Gardens'.",note_HI:"\u0939\u0930\u093f\u0924\u092e\u092f \u092c\u0917\u0940\u091a\u094b\u0902 \u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932 \u092c\u093e\u0902\u0927, \u092c\u094b\u091f\u093f\u0902\u0917 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901, \u090f\u0915 \u0930\u094b\u092a\u0935\u0947 \u092f\u093e\u0924\u094d\u0930\u093e, \u0914\u0930 '\u092e\u0932\u092e\u094d\u092a\u0941\u091d\u093e \u0909\u0926\u094d\u092f\u093e\u0928' \u0928\u093e\u092e\u0915 \u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u0909\u0926\u094d\u092f\u093e\u0928 \u0915\u0940 \u092a\u0947\u0936\u0915\u0936 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d39\u0d30\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d24\u0d4b\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d12\u0d30\u0d41 \u0d2a\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d1f\u0d24\u0d4d\u0d24\u0d4d, \u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d02\u0d17\u0d4d \u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d31\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d\u200c\u0d35\u0d47 \u0d2f\u0d3e\u0d24\u0d4d\u0d30, \u0d12\u0d30\u0d41 \u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f '\u0d2e\u0d32\u0d2e\u0d4d\u0d2a\u0d41\u0d34 \u0d09\u0d26\u0d4d\u0d2f\u0d3e\u0d28\u0d02' \u0d0e\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d23\u0d4d\u0d23\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d3e\u0d34\u0d4d\u0d1a \u0d28\u0d32\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc8 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbf \u0b89\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bae\u0bbf\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bae\u0bcd\u0baa\u0bbe\u0ba9 \u0b85\u0ba3\u0bc8, \u0baa\u0b9f\u0b95\u0bc1 \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1, \u0bb0\u0bcb\u0baa\u0bcd\u0baa\u0bbe\u0baf\u0bcd \u0baa\u0baf\u0ba3\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd '\u0bae\u0bb2\u0bae\u0bcd\u0baa\u0bc1\u0bb4\u0bbe \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bb3\u0bcd' \u0b8e\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"76.704332",lat:"10.468982"},name:"Parambikulam Wildlife Sanctuary",name_HI:"\u092a\u0930\u092e\u094d\u092c\u093f\u0915\u0941\u0932\u092e \u0935\u0928\u094d\u092f\u091c\u0940\u0935 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d02 \u0d1c\u0d40\u0d35\u0d3f\u0d24 \u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d23\u0d02",name_TA:"\u0baa\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0bb5\u0ba9 \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bbe\u0b9f\u0bc1",note:"A vast wildlife sanctuary known for its rich biodiversity, featuring a large reservoir, trekking trails, and opportunities for wildlife spotting.",note_HI:"\u0905\u092a\u093e\u0930 \u0935\u0928\u094d\u092f\u091c\u0940\u0935 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f \u091c\u093f\u0938\u0947 \u0909\u0938\u0915\u0940 \u0938\u092e\u0943\u0926\u094d\u0927 \u091c\u0948\u0935 \u0935\u093f\u0935\u093f\u0927\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u090f\u0915 \u092c\u0921\u093c\u093e \u091c\u0932\u093e\u0936\u092f, \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u091f\u094d\u0930\u0947\u0932 \u0914\u0930 \u0935\u0928\u094d\u092f\u091c\u0940\u0935\u094b\u0902 \u0915\u0940 \u0924\u0932\u093e\u0936 \u0915\u0947 \u0932\u093f\u090f \u0905\u0935\u0938\u0930 \u0939\u0948\u0902\u0964",note_ML:"\u0d05\u0d24\u0d3f\u0d35\u0d3f\u0d38\u0d4d\u0d24\u0d43\u0d24\u0d2e\u0d3e\u0d2f \u0d1c\u0d40\u0d35\u0d3f\u0d24 \u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d23\u0d02 \u0d05\u0d24\u0d3f\u0d32\u0d46 \u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27 \u0d1c\u0d48\u0d35 \u0d35\u0d48\u0d35\u0d3f\u0d27\u0d4d\u0d2f\u0d02\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d35\u0d32\u0d3f\u0d2f \u0d24\u0d1f\u0d3e\u0d15\u0d35\u0d41\u0d02, \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d19\u0d4d\u0d19\u0d4d \u0d1f\u0d4d\u0d30\u0d46\u0d2f\u0d3f\u0d32\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2e\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d46 \u0d1c\u0d40\u0d35\u0d3f\u0d15\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d05\u0d35\u0d15\u0d3e\u0d36\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b89\u0baf\u0bbf\u0bb0\u0bbf\u0baf\u0bb2\u0bcd \u0baa\u0bb3\u0bcd\u0bb3\u0bbf\u0bb5\u0bbe\u0b9a\u0bb2\u0bcd, \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0b93\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\u0baa\u0bbe\u0bb1\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0baf\u0bbf\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bbf\u0b9f \u0b85\u0bb5\u0b95\u0bbe\u0b9a\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"76.656976",lat:"10.771092"},name:"Palakkad Fort",name_HI:"\u092a\u093e\u0932\u0915\u094d\u0915\u093e\u091f \u0915\u093f\u0932\u093e",name_ML:"\u0d2a\u0d3e\u0d32\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f",name_TA:"\u0baa\u0bbe\u0bb2\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bc1 \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8",note:"An ancient fort dating back to the 18th century, known for its historical significance, architecture, and the annual Palakkad Fort Festival.",note_HI:"18\u0935\u0940\u0902 \u0936\u0924\u093e\u092c\u094d\u0926\u0940 \u092e\u0947\u0902 \u0935\u093e\u092a\u0938 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u093f\u0932\u093e, \u0907\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u092e\u0939\u0924\u094d\u0935, \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0914\u0930 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092a\u093e\u0932\u0915\u094d\u0915\u093e\u091f \u0915\u093f\u0932\u093e \u0909\u0924\u094d\u0938\u0935 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"18\u0d3e\u0d02 \u0d28\u0d42\u0d31\u0d4d\u0d31\u0d3e\u0d23\u0d4d\u0d1f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d1f\u0d15\u0d4d\u0d15\u0d02 \u0d2a\u0d4b\u0d35\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d15\u0d4b\u0d1f\u0d4d\u0d1f, \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30 \u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d35\u0d41\u0d02, \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d35\u0d41\u0d02, \u0d35\u0d3e\u0d30\u0d4d\u200d\u0d37\u0d3f\u0d15 \u0d2a\u0d3e\u0d32\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"18\u0b86\u0bae\u0bcd \u0ba8\u0bc2\u0bb1\u0bcd\u0bb1\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0bbe\u0b9a\u0bbf\u0ba9 \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8, \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd \u0baa\u0bca\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1, \u0b95\u0bb2\u0bc8\u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0bb5\u0bbe\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0b9f\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8 \u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"76.674432",lat:"10.511161"},name:"Nelliyampathy Hills",name_HI:"\u0928\u0947\u0932\u094d\u0932\u093f\u092f\u092e\u094d\u092a\u0925\u093f \u092a\u0939\u093e\u0921\u093c\u093f\u092f\u093e\u0901",name_ML:"\u0d28\u0d46\u0d32\u0d4d\u0d32\u0d3f\u0d2f\u0d2e\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f \u0d2e\u0d32\u0d2f\u0d3f\u0d28\u0d3f\u0d2e\u0d3e\u0d32\u0d15\u0d7e",name_TA:"\u0ba8\u0bc6\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bae\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bcd",note:"A scenic hill station with tea and coffee plantations, offering breathtaking views of the surrounding valleys, misty mountains, and pleasant weather.",note_HI:"\u091a\u093e\u092f \u0914\u0930 \u0915\u0949\u092b\u0940 \u0915\u0940 \u092c\u093e\u0917\u0935\u093e\u0928\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u091a\u0930\u094d\u091a\u093f\u0924 \u092a\u0939\u093e\u0921\u093c\u0940 \u0938\u094d\u091f\u0947\u0936\u0928, \u091c\u094b \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0918\u093e\u091f\u093f\u092f\u094b\u0902, \u0927\u0941\u0902\u0927\u0932\u0947 \u092a\u0939\u093e\u0921\u093c\u094b\u0902 \u0914\u0930 \u0938\u0941\u0939\u093e\u0935\u0928\u0947 \u092e\u094c\u0938\u092e \u0915\u0940 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0915\u093e \u0906\u0928\u0902\u0926 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d1a\u0d3e\u0d2f\u0d2f\u0d41\u0d02 \u0d15\u0d4b\u0d2b\u0d3f\u0d2f\u0d41\u0d02 \u0d2e\u0d32\u0d2f\u0d3f\u0d28\u0d3f\u0d2e\u0d3e\u0d32\u0d15\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d2e\u0d32\u0d2f\u0d3f\u0d28\u0d3f\u0d2e\u0d3e\u0d32\u0d02, \u0d1a\u0d41\u0d31\u0d4d\u0d31\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d18\u0d3e\u0d1f\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d2e\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f \u0d2a\u0d7c\u0d35\u0d4d\u0d35\u0d24\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d3e\u0d32\u0d3e\u0d2a\u0d28\u0d4d\u0d24\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d28\u0d47\u0d30\u0d3f\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0ba4\u0bc7\u0bb5\u0bc8 \u0bae\u0bb2\u0bc8 \u0bae\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0bb3\u0bcd\u0bb3\u0bbf\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f \u0b85\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf, \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0bb5\u0bb3\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0bc1\u0b9f\u0bbf\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\u0bb0\u0bc1\u0bae\u0bcd, \u0bae\u0bc7\u0bb2\u0bcd\u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0ba9\u0bb5\u0bc1\u0bae\u0bbe\u0ba9 \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0bae\u0ba9\u0ba4\u0bc8 \u0b85\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0ba9\u0bbf\u0bb2\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.412169",lat:"11.108240"},name:"Silent Valley National Park",name_HI:"\u0938\u093e\u0907\u0932\u0947\u0902\u091f \u0935\u0948\u0932\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0909\u0926\u094d\u092f\u093e\u0928",name_ML:"\u0d38\u0d48\u0d32\u0d28\u0d4d\u0d31\u0d4d \u0d35\u0d3e\u0d32\u0d40 \u0d26\u0d47\u0d36\u0d40\u0d2f \u0d09\u0d26\u0d4d\u0d2f\u0d3e\u0d28\u0d02",name_TA:"\u0b9a\u0bc8\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb5\u0bc7\u0bb2\u0bcd\u0bb2\u0bbf \u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe",note:"A pristine tropical rainforest known for its untouched natural beauty, rich flora and fauna, and the presence of endangered species like the lion-tailed macaque.",note_HI:"\u0905\u092a\u0935\u093f\u0924\u094d\u0930 \u091f\u094d\u0930\u0949\u092a\u093f\u0915\u0932 \u0935\u0930\u094d\u0937\u093e \u0935\u0928 \u091c\u094b \u0905\u092a\u0942\u0930\u094d\u0923 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0938\u094c\u0902\u0926\u0930\u094d\u092f, \u0938\u092e\u0943\u0926\u094d\u0927 \u0935\u0928\u0938\u094d\u092a\u0924\u093f \u0914\u0930 \u091c\u0948\u0935 \u0935\u093f\u0935\u093f\u0927\u0924\u093e, \u0914\u0930 \u0938\u093f\u0902\u0939 \u0915\u0940 \u092a\u0942\u0902\u091b \u0935\u093e\u0932\u0947 \u092e\u0915\u093e\u0915 \u0915\u0940 \u091c\u0948\u0938\u0947 \u0916\u0924\u0930\u0947 \u092e\u0947\u0902 \u092a\u0921\u093c\u0947 \u091c\u0940\u0935 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u092e\u094c\u091c\u0942\u0926\u0917\u0940 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d05\u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d24\u0d02 \u0d1f\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d35\u0d43\u0d15\u0d4d\u0d37\u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d24, \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d36\u0d28\u0d02, \u0d05\u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d24 \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d02, \u0d2f\u0d41\u0d15\u0d4d\u0d24\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d1c\u0d40\u0d35\u0d3f\u0d15\u0d33\u0d41\u0d02, \u0d38\u0d3f\u0d02\u0d39\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d48\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d46 \u0d35\u0d3f\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d1c\u0d40\u0d35\u0d2a\u0d4d\u0d30\u0d3e\u0d23\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0bb5\u0ba9\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0bae\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe, \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0baa\u0ba9\u0bcd\u0bae\u0bca\u0bb4\u0bbf\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bbf\u0bb0 \u0b9a\u0bbf\u0bb1\u0bc1\u0bae\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0b9a\u0bbf\u0bb2\u0baa\u0bcd \u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b85\u0baa\u0bbe\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b95\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bae\u0bc8\u0baf\u0bc8 \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.459795",lat:"10.607625"},name:"Dhoni Waterfalls",name_HI:"\u0927\u094b\u0928\u0940 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d27\u0d4b\u0d23\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0ba4\u0bcb\u0ba9\u0bbf \u0b85\u0bb0\u0bc1\u0bb5\u0bbf",note:"A charming waterfall located amidst dense forests, known for its tranquil ambiance, natural pools, and a perfect spot for relaxation and picnicking.",note_HI:"\u0918\u0928\u0947 \u091c\u0902\u0917\u0932\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u092e\u094b\u0939\u0915 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924, \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923, \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u092a\u0942\u0932 \u0914\u0930 \u0906\u0930\u093e\u092e \u0914\u0930 \u092a\u093f\u0915\u0928\u093f\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0906\u0926\u0930\u094d\u0936 \u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d07\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d42\u0d1f\u0d4d\u0d1f\u0d2e\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2e\u0d27\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d06\u0d15\u0d30\u0d41\u0d23\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02, \u0d36\u0d3e\u0d28\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d41\u0d26\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46, \u0d15\u0d4d\u0d30\u0d2e\u0d36\u0d15\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d2f \u0d05\u0d35\u0d38\u0d4d\u0d25\u0d2f\u0d41\u0d02, \u0d38\u0d28\u0d4d\u0d24\u0d41\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02\u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d4d\u0d25\u0d32\u0d02 \u0d06\u0d23\u0d4d.",note_TA:"\u0b95\u0b9f\u0bc1\u0bae\u0bcd \u0bae\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0bc7\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf, \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b9a\u0bc1\u0bae\u0bc8, \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bc1\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc6\u0ba4\u0bc1\u0bb5\u0bbe\u0ba9 \u0b87\u0b9f\u0bae\u0bcd \u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0ba3\u0bb0\u0bcd\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bbf\u0ba4\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0b87\u0b9f\u0bae\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1."},{location:{long:"76.661561",lat:"10.791480"},name:"Jainmedu Jain Temple",name_HI:"\u091c\u0948\u0928\u092e\u0947\u0921\u0942 \u091c\u0948\u0928 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d1c\u0d48\u0d28\u0d4d\u0d2e\u0d46\u0d1f\u0d4d \u0d1c\u0d48\u0d28\u0d41\u0d15\u0d7e \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0b9c\u0bc8\u0ba9\u0bcd\u0bae\u0bc6\u0b9f\u0bc1 \u0b9c\u0bc8\u0ba9\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd",note:"A beautiful Jain temple with stunning architecture, intricate carvings, and a peaceful atmosphere, attracting devotees and tourists alike.",note_HI:"\u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u091c\u0948\u0928 \u092e\u0902\u0926\u093f\u0930 \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u0915\u0930\u094d\u0937\u0915 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u091c\u091f\u093f\u0932 \u0928\u0915\u094d\u0915\u093e\u0936\u0940 \u0914\u0930 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0939\u094b\u0924\u093e \u0939\u0948, \u091c\u094b \u092d\u0915\u094d\u0924\u094b\u0902 \u0914\u0930 \u092a\u0930\u094d\u092f\u091f\u0915\u094b\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d35\u0d3f\u0d24\u0d3e\u0d28\u0d02\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d1a\u0d41\u0d30\u0d41\u0d15\u0d4d\u0d15\u0d3f\u0d1a\u0d4d\u0d1a\u0d47\u0d7c\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d3e\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d1c\u0d48\u0d28\u0d4d\u200d \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d02, \u0d15\u0d20\u0d3f\u0d28\u0d2e\u0d3e\u0d2f \u0d15\u0d31\u0d4d\u0d31\u0d3f\u0d02\u0d17\u0d41\u0d15\u0d7e, \u0d38\u0d2e\u0d43\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d06\u0d30\u0d3e\u0d27\u0d28\u0d3e\u0d28\u0d41\u0d2f\u0d3e\u0d28\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d06\u0d15\u0d7c\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b9c\u0bc8\u0ba9\u0bcd \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd, \u0b85\u0ba4\u0bbf\u0bb0\u0bcd\u0bb7\u0bcd\u0b9f\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbe\u0bb8\u0bcd\u0ba4\u0bc1\u0b95\u0bb3\u0bcd, \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b9a\u0bbf\u0bb1\u0bc1\u0bae\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0b85\u0bae\u0bbe\u0ba9\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc8 \u0b86\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0bae\u0bc2\u0b9f\u0bbf\u0baf \u0b95\u0bb2\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba9, \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bb0\u0bae\u0bbe\u0ba9\u0ba4\u0bc1."},{location:{long:"76.539497",lat:"10.687255"},name:"Meenvallam Waterfalls",name_HI:"\u092e\u0940\u0928\u0935\u0932\u094d\u0932\u092e \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d2e\u0d40\u0d7b\u0d35\u0d33\u0d4d\u0d33\u0d02 \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0bae\u0bc0\u0ba9\u0bcd\u0bb5\u0bb3\u0bcd\u0bb3\u0bae\u0bcd \u0b85\u0bb0\u0bc1\u0bb5\u0bbf",note:"A scenic waterfall cascading through rocky terrain, known for its natural beauty, trekking opportunities, and a refreshing bathing experience.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932\u0940\u092f \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924 \u091c\u094b \u091a\u091f\u094d\u091f\u093e\u0928\u0940 \u092d\u0942\u092e\u093f \u0938\u0947 \u092c\u0939\u0924\u093e \u0939\u0948, \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0938\u094c\u0902\u0926\u0930\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0915\u0947 \u0905\u0935\u0938\u0930\u094b\u0902 \u0914\u0930 \u090f\u0915 \u0924\u093e\u091c\u0917\u0940 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0928\u093e\u0928 \u0905\u0928\u0941\u092d\u0935 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d05\u0d1f\u0d3f\u0d2a\u0d4a\u0d33\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02 \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d24\u0d4d, \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d02, \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d05\u0d35\u0d15\u0d3e\u0d36\u0d19\u0d4d\u0d19\u0d7e, \u0d24\u0d3e\u0d34\u0d4d\u0d28\u0d4d\u0d28 \u0d38\u0d4d\u0d28\u0d3e\u0d28 \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d23\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d.",note_TA:"\u0b95\u0bb2\u0bcd\u0bb2\u0bc1\u0bb1\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bb3\u0bb0\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf, \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd, \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc8 \u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb3\u0bbf\u0bb0\u0bcd \u0b95\u0bc1\u0bb4\u0bbe\u0baf\u0bcd \u0b85\u0ba9\u0bc1\u0baa\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"76.651163",lat:"10.801816"},name:"Kalpathy Heritage Village",name_HI:"\u0915\u0932\u094d\u092a\u0924\u093f \u0927\u0930\u094b\u0939\u0930 \u0917\u094d\u0930\u093e\u092e",name_ML:"\u0d15\u0d7d\u0d2a\u0d24\u0d3f \u0d2a\u0d47\u0d30\u0d3f\u0d31\u0d19\u0d4d\u0d19\u0d7d \u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d02",name_TA:"\u0b95\u0bb2\u0bcd\u0baa\u0ba4\u0bbf \u0baa\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bc8 \u0b8a\u0bb0\u0bcd",note:"A culturally rich village known for its ancient temples, annual Ratholsavam festival, and the unique Kalpathy Puthu Theru street.",note_HI:"\u090f\u0915 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0927\u0928\u0940 \u0917\u093e\u0902\u0935 \u091c\u093f\u0938\u0947 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092e\u0902\u0926\u093f\u0930\u094b\u0902, \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0930\u0925\u094b\u0932\u094d\u0938\u0935\u092e \u0909\u0924\u094d\u0938\u0935, \u0914\u0930 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0915\u0932\u094d\u092a\u0924\u093f \u092a\u0941\u0925\u0941 \u0924\u0947\u0930\u0942 \u0938\u0921\u093c\u0915 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d35\u0d3e\u0d7c\u0d37\u0d3f\u0d15 \u0d30\u0d25\u0d4b\u0d24\u0d4d\u0d38\u0d35 \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d35\u0d41\u0d02, \u0d12\u0d30\u0d41\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d15\u0d32\u0d4d\u0d2a\u0d24\u0d3f \u0d2a\u0d41\u0d24\u0d41 \u0d24\u0d46\u0d30\u0d41 \u0d35\u0d34\u0d3f\u0d2f\u0d41\u0d02 \u0d05\u0d28\u0d41\u0d2a\u0d35\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d2e\u0d3e\u0d2f \u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d2e\u0d3e\u0d23\u0d4d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d.",note_TA:"\u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bae\u0bcd, \u0baa\u0bb4\u0bc8\u0baf \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd\u0bb7 \u0bb0\u0ba4\u0bcd\u0ba4\u0bcb\u0bb2\u0bcd\u0bb8\u0bb5\u0bae\u0bcd \u0bb5\u0bbf\u0bb4\u0bbe \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b95\u0bb2\u0bcd\u0baa\u0ba4\u0bbf \u0baa\u0bc1\u0ba4\u0bc1 \u0ba4\u0bc6\u0bb0\u0bc1 \u0ba4\u0bc6\u0bb0\u0bc1\u0bb5\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0b9a\u0bbe\u0bb0\u0bcd\u0baa\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.626408",lat:"10.942047"},name:"Siruvani Waterfalls",name_HI:"\u0938\u093f\u0930\u0941\u0935\u093e\u0928\u0940 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d38\u0d3f\u0d31\u0d41\u0d35\u0d3e\u0d23\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02",name_TA:"\u0b9a\u0bbf\u0bb0\u0bc1\u0bb5\u0bbe\u0ba3\u0bbf \u0b85\u0bb0\u0bc1\u0bb5\u0bbf",note:"A mesmerizing waterfall located near the Kerala-Tamil Nadu border, known for its crystal-clear waters and a serene ambiance.",note_HI:"\u0915\u0947\u0930\u0932-\u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941 \u0938\u0940\u092e\u093e \u0915\u0947 \u092a\u093e\u0938 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u092e\u094b\u0939\u0915 \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924 \u0939\u0948, \u091c\u093f\u0938\u0947 \u0909\u0938\u0915\u0947 \u0938\u094d\u092b\u091f\u093f\u0915-\u0938\u094d\u092a\u0937\u094d\u091f \u091c\u0932 \u0914\u0930 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d47\u0d30\u0d33-\u0d24\u0d2e\u0d3f\u0d34\u0d4d\u0d28\u0d3e\u0d1f\u0d4d \u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d06\u0d15\u0d43\u0d37\u0d4d\u0d1f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02 \u0d06\u0d23\u0d4d \u0d38\u0d3f\u0d31\u0d41\u0d35\u0d3e\u0d23\u0d3f \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02, \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d2e\u0d3e\u0d2f \u0d1c\u0d32\u0d35\u0d41\u0d02 \u0d38\u0d28\u0d4d\u0d24\u0d41\u0d37\u0d4d\u0d1f\u0d2e\u0d3e\u0d2f \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d35\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b95\u0bc7\u0bb0\u0bb3\u0bbe-\u0ba4\u0bae\u0bbf\u0bb4\u0bcd\u0ba8\u0bbe\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bae\u0bcb\u0b95\u0bae\u0bbe\u0ba9 \u0b85\u0bb0\u0bc1\u0bb5\u0bbf, \u0b85\u0ba4\u0ba9\u0bcd \u0bb5\u0bc6\u0bb3\u0bcd\u0bb3\u0bae\u0bbe\u0ba9 \u0ba8\u0bc0\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0ba9\u0bbf\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."}],Malappuram:[{location:{long:"75.833623",lat:"11.207327"},name:"Kadalundi Bird Sanctuary",name_HI:"\u0915\u0921\u093c\u0932\u0941\u0902\u0926\u0940 \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f",name_ML:"\u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d3e\u0d35\u0d15\u0d3e\u0d36\u0d02",name_TA:"\u0b95\u0b9f\u0bb2\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf \u0baa\u0bb1\u0bb5\u0bc8\u0baf\u0bb0\u0b95\u0bae\u0bcd",note:"A scenic bird sanctuary nestled amidst mangrove forests and the Kadalundi River, known for its diverse avian species and birdwatching opportunities.",note_HI:"\u0915\u0921\u093c\u0932\u0941\u0902\u0926\u0940 \u0928\u0926\u0940 \u0914\u0930 \u092e\u0948\u0902\u0917\u094d\u0930\u094b\u0935 \u0935\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u0906\u0915\u0930\u094d\u0937\u0915 \u092a\u0915\u094d\u0937\u0940 \u0905\u092d\u092f\u093e\u0930\u0923\u094d\u092f \u0939\u0948, \u091c\u093f\u0938\u0947 \u0935\u093f\u0935\u093f\u0927 \u092a\u0915\u094d\u0937\u0940 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0914\u0930 \u092a\u0915\u094d\u0937\u0940 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0905\u0935\u0938\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f \u0d28\u0d26\u0d3f\u0d2f\u0d41\u0d02 \u0d2e\u0d1e\u0d4d\u0d1e\u0d41\u0d24\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d15\u0d33\u0d41\u0d02 \u0d07\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d05\u0d15\u0d24\u0d4d\u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d31\u0d1a\u0d4d\u0d1a\u0d41\u0d35\u0d46\u0d1a\u0d4d\u0d1a \u0d12\u0d30\u0d41 \u0d06\u0d15\u0d7c\u0d37\u0d15\u0d2e\u0d3e\u0d2f \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d3e\u0d35\u0d15\u0d3e\u0d36\u0d2e\u0d3e\u0d23\u0d4d \u0d15\u0d1f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d3f \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d3e\u0d35\u0d15\u0d3e\u0d36\u0d02, \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d2a\u0d15\u0d4d\u0d37\u0d3f \u0d2a\u0d4d\u0d30\u0d1c\u0d3e\u0d24\u0d3f\u0d15\u0d33\u0d41\u0d02 \u0d2a\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d7e \u0d15\u0d3e\u0d23\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d24\u0d15\u0d7e \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b95\u0b9f\u0bb2\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf \u0b86\u0bb1\u0bc1\u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bcd \u0bae\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b87\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0baa\u0bb1\u0bb5\u0bc8 \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0ba9 \u0baa\u0bb1\u0bb5\u0bc8 \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bb1\u0bb5\u0bc8\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0ba3 \u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"75.782554",lat:"11.171789"},name:"Beypore",name_HI:"\u092c\u0947\u092a\u094b\u0930",name_ML:"\u0d2c\u0d48\u0d2a\u0d4d\u0d2a\u0d42\u0d7c",name_TA:"\u0baa\u0bc6\u0baf\u0bcd\u0baa\u0bc2\u0bb0\u0bcd",note:"A historic port town known for its ancient shipbuilding industry, traditional wooden dhows, and a picturesque beach with fishing activities.",note_HI:"\u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u091c\u0939\u093e\u091c \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0909\u0926\u094d\u092f\u094b\u0917, \u092a\u093e\u0930\u0902\u092a\u093e\u0930\u093f\u0915 \u0d35\u0d46\u0d23\u0d4d\u0d23\u0d3e\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d15\u0d42\u0d1f\u0d41\u0d24\u0d32\u0d41\u0d02 \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d15\u0d1f\u0d32\u0d41\u0d15\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d12\u0d30\u0d41 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d38\u0d3e\u0d26\u0d4d\u0d27\u0d4d\u0d2f \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d \u0d09\u0d33\u0d4d\u0d33 \u0d10\u0924\u0d3f\u0d39\u0d3e\u0d38\u0d3f\u0d15 \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d1f\u0d57\u0d7a \u0d06\u0d23\u0d4d \u0d2c\u0d47\u0d2a\u0d4d\u0d2a\u0d42\u0d7c.",note_ML:"\u0d2a\u0d34\u0d2f \u0d15\u0d1f\u0d32\u0d4d\u200d \u0d15\u0d1f\u0d28\u0d4d\u0d28\u0d41 \u0d28\u0d3f\u0d32\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d10\u0d24\u0d3f\u0d39\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d15\u0d2a\u0d4d\u0d2a\u0d32\u0d4d\u200d \u0d28\u0d3f\u0d30\u0d4d\u200d\u0d2e\u0d4d\u0d2e\u0d3e\u0d23 \u0d38\u0d02\u0d35\u0d3f\u0d27\u0d3e\u0d28\u0d02, \u0d2a\u0d3e\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3f\u0d15\u0d2e\u0d3e\u0d2f \u0d15\u0d1f\u0d32\u0d3e\u0d23\u0d2a\u0d4d\u0d2a\u0d4b\u0d33\u0d4d\u200d\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d15\u0d1f\u0d7d \u0d2e\u0d1f\u0d19\u0d4d\u0d19\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2e\u0d32\u0d2f\u0d3e\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d38\u0d3e\u0d26\u0d4d\u0d27\u0d4d\u0d2f \u0d2a\u0d1f\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d31\u0d41\u0d15\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4b\u0d30\u0d4d\u0d1f\u0d4d\u0d1f\u0d4d \u0d1f\u0d57\u0d23\u0d3e\u0d23\u0d4d \u0d2c\u0d48\u0d2a\u0d4d\u0d2a\u0d42\u0d30\u0d4d\u200d.",note_TA:"\u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0bae\u0bb0 \u0baa\u0b9f\u0b95\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0bae\u0bb0\u0bae\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bc7\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b95\u0b9f\u0bb2\u0bcd \u0ba4\u0bc0\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0bae\u0bc0\u0ba9\u0bcd\u0bb5\u0bb3\u0bae\u0bbe\u0b95\u0bbf\u0baf \u0b90\u0ba4\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0ba4\u0bc1\u0bb1\u0bc8\u0ba8\u0b95\u0bb0\u0bae\u0bcd \u0baa\u0bc6\u0baf\u0bcd\u0baa\u0bc2\u0bb0\u0bcd \u0ba4\u0bc6\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"76.226854",lat:"11.280409"},name:"Nilambur Teak Museum",name_HI:"\u0928\u0940\u0932\u0902\u092c\u0941\u0930 \u091f\u0940\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f",name_ML:"\u0d28\u0d40\u0d32\u0d2e\u0d4d\u0d2a\u0d42\u0d7c \u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02",name_TA:"\u0ba8\u0bbf\u0bb2\u0bae\u0bcd\u0baa\u0bc2\u0bb0\u0bcd \u0ba4\u0bc7\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0b95\u0bae\u0bcd",note:"A unique museum dedicated to teak wood, showcasing different species, artifacts, furniture, and the history of teak plantations in the region.",note_HI:"\u0928\u0940\u0932\u0902\u092c\u0941\u0930 \u0932\u0915\u0921\u093c\u0940 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0932\u092f \u0939\u0948, \u091c\u094b \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902, \u0915\u0932\u093e\u0915\u0943\u0924\u093f\u092f\u094b\u0902, \u092b\u0930\u094d\u0928\u0940\u091a\u0930 \u0915\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u091f\u0940\u0915 \u092c\u093e\u0917\u0935\u093e\u0928\u0940 \u0915\u093e \u0907\u0924\u093f\u0939\u093e\u0938 \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d28\u0d40\u0d32\u0d2e\u0d4d\u0d2a\u0d42\u0d7c \u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02 \u0d0e\u0d28\u0d4d\u0d28 \u0d05\u0d26\u0d4d\u0d35\u0d3f\u0d24\u0d40\u0d2f \u0d2e\u0d4d\u0d2f\u0d42\u0d38\u0d3f\u0d2f\u0d02 \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d43\u0d15\u0d4d\u0d37\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d2a\u0d4d\u0d30\u0d1c\u0d3e\u0d24\u0d3f\u0d15\u0d7e, \u0d15\u0d32\u0d3e\u0d15\u0d3e\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d41\u0d1f\u0d46 \u0d15\u0d32\u0d3e\u0d2a\u0d1f\u0d19\u0d4d\u0d19\u0d7e, \u0d2b\u0d30\u0d4d\u200d\u0d23\u0d3f\u0d1a\u0d4d\u0d1a\u0d30\u0d41\u0d02 \u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d15\u0d33\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d24\u0d4d\u0d24\u0d46 \u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d32\u0d3e\u0d28\u0d4d\u0d31\u0d47\u0d37\u0d28\u0d41\u0d02 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d35\u0d41\u0d02 \u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0bae\u0bb0 \u0bae\u0bb0\u0baa\u0bcd\u0baa\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0b85\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0b95\u0bae\u0bbe\u0ba9 \u0b85\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0b95\u0bae\u0bcd, \u0bb5\u0bc7\u0bb1\u0bc1\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bc7\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bb0 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1 \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"75.687592",lat:"11.801105"},name:"Pazhayangadi Mosque",name_HI:"\u092a\u091c\u092f\u093e\u0902\u0917\u093e\u0926\u0940 \u092e\u0938\u094d\u091c\u093f\u0926",name_ML:"\u0d2a\u0d34\u0d2f\u0d19\u0d4d\u0d19\u0d3e\u0d1f\u0d3f \u0d2a\u0d33\u0d4d\u0d33\u0d3f",name_TA:"\u0baa\u0bb4\u0bc8\u0baf\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bbf \u0bae\u0b9a\u0bc2\u0ba4\u0bbf",note:"A famous Muslim pilgrimage site, also known as Kondotty Mosque, housing the sacred relics of Prophet Muhammad and attracting devotees from far and wide.",note_HI:"\u090f\u0915 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u092e\u0941\u0938\u094d\u0932\u093f\u092e \u0924\u0940\u0930\u094d\u0925\u0938\u094d\u0925\u0932, \u091c\u093f\u0938\u0947 \u0915\u094b\u0902\u0926\u094b\u091f\u0940 \u092e\u0938\u094d\u091c\u093f\u0926 \u092d\u0940 \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u092a\u0948\u0917\u0902\u092c\u0930 \u092e\u0941\u0939\u092e\u094d\u092e\u0926 \u0915\u0940 \u092a\u0935\u093f\u0924\u094d\u0930 \u0905\u0935\u0936\u0947\u0937 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0926\u0942\u0938\u0930\u0947 \u0914\u0930 \u0926\u0942\u0938\u0930\u0947 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0938\u0947 \u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",note_ML:"\u0d2a\u0d34\u0d2f\u0d19\u0d4d\u0d19\u0d3e\u0d1f\u0d3f \u0d2a\u0d33\u0d4d\u0d33\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d2e\u0d41\u0d38\u0d4d\u0d32\u0d3f\u0d02 \u0d2a\u0d30\u0d4d\u0d2f\u0d1f\u0d28 \u0d38\u0d4d\u0d25\u0d32\u0d02, \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f \u0d2e\u0d38\u0d4d\u0d1c\u0d3f\u0d26\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d, \u0d2a\u0d4d\u0d30\u0d35\u0d23\u0d24\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d35\u0d3f\u0d24\u0d4d\u0d30 \u0d05\u0d35\u0d36\u0d3f\u0d37\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33\u0d41\u0d33\u0d4d\u0d33\u0d42\u0d23\u0d4d\u0d1f\u0d4d \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d1f\u0d4d \u0d2a\u0d33\u0d4d\u0d33\u0d3f\u0d2f\u0d3e\u0d23\u0d4d, \u0d35\u0d32\u0d3f\u0d2f\u0d15\u0d4d\u0d15\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u0d2a\u0d41\u0d35\u0d3e\u0d2f \u0d05\u0d2a\u0d4d\u0d2a\u0d41\u0d02\u0d2e\u0d3e\u0d2e\u0d19\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d06\u0d15\u0d30\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0bbe\u0b9a\u0baf\u0b99\u0bcd\u0b95\u0bbe\u0b9f\u0bbf \u0bae\u0b9a\u0bc2\u0ba4\u0bbf, \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0b87\u0b9f\u0bae\u0bcd, \u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc8 \u0bae\u0b9a\u0bc2\u0ba4\u0bbf \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1, \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0b85\u0bb0\u0bc1\u0bb3\u0bcd\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bca\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bb1\u0bcd\u0bb1 \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0b9f\u0bc8\u0b95\u0bb3\u0bc8 \u0b86\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"75.926638",lat:"11.106978"},name:"Thirunavaya",name_HI:"\u0924\u093f\u0930\u0941\u0928\u093e\u0935\u093e\u092f\u093e",name_ML:"\u0d24\u0d3f\u0d30\u0d41\u0d28\u0d3e\u0d35\u0d3e\u0d2f",name_TA:"\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bbe\u0bb5\u0bbe\u0baf\u0bbe",note:"An ancient cultural and pilgrimage center on the banks of the Bharathapuzha River, known for the Thirunavaya Navamukunda Temple and the annual Mamankam festival.",note_HI:"\u092d\u093e\u0930\u0924\u092a\u0941\u091c\u093e \u0928\u0926\u0940 \u0915\u0947 \u0924\u091f \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0914\u0930 \u0924\u0940\u0930\u094d\u0925\u0938\u094d\u0925\u0932, \u091c\u0939\u093e\u0902 \u0924\u093f\u0930\u0941\u0928\u093e\u0935\u093e\u092f\u093e \u0928\u0935\u092e\u0941\u0915\u0941\u0902\u0926\u093e \u092e\u0902\u0926\u093f\u0930 \u0914\u0930 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092e\u093e\u092e\u0902\u0915\u092e \u0924\u094d\u092f\u094b\u0939\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d24\u0d3f\u0d30\u0d41\u0d28\u0d3e\u0d35\u0d3e\u0d2f \u0d2d\u0d3e\u0d30\u0d24\u0d2a\u0d41\u0d34\u0d2f\u0d41\u0d1f\u0d46 \u0d24\u0d40\u0d30\u0d24\u0d4d\u0d24\u0d41 \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d28\u0d3f\u0d30\u0d4d\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28\u0d2e\u0d3e\u0d2f \u0d38\u0d3e\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d3f\u0d15 \u0d38\u0d4d\u0d25\u0d32\u0d02, \u0d24\u0d3f\u0d30\u0d41\u0d28\u0d3e\u0d35\u0d3e\u0d2f \u0d28\u0d35\u0d2e\u0d41\u0d15\u0d41\u0d23\u0d4d\u0d1f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d35\u0d41\u0d02 \u0d35\u0d3e\u0d7c\u0d37\u0d3f\u0d15 \u0d2e\u0d3e\u0d2e\u0d19\u0d4d\u0d15\u0d02 \u0d15\u0d3e\u0d32\u0d02 \u0d2e\u0d41\u0d24\u0d7d \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0baa\u0bbe\u0bb0\u0ba4\u0baa\u0bc1\u0b9a\u0bbe \u0b86\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0ba4\u0bc0\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0baa\u0bb4\u0bc8\u0baf \u0ba8\u0b95\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bbe\u0bb5\u0bbe\u0baf\u0bbe \u0ba8\u0bb5\u0bae\u0bc1\u0b95\u0bc1\u0ba3\u0bcd\u0b9f \u0b95\u0bcb\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0ba4\u0bbe\u0bb0\u0bae\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0ba4\u0bc6\u0bb0\u0bbf\u0baf\u0bc1\u0bae\u0bcd."},{location:{long:"75.950027",lat:"11.255738"},name:"Kottakkunnu",name_HI:"\u0915\u094b\u091f\u094d\u091f\u0915\u094d\u0915\u0941\u0928\u094d\u0928\u0941",name_ML:"\u0d15\u0d4a\u0d1f\u0d4d\u0d1f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d4d",name_TA:"\u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0ba9\u0bcd\u0ba9\u0bc1",note:"A hill garden with a panoramic view of Malappuram town, featuring a children's park, an open-air theater, and a historical fort called Kottakkal Fort.",note_HI:"\u090f\u0915 \u092a\u0939\u093e\u0921\u093c\u0940 \u0909\u0926\u094d\u092f\u093e\u0928 \u091c\u093f\u0938\u092e\u0947\u0902 \u092e\u0932\u092a\u094d\u092a\u0941\u0930\u092e \u0936\u0939\u0930 \u0915\u093e \u090f\u0915 \u092a\u0948\u0928\u094b\u0930\u093e\u092e\u093f\u0915 \u0926\u0943\u0936\u094d\u092f \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u090f\u0915 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u093e \u092a\u093e\u0930\u094d\u0915, \u090f\u0915 \u0916\u0941\u0932\u0947 \u0906\u0915\u093e\u0936 \u092e\u0947\u0902 \u0925\u093f\u092f\u0947\u091f\u0930, \u0914\u0930 \u0915\u094b\u091f\u094d\u091f\u0915\u094d\u0915\u0932 \u0926\u0941\u0930\u094d\u0917 \u0915\u0939\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0915\u093f\u0932\u093e \u0939\u0948\u0964",note_ML:"\u0d2e\u0d32\u0d2a\u0d4d\u0d2a\u0d41\u0d31\u0d02 \u0d28\u0d17\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d3e\u0d28\u0d4b\u0d30\u0d3e\u0d2e\u0d3f\u0d15\u0d4d \u0d15\u0d3e\u0d34\u0d4d\u0d1a\u0d4d\u0d1a\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2e\u0d32\u0d2f\u0d41\u0d1f\u0d46 \u0d09\u0d26\u0d4d\u0d2f\u0d3e\u0d28\u0d02, \u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d, \u0d12\u0d2a\u0d4d\u0d2a\u0d40\u0d7b \u0d0e\u0d2f\u0d7c \u0d24\u0d3f\u0d2f\u0d47\u0d31\u0d4d\u0d31\u0d7c, \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d15\u0d4d\u0d15\u0d32\u0d4d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d05\u0d1f\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d3e\u0d24\u0d40\u0d24 \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d2f\u0d3e\u0d23\u0d4d.",note_TA:"\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0bae\u0bcd \u0ba8\u0b95\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0ba9\u0bcb\u0bb0\u0bbe\u0bae\u0bbf\u0b95\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0bb2\u0bc8 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe, \u0b95\u0bc1\u0bb4\u0ba8\u0bcd\u0ba4\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0bc2\u0b99\u0bcd\u0b95\u0bbe, \u0bb5\u0bc6\u0bb3\u0bbf\u0bb5\u0bbe\u0baf\u0bcd \u0ba4\u0bbf\u0bb0\u0bc8\u0baf\u0bb0\u0b99\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b85\u0b9f\u0bbf\u0baf\u0bbe\u0bb0\u0bbf\u0baf\u0b95\u0bcd\u0b95\u0bbe\u0bb2\u0baa\u0bcd \u0baa\u0bc7\u0bb0\u0bbe\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bbf \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"76.197458",lat:"11.450062"},name:"Adyanpara Waterfalls",name_HI:"\u0906\u0926\u094d\u092f\u093e\u0928\u094d\u092a\u093e\u0930\u093e \u091c\u0932\u092a\u094d\u0930\u092a\u093e\u0924",name_ML:"\u0d05\u0d26\u0d4d\u0d2f\u0d28\u0d4d\u0d2a\u0d3e\u0d30 \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d1a\u0d4d\u0d1a\u0d3e\u0d1f\u0d4d\u0d1f\