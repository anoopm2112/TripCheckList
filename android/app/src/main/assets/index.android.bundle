0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932\u0940 \u092e\u0938\u094d\u091c\u093f\u0926, \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0906\u0938\u092a\u093e\u0938 \u0915\u0947 \u0914\u0930 \u0926\u0943\u0936\u094d\u092f\u092e\u092f\u0924\u093e \u0915\u0940 \u0938\u0941\u0902\u0926\u0930\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",note_ML:"\u0d27\u0d30\u0d4d\u200d\u0d2e\u0d26\u0d02 \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d3f\u0d32\u0d4d\u200d \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d35\u0d3f\u0d2e\u0d4b\u0d39\u0d28\u0d3e\u0d15\u0d3e\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d33\u0d4d\u0d33\u0d3f, \u0d38\u0d28\u0d4d\u0d24\u0d4b\u0d37\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\u0d2f \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d38\u0d3f\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0ba4\u0bb0\u0bcd\u0bae\u0ba4\u0bae\u0bcd \u0ba4\u0bc0\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0baa\u0bc6\u0bb1\u0bcd\u0bb1 \u0bae\u0b9a\u0bc2\u0ba4\u0bbf, \u0b85\u0bae\u0bc8\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bb3\u0bb5\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb2\u0bc8\u0bae\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0b85\u0bb0\u0bc1\u0bb5\u0bbf \u0baa\u0bc6\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."}],Kasaragod:[{name:"Bekal Fort",name_HI:"\u092c\u0947\u0915\u0932 \u0915\u093f\u0932\u093e",name_ML:"\u0d2c\u0d47\u0d15\u0d4d\u0d15\u0d32\u0d4d\u200d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f",name_TA:"\u0baa\u0bc7\u0b95\u0bb2\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8",note:"An ancient fort overlooking the Arabian Sea, known for its impressive architecture, panoramic views, and the annual Bekal Utsav.",note_HI:"\u0905\u0930\u092c \u0938\u093e\u0917\u0930 \u0915\u094b \u0926\u0947\u0916\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u093f\u0932\u093e, \u091c\u093f\u0938\u0947 \u0909\u0938\u0915\u0947 \u092a\u094d\u0930\u092d\u093e\u0935\u0936\u093e\u0932\u0940 \u0938\u094d\u0925\u093e\u092a\u0924\u094d\u092f\u0915\u0932\u093e, \u092a\u0948\u0928\u094b\u0930\u093e\u092e\u093f\u0915 \u0926\u0943\u0936\u094d\u092f \u0914\u0930 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092c\u0947\u0915\u0932 \u0909\u0924\u094d\u0938\u0935 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d05\u0d31\u0d2c\u0d3f\u0d15\u0d4d\u0d15\u0d1f\u0d32\u0d4d\u200d \u0d15\u0d3e\u0d23\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d2f\u0d3e\u0d23\u0d4d \u0d2c\u0d47\u0d15\u0d4d\u0d15\u0d7d, \u0d05\u0d24\u0d3f\u0d26\u0d4d\u0d26\u0d48\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d35\u0d30\u0d42\u0d2a\u0d24\u0d4d\u0d24\u0d47\u0d3e\u0d1f\u0d41\u0d02 \u0d2a\u0d3e\u0d28\u0d4b\u0d30\u0d3e\u0d2e\u0d3f\u0d15\u0d4d \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d47\u0d3e\u0d1f\u0d41\u0d02, \u0d35\u0d3e\u0d30\u0d4d\u200d\u0d37\u0d3f\u0d15 \u0d2c\u0d47\u0d15\u0d4d\u0d15\u0d7d \u0d09\u0d24\u0d4d\u0d38\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:"\u0b85\u0bb0\u0baa\u0bbf\u0baf\u0baa\u0bcd \u0baa\u0bc1\u0bb1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0baa\u0bb4\u0bc8\u0baf \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8, \u0b85\u0ba4\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0baa\u0bcd \u0baa\u0bb0\u0bae\u0bbe\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0baa\u0bbe\u0ba9\u0bcb\u0bb0\u0bbe\u0bae\u0bbf\u0b95\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bb3\u0bcd, \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"75.123694",lat:"12.403304"},name:"Bekal Beach",name_HI:"\u092c\u0947\u0915\u0932 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f",name_ML:"\u0d2c\u0d47\u0d15\u0d4d\u0d15\u0d7d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0baa\u0bc7\u0b95\u0bb2\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A scenic beach adjacent to Bekal Fort, offering breathtaking views, serene surroundings, and a perfect spot for relaxation.",note_HI:"\u092c\u0947\u0915\u0932 \u0915\u093f\u0932\u0947 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094d\u0925\u0932\u0940\u092f \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f, \u091c\u094b \u0930\u094b\u092e\u093e\u0902\u091a\u0915\u093e\u0930\u0940 \u0926\u0943\u0936\u094d\u092f\u094b\u0902, \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0906\u0938\u092a\u093e\u0938 \u0914\u0930 \u0906\u0930\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0906\u0926\u0930\u094d\u0936 \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2c\u0d47\u0d15\u0d4d\u0d15\u0d7d \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d41\u0d31\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d30\u0d2e\u0d3e\u0d2f \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d, \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d2f\u0d3e\u0d2f \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d2a\u0d30\u0d3f\u0d38\u0d30\u0d35\u0d41\u0d02, \u0d06\u0d30\u0d3e\u0d2e\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d2a\u0d3e\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d25\u0d32\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0baa\u0bc7\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0bae\u0bb0\u0bbf\u0baf\u0bbe\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0b9f\u0bbe\u0bae\u0bb0\u0bc8 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8, \u0b85\u0bb4\u0b95\u0bbe\u0ba9 \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bae\u0bc1\u0bae\u0bcd, \u0bae\u0bc6\u0baf\u0bcd\u0bae\u0bcd\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0b87\u0b9f\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd."},{location:{long:"75.123064",lat:"12.407787"},name:"Valiyaparamba Backwaters",name_HI:"\u0935\u093e\u0932\u093f\u092f\u093e\u092a\u093e\u0930\u092e\u094d\u092c\u093e \u092c\u0948\u0915\u0935\u093e\u091f\u0930\u094d\u0938",name_ML:"\u0d35\u0d3e\u0d33\u0d3f\u0d2f\u0d2a\u0d31\u0d2e\u0d4d\u0d2a\u0d4d \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d\u200c\u0d35\u0d4b\u0d1f\u0d4d\u0d1f\u0d47\u0d34\u0d4d\u200c\u0d38\u0d4d",name_TA:"\u0bb5\u0bbe\u0bb2\u0bbf\u0baf\u0baa\u0bb1\u0bae\u0bcd\u0baa\u0bbe \u0baa\u0bc7\u0b95\u0bcd\u0bb5\u0bbe\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd\u0bb8\u0bcd",note:"A scenic backwater stretch with islands, coconut groves, and tranquil waters, ideal for houseboat cruises and fishing.",note_HI:"\u090f\u0915 \u091a\u093f\u0924\u094d\u0930\u0938\u094c\u092d\u093e\u0917\u094d\u092f\u092a\u0942\u0930\u094d\u0923 \u092c\u0948\u0915\u0935\u093e\u091f\u0930\u094d\u0938 \u0938\u094d\u091f\u094d\u0930\u0947\u091a \u091c\u093f\u0938\u092e\u0947\u0902 \u0926\u094d\u0935\u0940\u092a, \u0928\u093e\u0930\u093f\u092f\u0932 \u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0914\u0930 \u0936\u093e\u0902\u0924 \u091c\u0932 \u0939\u0948\u0902, \u091c\u0939\u093e\u0902 \u0918\u0930\u092c\u093e\u091f \u092a\u0930\u094d\u092f\u091f\u0928 \u0914\u0930 \u092e\u091b\u0932\u0940 \u092a\u0915\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0926\u0930\u094d\u0936 \u0939\u0948\u0902\u0964",note_ML:"\u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d24\u0d46\u0d19\u0d4d\u0d19\u0d3f\u0d28\u0d40\u0d30\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d30\u0d3f\u0d2f\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d05\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d38\u0d57\u0d28\u0d4d\u0d26\u0d30\u0d4d\u0d2f\u0d02 \u0d09\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d4d, \u0d39\u0d57\u0d38\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d15\u0d4d\u0d30\u0d42\u0d38\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2e\u0d40\u0d7b\u0d2a\u0d3f\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d09\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d4d \u0d05\u0d24\u0d3f\u0d36\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d.",note_TA:"\u0ba4\u0bc0\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0ba4\u0bc6\u0b99\u0bcd\u0b95\u0ba8\u0bc0\u0bb0\u0bbf\u0ba9\u0bcd \u0b85\u0b95\u0bb0\u0bbe\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0b85\u0bb4\u0b95\u0bbf\u0baf \u0baa\u0bc7\u0b95\u0bcd\u0bb5\u0bbe\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd\u0bb8\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bbe\u0bb0\u0bae\u0bcd, \u0bb9\u0bb5\u0bc1\u0bb8\u0bcd\u0baa\u0bcb\u0b9f\u0bcd \u0b95\u0baa\u0bcd\u0baa\u0bb2\u0bcd \u0baa\u0baf\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc0\u0ba9\u0bcd\u0bb5\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0baf\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1."},{location:{long:"75.135119",lat:"12.023642"},name:"Ananthapura Lake Temple",name_HI:"\u0905\u0928\u0928\u094d\u0924\u092a\u0941\u0930\u093e \u091d\u0940\u0932 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d05\u0d28\u0d28\u0d4d\u0d24\u0d2a\u0d41\u0d30 \u0d2a\u0d47\u0d30\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d3e\u0d35\u0d4d \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0b85\u0ba9\u0ba8\u0bcd\u0ba4\u0baa\u0bc1\u0bb0\u0bbe \u0b8f\u0bb0\u0bbf \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd",note:"A unique temple located on a lake island, known for its ancient architecture, religious significance, and the presence of a crocodile named 'Babiya'.",note_HI:"\u091d\u0940\u0932 \u0915\u0947 \u090f\u0915 \u0926\u094d\u0935\u0940\u092a \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u092e\u0902\u0926\u093f\u0930, \u091c\u093f\u0938\u0947 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0914\u0930 '\u092c\u092c\u093f\u092f\u093e' \u0928\u093e\u092e\u0915 \u090f\u0915 \u092e\u0917\u0930\u092e\u091a\u094d\u091b \u0915\u0940 \u092e\u094c\u091c\u0942\u0926\u0917\u0940 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d12\u0d30\u0d41 \u0d15\u0d1f\u0d7d \u0d26\u0d4d\u0d35\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d05\u0d28\u0d41\u0d37\u0d4d\u0d20\u0d3e\u0d28\u0d02 \u0d2e\u0d23\u0d4d\u0d21\u0d32\u0d02, \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d35\u0d41\u0d02, \u0d2e\u0d24\u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d35\u0d41\u0d02, '\u0d2c\u0d2c\u0d3f\u0d2f' \u0d0e\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d41\u0d17\u0d41\u0d33\u0d1a\u0d4d\u0d1a\u0d46\u0d1f\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b8f\u0bb0\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb0\u0bc1 \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd, \u0baa\u0bbf\u0bb0\u0bbe\u0b9a\u0bbe\u0ba4 \u0b95\u0bb2\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0bae\u0ba4 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bc1\u0bae\u0bcd, '\u0baa\u0baa\u0bbf\u0baf\u0bbe' \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0bc1\u0ba4\u0bb2\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u0baa\u0bb8\u0bcd\u0ba4\u0bbf\u0ba4\u0bbf \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."},{location:{long:"75.084963",lat:"12.574495"},name:"Madhur Temple",name_HI:"\u092e\u0927\u0941\u0930 \u092e\u0902\u0926\u093f\u0930",name_ML:"\u0d2e\u0d27\u0d41\u0d30\u0d4d\u200d \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02",name_TA:"\u0bae\u0ba4\u0bc1\u0bb0\u0bcd \u0b95\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd",note:"A centuries-old temple dedicated to Lord Shiva, known for its exquisite architecture, intricate carvings, and the annual Madhur Mahotsavam festival.",note_HI:"\u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u090f\u0915 \u0938\u0926\u093f\u092f\u094b\u0902 \u092a\u0941\u0930\u093e\u0928\u093e \u092e\u0902\u0926\u093f\u0930, \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e, \u091c\u091f\u093f\u0932 \u0928\u0915\u094d\u0915\u093e\u0936\u0940, \u0914\u0930 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092e\u0927\u0941\u0930 \u092e\u0939\u094b\u0924\u094d\u0938\u0935\u092e \u0924\u094d\u092f\u094b\u0939\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2d\u0d17\u0d35\u0d3e\u0d28\u0d4d\u200d \u0d36\u0d3f\u0d35\u0d28\u0d4d\u200d \u0d05\u0d30\u0d4d\u200d\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d42\u0d31\u0d4d\u0d31\u0d3e\u0d23\u0d4d\u0d1f\u0d41\u0d15\u0d33\u0d4d\u200d\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f \u0d28\u0d3f\u0d30\u0d4d\u200d\u0d2e\u0d4d\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d15\u0d4d\u0d37\u0d47\u0d24\u0d4d\u0d30\u0d02, \u0d05\u0d24\u0d3f\u0d38\u0d41\u0d28\u0d4d\u0d26\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d3e\u0d38\u0d4d\u0d24\u0d41\u0d36\u0d3f\u0d32\u0d4d\u0d2a\u0d02, \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d4d\u0d2e\u0d2e\u0d3e\u0d2f \u0d28\u0d15\u0d4d\u0d15\u0d3e\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02, \u0d35\u0d3e\u0d30\u0d4d\u200d\u0d37\u0d3f\u0d15 \u0d2e\u0d27\u0d41\u0d30\u0d4d\u200d \u0d2e\u0d39\u0d4b\u0d24\u0d4d\u0d38\u0d35\u0d02 \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d4d\u200d \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:"\u0b9a\u0bbf\u0bb5\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bbf\u0bb2\u0bc8 \u0b86\u0bb1\u0bc1\u0bae\u0bc1\u0b95\u0bae\u0bcd, \u0bae\u0bbf\u0b95\u0b9a\u0bcd \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1, \u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b95\u0bb2\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0bae\u0bc2\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bbe\u0bb0\u0bcd\u0bb5\u0bbf\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0bb5\u0bbe\u0bb0\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bae\u0ba4\u0bc1\u0bb0\u0bcd \u0bae\u0b95\u0bcb\u0ba4\u0bcd\u0bb8\u0bb5 \u0bb5\u0bbf\u0bb4\u0bbe\u0bb5\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"75.155879",lat:"12.444867"},name:"Ranipuram",name_HI:"\u0930\u093e\u0928\u0940\u092a\u0941\u0930\u092e",name_ML:"\u0d31\u0d3e\u0d23\u0d3f\u0d2a\u0d41\u0d30\u0d02",name_TA:"\u0bb0\u0bbe\u0ba3\u0bbf\u0baa\u0bc1\u0bb0\u0bae\u0bcd",note:"A beautiful hill station known for its mist-covered hills, lush green forests, trekking trails, and panoramic views of the Western Ghats.",note_HI:"\u0927\u0941\u0902\u0927\u0932\u0947 \u0922\u0915\u0947 \u0939\u093f\u0932\u094d\u0938, \u0939\u0930\u093e-\u092d\u0930\u093e \u091c\u0902\u0917\u0932, \u091f\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u091f\u094d\u0930\u0947\u0932\u094d\u0938, \u0914\u0930 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0918\u093e\u091f \u0915\u0947 \u092a\u0948\u0928\u094b\u0930\u0947\u092e\u093f\u0915 \u0928\u091c\u093c\u093e\u0930\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u092a\u0939\u093e\u0921\u093c\u0940 \u0938\u094d\u091f\u0947\u0936\u0928\u0964",note_ML:"\u0d2e\u0d34\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d4d\u200d \u0d2e\u0d42\u0d1f\u0d3f\u0d2f \u0d2e\u0d32\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d42\u0d35\u0d41\u0d02 \u0d15\u0d3e\u0d1f\u0d41\u0d15\u0d33\u0d41\u0d02, \u0d1f\u0d4d\u0d30\u0d46\u0d15\u0d4d\u0d15\u0d3f\u0d19\u0d4d\u0d19\u0d4d \u0d1f\u0d4d\u0d30\u0d46\u0d2f\u0d3f\u0d32\u0d41\u0d15\u0d33\u0d41\u0d02, \u0d2a\u0d1f\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d31\u0d7b \u0d18\u0d3e\u0d1f\u0d4d\u0d1f\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d3e\u0d28\u0d4b\u0d30\u0d3e\u0d2e\u0d3f\u0d15\u0d4d \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d2e\u0d28\u0d4b\u0d39\u0d30 \u0d2e\u0d32\u0d2f\u0d3e\u0d1f\u0d4d.",note_TA:"\u0bae\u0bc2\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bb2\u0bc8\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0baa\u0b9a\u0bcd\u0b9a\u0bc8\u0baf\u0bbe\u0ba9 \u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0b9a\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe\u0bb2\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bc0\u0bb4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0bbf\u0bb0\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bb2\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9."},{location:{long:"75.079489",lat:"12.505831"},name:"Chandragiri Fort",name_HI:"\u091a\u0902\u0926\u094d\u0930\u0917\u093f\u0930\u0940 \u0915\u093f\u0932\u093e",name_ML:"\u0d1a\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d17\u0d3f\u0d30\u0d3f \u0d15\u0d4b\u0d1f\u0d4d\u0d1f",name_TA:"\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b95\u0bbf\u0bb0\u0bbf \u0b95\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8",note:"A historic fort located on the banks of the Chandragiri River, offering scenic views of the river and the surrounding landscapes.",note_HI:"\u091a\u0902\u0926\u094d\u0930\u0917\u093f\u0930\u0940 \u0928\u0926\u0940 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0938\u094d\u0925\u093f\u0924 \u090f\u0915 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0915\u093f\u0932\u093e, \u091c\u094b \u0928\u0926\u0940 \u0914\u0930 \u0906\u0938\u092a\u093e\u0938 \u0915\u0947 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0915\u0940 \u092e\u0939\u0924\u094d\u0935\u093e\u0915\u093e\u0902\u0915\u094d\u0937\u0940 \u0926\u0943\u0936\u094d\u092f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d1a\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d17\u0d3f\u0d30\u0d3f \u0d2a\u0d1f\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d31\u0d7b \u0d15\u0d3f\u0d28\u0d3e\u0d30\u0d46 \u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d15\u0d4b\u0d1f\u0d4d\u0d1f\u0d2f\u0d3e\u0d23\u0d4d, \u0d28\u0d26\u0d3f\u0d2f\u0d41\u0d02 \u0d06\u0d38\u0d4d\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d30\u0d3f\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"75.101253",lat:"12.576697"},name:"Kappil Beach",name_HI:"\u0915\u092a\u094d\u092a\u093f\u0932 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f",name_ML:"\u0d15\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A serene beach where the Kappil River meets the Arabian Sea, known for its picturesque setting and tranquil atmosphere.",note_HI:"\u090f\u0915 \u0936\u093e\u0902\u0924 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f \u091c\u0939\u093e\u0902 \u0915\u092a\u094d\u092a\u093f\u0932 \u0928\u0926\u0940 \u0905\u0930\u092c \u0938\u093e\u0917\u0930 \u0938\u0947 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948, \u091c\u093f\u0938\u0947 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930\u0940 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0914\u0930 \u0936\u093e\u0902\u0924 \u092e\u093e\u0939\u094c\u0932 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d15\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d2a\u0d1f\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d31\u0d7b \u0d28\u0d26\u0d3f \u0d05\u0d31\u0d2c\u0d3f\u0d15\u0d4d\u0d15\u0d1f\u0d32\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d28\u0d4d\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d38\u0d28\u0d4d\u0d27\u0d4d\u0d2f\u0d3e \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d3e\u0d23\u0d4d, \u0d2a\u0d1f\u0d2f\u0d4b\u0d1f\u0d4d\u0d1f\u0d02\u0d17\u0d2e\u0d3e\u0d2f \u0d35\u0d47\u0d1f\u0d4d\u0d1f\u0d2f\u0d41\u0d02 \u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d31\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",note_TA:""},{location:{long:"75.098971",lat:"12.670051"},name:"Kanwatheertha Beach",name_HI:"\u0915\u0928\u094d\u0935\u0925\u0940\u0930\u094d\u0925 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f",name_ML:"\u0d15\u0d28\u0d4d\u0d35\u0d25\u0d40\u0d7c\u0d24\u0d4d\u0d24 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d",name_TA:"\u0b95\u0ba3\u0bcd\u0bb5\u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4 \u0b95\u0b9f\u0bb1\u0bcd\u0b95\u0bb0\u0bc8",note:"A secluded beach with a natural swimming pool formed by the sea, surrounded by cliffs and a tranquil ambiance.",note_HI:"\u090f\u0915 \u090f\u0915\u093e\u0902\u0924 \u0938\u092e\u0941\u0926\u094d\u0930 \u0924\u091f \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u092e\u0941\u0926\u094d\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u090f\u0915 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0938\u094d\u0935\u093f\u092e\u093f\u0902\u0917 \u092a\u0942\u0932 \u0939\u0948, \u091c\u094b \u091a\u091f\u094d\u091f\u093e\u0928\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0918\u093f\u0930\u093e \u0939\u0941\u0906 \u0939\u0948 \u0914\u0930 \u090f\u0915 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0939\u0948\u0964",note_ML:"\u0d15\u0d1f\u0d32\u0d3e\u0d34\u0d4d\u0d1a \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d3e\u0d2f \u0d2a\u0d42\u0d7e\u0d28\u0d15\u0d41\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3f\u0d1f\u0d2f\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d28\u0d28\u0d4d\u0d24\u0d30 \u0d15\u0d1f\u0d32\u0d3e\u0d34\u0d4d\u0d1a \u0d05\u0d1f\u0d3f\u0d2e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d0f\u0d24\u0d4d\u0d24\u0d41\u0d2e\u0d23\u0d4d\u0d23\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d2c\u0d40\u0d1a\u0d4d\u0d1a\u0d4d \u0d06\u0d23\u0d4d, \u0d12\u0d30\u0d41 \u0d36\u0d3e\u0d28\u0d4d\u0d24 \u0d35\u0d3e\u0d24\u0d3e\u0d35\u0d30\u0d23\u0d35\u0d41\u0d02 \u0d2a\u0d1f\u0d2f\u0d4b\u0d1f\u0d4d\u0d1f\u0d35\u0d41\u0d02 \u0d15\u0d42\u0d1f\u0d3f\u0d2f\u0d3e\u0d23\u0d4d \u0d05\u0d1f\u0d2f\u0d3e\u0d33\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d.",note_TA:""},{location:{long:"75.193815",lat:"12.064949"},name:"Malik Deenar Mosque",name_HI:"\u092e\u093e\u0932\u093f\u0915 \u0926\u0940\u0928\u093e\u0930 \u092e\u0938\u094d\u091c\u093f\u0926",name_ML:"\u0d2e\u0d3e\u0d32\u0d3f\u0d15\u0d4d \u0d26\u0d40\u0d28\u0d3e\u0d7c \u0d2a\u0d33\u0d4d\u0d33\u0d3f",name_TA:"\u0bae\u0bbe\u0bb2\u0bbf\u0b95\u0bcd \u0ba4\u0bc0\u0ba9\u0bbe\u0bb0\u0bcd \u0baa\u0bb3\u0bcd\u0bb3\u0bbf",note:"An ancient mosque believed to be the final resting place of Malik Ibn Dinar, a prominent Islamic scholar, known for its architectural beauty and religious significance.",note_HI:"\u092e\u093e\u0928\u094d\u092f\u0924\u093e\u0928\u0941\u0938\u093e\u0930 \u092e\u093e\u0932\u093f\u0915 \u0907\u092c\u094d\u0928 \u0926\u0940\u0928\u093e\u0930, \u090f\u0915 \u092a\u094d\u0930\u092e\u0941\u0916 \u0907\u0938\u094d\u0932\u093e\u092e\u0940 \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e \u0906\u0930\u093e\u092e \u0938\u094d\u0925\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092e\u0938\u094d\u091c\u093f\u0926, \u091c\u093f\u0938\u0947 \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0914\u0930 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",note_ML:"\u0d2e\u0d3e\u0d32\u0d3f\u0d15\u0d4d \u0d07\u0d2c\u0d4d\u0d28\u0d41\u0d26\u0d40\u0d28\u0d3e\u0d30\u0d4d, \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16 \u0d07\u0d38\u0d4d\u0d32\u0d3e\u0d2e\u0d3f\u0d15 \u0d2a\u0d23\u0d4d\u0d21\u0d3f\u0d24\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d28\u0d4d\u0d24\u0d3f\u0d2e \u0d2a\u0d41\u0d15\u0d34\u0d4d\u0d24\u0d4d\u0d24\u0d3e\u0d2f\u0d24\u0d3f\u0d28\u0d46\u0d24\u0d3f\u0d30\u0d46 \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d35\u0d3f\u0d36\u0d4d\u0d35\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d3e\u0d1a\u0d40\u0d28 \u0d2e\u0d38\u0d4d\u0d1c\u0d3f\u0d26\u0d4d, \u0d06\u0d15\u0d43\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d2e\u0d24\u0d2a\u0d4d\u0d30\u0d3e\u0d27\u0d3e\u0d28\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d36\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d.",note_TA:""}]}},1671,[]);
