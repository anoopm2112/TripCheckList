40 \u0926\u094d\u0935\u093e\u0930\u093e 20% \u092c\u091a\u0924 \u091c\u094b\u0921\u093c\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948",info_3:"\u0928\u093f\u092e\u094d\u0928-\u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u0947 \u092a\u0947\u091f\u094d\u0930\u094b\u0932 \u0938\u0947 10% \u0915\u0940 \u092c\u091a\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948",info_4:"\u0932\u094b \u092c\u0940\u092e/\u0939\u093e\u0908 \u092c\u0940\u092e \u092e\u0947\u0902 5% \u0915\u0940 \u092c\u091a\u0924",info_5:"\u0915\u093e\u0930 \u0915\u0940 \u0924\u0915\u0928\u0940\u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u093e \u0928 \u092d\u0942\u0932\u0947\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0916\u0930\u093e\u092c\u0940, \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \u090f\u0915 \u092d\u0930\u093e \u0939\u0941\u0906 \u0908\u0902\u0927\u0928 \u092b\u093f\u0932\u094d\u091f\u0930 \u092f\u093e \u0915\u092e \u091f\u093e\u092f\u0930 \u0915\u093e \u0926\u092c\u093e\u0935 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0908\u0902\u0927\u0928 \u0915\u0940 \u0916\u092a\u0924 \u0915\u094b \u092c\u0922\u093c\u093e \u0938\u0915\u0924\u093e \u0939\u0948!",fuel_price_val:"\u0915\u0943\u092a\u092f\u093e \u0908\u0902\u0927\u0928 \u092e\u0942\u0932\u094d\u092f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",mileage_val:"\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0907\u0932\u0947\u091c \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",distance_val:"\u0915\u0943\u092a\u092f\u093e \u0926\u0942\u0930\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",cost_val:"\u0915\u0943\u092a\u092f\u093e \u0932\u093e\u0917\u0924 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",cost_help_inof:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0908\u0902\u0927\u0928 \u0915\u0940 \u0915\u0940\u092e\u0924, \u092e\u093e\u0907\u0932\u0947\u091c \u0914\u0930 \u0926\u0942\u0930\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u0926\u0942\u0930\u0940, \u092e\u093e\u0907\u0932\u0947\u091c \u0914\u0930 \u0932\u093e\u0917\u0924 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},AboutUs:{AboutUs:"\u0939\u092e\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902"},ContactUs:{contactUs:"\u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902",subject:"\u0935\u093f\u0937\u092f",enter_subject:"\u0915\u0943\u092a\u092f\u093e \u0935\u093f\u0937\u092f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",enter_message:"\u0915\u0943\u092a\u092f\u093e \u0938\u0902\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",enter_your_subject:"\u0905\u092a\u0928\u093e \u0935\u093f\u0937\u092f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",enter_your_message:"\u0905\u092a\u0928\u093e \u0938\u0902\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",message:"\u0938\u0902\u0926\u0947\u0936",send:"\u092d\u0947\u091c\u0928\u093e"},Help:{help:"\u092e\u0926\u0926",takeTour:"\u091f\u0947\u0915 \u091f\u0942\u0930"},Logout:{logout:"\u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0947\u0902"},Quotes:{quote_1:"\u090f\u0915 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0924\u0948\u092f\u093e\u0930 \u092f\u093e\u0924\u094d\u0930\u0940 \u090f\u0915 \u0906\u0924\u094d\u092e\u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0940 \u0938\u093e\u0939\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u092f\u0939 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u092a \u0915\u092d\u0940 \u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u091a\u0940\u091c\u094b\u0902 \u0915\u094b \u092a\u0940\u091b\u0947 \u0928 \u091b\u094b\u0921\u093c\u0947\u0902, \u091c\u093f\u0938\u0938\u0947 \u0906\u092a\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u090f\u0915 \u091a\u093f\u0902\u0924\u093e \u092e\u0941\u0915\u094d\u0924 \u0905\u0928\u0941\u092d\u0935 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964",quote_2:"\u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u090f\u0915 \u0938\u092b\u0932 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0940 \u0930\u0940\u0922\u093c \u0939\u0948\u0902\u0964 \u0935\u0947 \u0939\u092e\u0947\u0902 \u0909\u0928 \u091b\u094b\u091f\u0940 \u091a\u0940\u091c\u093c\u094b\u0902 \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u092c\u0921\u093c\u093e \u092c\u0926\u0932\u093e\u0935 \u0932\u093e\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u0940 \u092f\u093e\u0924\u094d\u0930\u093e\u090f\u0901 \u0916\u0941\u0936\u0940 \u0938\u0947 \u092d\u0930\u0940 \u0939\u094b\u0902, \u0905\u092b\u0938\u094b\u0938 \u0938\u0947 \u0928\u0939\u0940\u0902\u0964",quote_3:"\u0938\u094d\u092a\u094d\u0932\u093f\u091f\u0935\u093e\u0907\u091c\u093c \u092a\u0948\u0938\u0947 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u0915\u094b \u0926\u0942\u0930 \u0915\u0930\u0924\u093e \u0939\u0948, \u0938\u092e\u0942\u0939 \u0915\u0947 \u0916\u0930\u094d\u091a\u094b\u0902 \u092e\u0947\u0902 \u0938\u093e\u092e\u0902\u091c\u0938\u094d\u092f \u0932\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0926\u094b\u0938\u094d\u0924\u0940 \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964",quote_4:"\u092f\u0939 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0915\u093f \u0906\u092a \u0915\u093f\u0924\u0928\u093e \u092a\u0948\u0938\u093e \u0915\u092e\u093e\u0924\u0947 \u0939\u0948\u0902, \u092c\u0932\u094d\u0915\u093f \u092f\u0939 \u0939\u0948 \u0915\u093f \u0906\u092a \u0915\u093f\u0924\u0928\u093e \u092a\u0948\u0938\u093e \u0930\u0916\u0924\u0947 \u0939\u0948\u0902, \u092f\u0939 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0924\u0928\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0914\u0930 \u0906\u092a \u0907\u0938\u0947 \u0915\u093f\u0924\u0928\u0940 \u092a\u0940\u0922\u093c\u093f\u092f\u094b\u0902 \u0924\u0915 \u092c\u0928\u093e\u090f \u0930\u0916\u0924\u0947 \u0939\u0948\u0902\u0964",quote_5:"\u0926\u0941\u0928\u093f\u092f\u093e \u090f\u0915 \u0915\u093f\u0924\u093e\u092c \u0939\u0948, \u0914\u0930 \u091c\u094b \u0932\u094b\u0917 \u092f\u093e\u0924\u094d\u0930\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0935\u0947 \u0915\u0947\u0935\u0932 \u090f\u0915 \u092a\u0943\u0937\u094d\u0920 \u092a\u0922\u093c\u0924\u0947 \u0939\u0948\u0902\u0964",quote_6:"\u092f\u093e\u0924\u094d\u0930\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u0917\u094d\u0930\u0939, \u0915\u091f\u094d\u091f\u0930\u0924\u093e \u0914\u0930 \u0938\u0902\u0915\u0940\u0930\u094d\u0923\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0918\u093e\u0924\u0915 \u0939\u0948\u0964",quote_7:"\u092c\u091c\u091f \u0906\u092a\u0915\u0947 \u092a\u0948\u0938\u0947 \u0915\u094b \u092f\u0939 \u092c\u0924\u093e \u0930\u0939\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u0947 \u0915\u0939\u093e\u0901 \u091c\u093e\u0928\u093e \u0939\u0948 \u092c\u091c\u093e\u092f \u092f\u0939 \u0938\u094b\u091a\u0928\u0947 \u0915\u0947 \u0915\u093f \u0935\u0939 \u0915\u0939\u093e\u0901 \u0917\u092f\u093e\u0964",quote_8:"\u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u0948\u0938\u0947 \u0916\u0930\u094d\u091a \u0915\u0930\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0938\u093e\u0935\u0927\u093e\u0928\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u092f\u094b\u091c\u0928\u093e \u0914\u0930 \u092c\u091c\u091f \u0915\u0947 \u0938\u093e\u0925, \u0906\u092a \u0905\u092a\u0928\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u0947 \u092d\u0940\u0924\u0930 \u0905\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0930\u094b\u092e\u093e\u0902\u091a \u092c\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",dave_ramsey:"\u0921\u0947\u0935 \u0930\u0948\u092e\u0938\u0947",robert_kiyosaki:"\u0930\u0949\u092c\u0930\u094d\u091f \u0915\u093f\u092f\u094b\u0938\u093e\u0915\u0940",saint_augustine:"\u0938\u0947\u0902\u091f \u0911\u0917\u0938\u094d\u091f\u0940\u0928",mark_twain:"\u092e\u093e\u0930\u094d\u0915 \u091f\u094d\u0935\u0947\u0928"}}},679,[]);
__d(function(e,t,a,_,i,o,n){i.exports={Dashboard:{app_name:"\u0baa\u0baf\u0ba3 \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd",title:"\u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd",subtitle:"\u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9 \u0b9a\u0bc6\u0baf\u0bcd\u0baf \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd?",actions:{checklist:"\u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd",money_splitter:"\u0baa\u0ba3\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0ba9\u0bcd",history:"\u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1",settings:"\u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd",tourist_places:"\u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd",costPlanner:"\u0b9a\u0bc6\u0bb2\u0bb5\u0bc1 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0b9f\u0bc1\u0baa\u0bb5\u0bb0\u0bcd",additional_info:"\u0b95\u0bc2\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bcd",sync_info:"\u0b92\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bc8\u0bb5\u0bc1"}},Splitwise:{split_info:"\u0baa\u0ba3\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1 \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bc8 \u0b8e\u0bb3\u0bbf\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0ba3\u0bcd\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bc8\u0baf\u0bc7 \u0ba8\u0bbf\u0ba4\u0bbf \u0ba8\u0bc7\u0bb0\u0bcd\u0bae\u0bc8\u0baf\u0bc8 \u0b8a\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",add_new_split:"\u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc8\u0b9a\u0bcd \u0b9a\u0bc7\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",remove_all_data:"\u0b85\u0ba9